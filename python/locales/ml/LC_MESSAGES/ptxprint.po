msgid "PTXprint: Save As Monoglot..."
msgstr "PTXprint: ഏകഭാഷയായി സേവ് ചെയ്യുക..."

#: temp.glade:4007
msgid "<span foreground=\"red\"><b>WARNING:</b> You cannot simply disable a Diglot as\n"
"this would discard all your carefully crafted settings.</span>\n"
"\n"
"Either click <b>Cancel to return</b> to the current Diglot configuration\n"
"   OR\n"
"<b>Enter a name</b> for the new configuration, and <b>click OK</b>. \n"
"(Your current diglot configuration will remain unchanged, \n"
"while the new monoglot configuration will be saved and \n"
"become the active configuration.)"
msgstr "<span foreground=\"red\"><b>മുന്നറിയിപ്പ്:</b> ഒരു ദ്വിഭാഷ വെറുതെ പ്രവർത്തനരഹിതമാക്കാൻ കഴിയില്ല,\n"
"കാരണം അത് നിങ്ങൾ ശ്രദ്ധാപൂർവ്വം തയ്യാറാക്കിയ എല്ലാ ക്രമീകരണങ്ങളും ഇല്ലാതാക്കും.</span>\n"
"\n"
"ഒന്നുകിൽ നിലവിലെ ദ്വിഭാഷ കോൺഫിഗറേഷനിലേക്ക് <b>മടങ്ങാൻ റദ്ദാക്കുക</b> ക്ലിക്ക് ചെയ്യുക\n"
"   അല്ലെങ്കിൽ\n"
"പുതിയ കോൺഫിഗറേഷന് <b>ഒരു പേര് നൽകി</b>, <b>OK ക്ലിക്ക് ചെയ്യുക</b>. \n"
"(നിങ്ങളുടെ നിലവിലെ ദ്വിഭാഷ കോൺഫിഗറേഷൻ മാറ്റമില്ലാതെ തുടരും, \n"
"പുതിയ ഏകഭാഷ കോൺഫിഗറേഷൻ സേവ് ചെയ്യപ്പെടുകയും \n"
"സജീവ കോൺഫിഗറേഷനായി മാറുകയും ചെയ്യും.)"

#: temp.glade:4047
