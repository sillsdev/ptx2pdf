msgstr "സ്കോർ അടിസ്ഥാനത്തിൽ"

#: lib/ptxprint/gtkpolyglot.py:1275
msgid "Scored (Chapter)"
msgstr "സ്കോർ അടിസ്ഥാനത്തിൽ (അദ്ധ്യായം)"

#: lib/ptxprint/gtkpolyglot.py:1276
msgid "Scored (Verse)"
msgstr "സ്കോർ അടിസ്ഥാനത്തിൽ (വാക്യം)"

#: temp.glade:6867
msgid "Pri (Left)"
msgstr "പ്രാഥമികം (ഇടത്)"

#: temp.glade:6871
msgid "Sec (Right)"
msgstr "ദ്വിതീയം (വലത്)"

#: temp.glade:6875
