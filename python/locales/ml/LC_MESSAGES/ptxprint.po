msgstr "പ്രാഥമികം+ദ്വിതീയം രണ്ടും"

#: temp.glade:6890
msgid "00000"
msgstr "00000"

#: temp.glade:6896
msgid "PTXprint: Import Settings..."
msgstr "PTXprint: ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യുക..."

#: temp.glade:6927
msgid "RESET"
msgstr "റീസെറ്റ്"

#: temp.glade:6932
msgid "Warning!\n"
"This will reset ALL the UI settings \n"
"for the CURRENT configuration to\n"
"their default values.\n"
"\n"
"Note that it will NOT reset the Style \n"
"settings stored in the .sty files.\n"
"\n"
"The reset is not saved until you next\n"
"save, print, or import with OK."
msgstr "മുന്നറിയിപ്പ്!\n"
"ഇത് നിലവിലെ കോൺഫിഗറേഷനിലെ എല്ലാ UI\n"
"ക്രമീകരണങ്ങളും അവയുടെ ഡിഫോൾട്ട്\n"
"മൂല്യങ്ങളിലേക്ക് റീസെറ്റ് ചെയ്യും.\n"
"\n"
".sty ഫയലുകളിൽ സൂക്ഷിച്ചിട്ടുള്ള സ്റ്റൈൽ\n"
"ക്രമീകരണങ്ങൾ ഇത് റീസെറ്റ് ചെയ്യില്ല എന്ന് ശ്രദ്ധിക്കുക.\n"
"\n"
"അടുത്ത തവണ സേവ് ചെയ്യുകയോ പ്രിന്റ് ചെയ്യുകയോ\n"
"OK ഉപയോഗിച്ച് ഇംപോർട്ട് ചെയ്യുകയോ ചെയ്യുന്നതുവരെ\n"
"റീസെറ്റ് സേവ് ആകില്ല."

#: temp.glade:7036
msgid "PDF file (with embedded settings) or ZIP archive file"
msgstr "PDF ഫയൽ (ക്രമീകരണങ്ങൾ ഉൾച്ചേർത്തത്) അല്ലെങ്കിൽ ZIP ആർക്കൈവ് ഫയൽ"

#: temp.glade:7041
msgid "It is possible to import settings from an\n"
"existing PDF file which was produced earlier\n"
"by PTXprint. But this only works if the settings\n"
"are embedded within the PDF. (This is enabled\n"
"on the Finishing tab).\n"
"\n"
"Importing from a PTXprint ZIP archive \n"
"(created on the Help tab) is also possible."
msgstr "PTXprint മുമ്പ് നിർമ്മിച്ച ഒരു PDF ഫയലിൽ നിന്ന്\n"
"ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യാം. എന്നാൽ\n"
"ക്രമീകരണങ്ങൾ PDF-ൽ ഉൾച്ചേർത്തിട്ടുണ്ടെങ്കിൽ മാത്രമേ\n"
"ഇത് പ്രവർത്തിക്കൂ. (ഇത് പൂർത്തീകരണം ടാബിൽ\n"
"ഓണാക്കാം).\n"
"\n"
"PTXprint ZIP ആർക്കൈവിൽ നിന്നും (സഹായം ടാബിൽ \n"
"സൃഷ്ടിച്ചത്) ഇംപോർട്ട് ചെയ്യാം."

#: temp.glade:7065
msgid "A Previously Saved Configuration:"
msgstr "മുമ്പ് സേവ് ചെയ്ത ഒരു കോൺഫിഗറേഷൻ:"

#: temp.glade:7090 temp.glade:7138
msgid "Select the project from which the\n"
"settings will be imported."
msgstr "ഏത് പ്രോജക്റ്റിൽ നിന്നാണ് ക്രമീകരണങ്ങൾ\n"
"ഇംപോർട്ട് ചെയ്യേണ്ടതെന്ന് തിരഞ്ഞെടുക്കുക."

#: temp.glade:7117 temp.glade:7153
msgid "Select a configuration from the\n"
"selected project from which the\n"
"settings will be imported."
msgstr "തിരഞ്ഞെടുത്ത പ്രോജക്റ്റിലെ ഏത്\n"
"കോൺഫിഗറേഷനിൽ നിന്നാണ് ക്രമീകരണങ്ങൾ\n"
"ഇംപോർട്ട് ചെയ്യേണ്ടതെന്ന് തിരഞ്ഞെടുക്കുക."

#: temp.glade:7125
msgid "(None)"
msgstr "(ഒന്നുമില്ല)"

#: temp.glade:7141 temp.glade:7329
msgid "Project:"
msgstr "പ്രോജക്റ്റ്:"

#: temp.glade:7158 temp.glade:7346
msgid "Configuration:"
msgstr "കോൺഫിഗറേഷൻ:"

#: temp.glade:7185 temp.glade:7374 temp.glade:12233 temp.glade:24180 temp.glade:31721 temp.glade:31959 temp.glade:32203 temp.glade:32376 temp.glade:34983 temp.glade:36960 temp.glade:37689 temp.glade:38682 temp.glade:39502
msgid "Select..."
msgstr "തിരഞ്ഞെടുക്കുക..."

#: temp.glade:7190
msgid "Select either a PTXprint PDF or ZIP archive\n"
"to import the settings from.\n"
"\n"
"Importing from a PDF will only work if the\n"
"PDF contains the PTXprint configuration\n"
"settings (as enabled on the Finishing tab)."
msgstr "ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യാൻ ഒരു PTXprint PDF\n"
"അല്ലെങ്കിൽ ZIP ആർക്കൈവ് തിരഞ്ഞെടുക്കുക.\n"
"\n"
"PDF-ൽ PTXprint കോൺഫിഗറേഷൻ ക്രമീകരണങ്ങൾ\n"
"ഉണ്ടെങ്കിൽ മാത്രമേ PDF-ൽ നിന്നുള്ള ഇംപോർട്ട്\n"
"പ്രവർത്തിക്കൂ (പൂർത്തീകരണം ടാബിൽ ഓണാക്കിയതുപോലെ)."

#: temp.glade:7214
msgid "Source of Settings"
msgstr "ക്രമീകരണങ്ങളുടെ ഉറവിടം"

#: temp.glade:7249
msgid "An External Folder of Settings"
msgstr "ക്രമീകരണങ്ങളുടെ ഒരു ബാഹ്യ ഫോൾഡർ"

#: temp.glade:7254
msgid "Settings can be extracted to an external folder.\n"
"\n"
"This may be useful when examining settings from\n"
"a different user, or when there is a need to recover\n"
"lost settings from a known good PDF or Zip archive."
msgstr "ക്രമീകരണങ്ങൾ ഒരു ബാഹ്യ ഫോൾഡറിലേക്ക് എക്സ്ട്രാക്റ്റ് ചെയ്യാം.\n"
"\n"
"മറ്റൊരു ഉപയോക്താവിന്റെ ക്രമീകരണങ്ങൾ പരിശോധിക്കുമ്പോഴോ,\n"
"നഷ്ടപ്പെട്ട ക്രമീകരണങ്ങൾ ശരിയാണെന്ന് ഉറപ്പുള്ള ഒരു PDF-ൽ നിന്നോ\n"
"Zip ആർക്കൈവിൽ നിന്നോ വീണ്ടെടുക്കേണ്ടിവരുമ്പോഴോ ഇത് ഉപകാരപ്പെടും."

#: temp.glade:7274
msgid "A New/Existing Project and/or Configuration:"
msgstr "പുതിയ/നിലവിലുള്ള പ്രോജക്റ്റ് കൂടാതെ/അല്ലെങ്കിൽ കോൺഫിഗറേഷൻ:"

#: temp.glade:7300
msgid "Select an existing project into which\n"
"the settings will be imported."
msgstr "നിലവിലുള്ള ഏത് പ്രോജക്റ്റിലേക്കാണ്\n"
"ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യേണ്ടതെന്ന് തിരഞ്ഞെടുക്കുക."

#: temp.glade:7326
msgid "Select the project into which the\n"
"settings will be imported."
msgstr "ഏത് പ്രോജക്റ്റിലേക്കാണ് ക്രമീകരണങ്ങൾ\n"
"ഇംപോർട്ട് ചെയ്യേണ്ടതെന്ന് തിരഞ്ഞെടുക്കുക."

#: temp.glade:7341
msgid "Select a configuration in the\n"
"selected project into which the\n"
"settings will be imported."
msgstr "തിരഞ്ഞെടുത്ത പ്രോജക്റ്റിലെ ഏത്\n"
"കോൺഫിഗറേഷനിലേക്കാണ് ക്രമീകരണങ്ങൾ\n"
"ഇംപോർട്ട് ചെയ്യേണ്ടതെന്ന് തിരഞ്ഞെടുക്കുക."

#: temp.glade:7379
msgid "Select a folder to save the settings in.\n"
"This could be in a temporary location\n"
"from where just the needed settings\n"
"can be accessed and copied into the\n"
"appropriate place of an existing config."
msgstr "ക്രമീകരണങ്ങൾ സേവ് ചെയ്യാൻ ഒരു ഫോൾഡർ തിരഞ്ഞെടുക്കുക.\n"
"ഇത് ഒരു താൽക്കാലിക സ്ഥലമാകാം; അവിടെ നിന്ന്\n"
"ആവശ്യമുള്ള ക്രമീകരണങ്ങൾ മാത്രം എടുത്ത്\n"
"നിലവിലുള്ള ഒരു കോൺഫിഗറേഷനിലെ\n"
"ഉചിതമായ സ്ഥാനത്തേക്ക് പകർത്താം."

#: temp.glade:7399
msgid "Choose a configuration from the\n"
"selected project into which the\n"
"settings will be imported.\n"
"  OR\n"
"Enter a NEW config name which\n"
"causes a new configuration to be\n"
"created for the current/new project."
msgstr "തിരഞ്ഞെടുത്ത പ്രോജക്റ്റിലെ ഏത്\n"
"കോൺഫിഗറേഷനിലേക്കാണ് ക്രമീകരണങ്ങൾ\n"
"ഇംപോർട്ട് ചെയ്യേണ്ടതെന്ന് തിരഞ്ഞെടുക്കുക.\n"
"  അല്ലെങ്കിൽ\n"
"ഒരു പുതിയ കോൺഫിഗറേഷൻ പേര് നൽകുക;\n"
"അപ്പോൾ നിലവിലുള്ള/പുതിയ പ്രോജക്റ്റിനായി\n"
"ഒരു പുതിയ കോൺഫിഗറേഷൻ സൃഷ്ടിക്കപ്പെടും."

#: temp.glade:7417
msgid "Enter a name for the configuration to be saved.\n"
"\n"
"Note that only Roman/Latin names\n"
"are supported using: a-z A-Z, 0-9,\n"
"parentheses, underscores and hyphens."
msgstr "സേവ് ചെയ്യേണ്ട കോൺഫിഗറേഷന് ഒരു പേര് നൽകുക.\n"
"\n"
"റോമൻ/ലാറ്റിൻ പേരുകൾ മാത്രമേ പിന്തുണയ്ക്കൂ:\n"
"a-z A-Z, 0-9, ബ്രാക്കറ്റുകൾ, അണ്ടർസ്കോറുകൾ,\n"
"ഹൈഫനുകൾ എന്നിവ ഉപയോഗിക്കുക."

#: temp.glade:7441
msgid "Target"
msgstr "ലക്ഷ്യം"

#: temp.glade:7479
msgid "Import Entire PicList \"as is\" (overwrite existing PicList)"
msgstr "മുഴുവൻ PicList-ഉം \"അതേപടി\" ഇംപോർട്ട് ചെയ്യുക (നിലവിലുള്ള PicList മാറ്റിയെഴുതും)"

#: temp.glade:7484
msgid "Replace the target's whole picture list with\n"
"the source's. Pictures only in the target are\n"
"removed. Use it when the source is the master list."
msgstr "ലക്ഷ്യത്തിലെ മുഴുവൻ ചിത്രപ്പട്ടികയും ഉറവിടത്തിലേതുകൊണ്ട്\n"
"മാറ്റിസ്ഥാപിക്കുന്നു. ലക്ഷ്യത്തിൽ മാത്രമുള്ള ചിത്രങ്ങൾ\n"
"നീക്കം ചെയ്യപ്പെടും. ഉറവിടമാണ് പ്രധാന പട്ടികയെങ്കിൽ ഇത് ഉപയോഗിക്കുക."

#: temp.glade:7501
msgid "Import Elements of PicList (preserving existing PicList)"
msgstr "PicList-ലെ ഘടകങ്ങൾ ഇംപോർട്ട് ചെയ്യുക (നിലവിലുള്ള PicList നിലനിർത്തും)"

#: temp.glade:7506
msgid "Keep the target's picture list and copy only the\n"
"parts ticked below, for pictures in both lists."
msgstr "ലക്ഷ്യത്തിലെ ചിത്രപ്പട്ടിക നിലനിർത്തി, രണ്ട് പട്ടികയിലും\n"
"ഉള്ള ചിത്രങ്ങൾക്ക് താഴെ ടിക്ക് ചെയ്ത ഭാഗങ്ങൾ മാത്രം പകർത്തുന്നു."

#: temp.glade:7531
msgid "Captions"
msgstr "ക്യാപ്ഷനുകൾ"

#: temp.glade:7535
msgid "Copy the captions and the reference shown with\n"
"each picture. Leave unticked if the target is in\n"
"another language."
msgstr "ഓരോ ചിത്രത്തിനൊപ്പവും കാണിക്കുന്ന ക്യാപ്ഷനുകളും\n"
"റഫറൻസും പകർത്തുന്നു. ലക്ഷ്യം മറ്റൊരു ഭാഷയിലാണെങ്കിൽ\n"
"ടിക്ക് ചെയ്യാതെ വിടുക."

#: temp.glade:7549
msgid "Size, Position, Mirror, Rotation settings"
msgstr "വലുപ്പം, സ്ഥാനം, മിറർ, റൊട്ടേഷൻ ക്രമീകരണങ്ങൾ"

#: temp.glade:7553
msgid "Copy the size, position, scale, mirroring\n"
"and rotation of each picture."
msgstr "ഓരോ ചിത്രത്തിന്റെയും വലുപ്പം, സ്ഥാനം, സ്കെയിൽ,\n"
"മിററിങ്, റൊട്ടേഷൻ എന്നിവ പകർത്തുന്നു."

#: temp.glade:7567
msgid "Copyright Information"
msgstr "പകർപ്പവകാശ വിവരങ്ങൾ"

#: temp.glade:7571
msgid "Copy the copyright (credit) information\n"
"of each picture."
msgstr "ഓരോ ചിത്രത്തിന്റെയും പകർപ്പവകാശ (ക്രെഡിറ്റ്)\n"
"വിവരങ്ങൾ പകർത്തുന്നു."

#: temp.glade:7647
msgid "How to handle differences:"
msgstr "വ്യത്യാസങ്ങൾ കൈകാര്യം ചെയ്യേണ്ട വിധം:"

#: temp.glade:7657
msgid "Add Any New Pictures"
msgstr "പുതിയ ചിത്രങ്ങൾ ചേർക്കുക"

#: temp.glade:7661
msgid "Add pictures that are in the source list\n"
"but not yet in the target list."
msgstr "ഉറവിട പട്ടികയിലുള്ളതും ലക്ഷ്യ പട്ടികയിൽ\n"
"ഇതുവരെ ഇല്ലാത്തതുമായ ചിത്രങ്ങൾ ചേർക്കുന്നു."

#: temp.glade:7676
msgid "Remove Any Old Pictures"
msgstr "പഴയ ചിത്രങ്ങൾ നീക്കം ചെയ്യുക"

#: temp.glade:7680
msgid "Remove pictures from the target list that are\n"
"not in the source list. Tick it when the source\n"
"list is the complete, final list."
msgstr "ഉറവിട പട്ടികയിൽ ഇല്ലാത്ത ചിത്രങ്ങൾ ലക്ഷ്യ\n"
"പട്ടികയിൽ നിന്ന് നീക്കം ചെയ്യുന്നു. ഉറവിട പട്ടിക\n"
"പൂർണ്ണവും അന്തിമവുമാണെങ്കിൽ ഇത് ടിക്ക് ചെയ്യുക."

#: lib/ptxprint/gtkview.py:3070
msgid "Pictures"
msgstr "ചിത്രങ്ങൾ"

#: temp.glade:7709
msgid "Import the picture settings and the\n"
"picture list. Use the Pictures tab\n"
"of this dialog to choose how the\n"
"picture list is combined."
msgstr "ചിത്ര ക്രമീകരണങ്ങളും ചിത്രപ്പട്ടികയും\n"
"ഇംപോർട്ട് ചെയ്യുന്നു. ചിത്രപ്പട്ടിക എങ്ങനെ\n"
"സംയോജിപ്പിക്കണമെന്ന് ഈ ഡയലോഗിലെ\n"
"ചിത്രങ്ങൾ ടാബിൽ തിരഞ്ഞെടുക്കുക."

#: temp.glade:7740
msgid "Enabling this option will import (overwrite) the page size, \n"
"column-layout, margins and related settings. (Header and footer settings\n"
"are imported with Other > Header+Footer settings.)"
msgstr "ഈ ഓപ്ഷൻ ഓണാക്കിയാൽ പേജ് വലുപ്പം, \n"
"കോളം ലേഔട്ട്, മാർജിനുകൾ, അനുബന്ധ ക്രമീകരണങ്ങൾ എന്നിവ ഇംപോർട്ട് ചെയ്യും (മാറ്റിയെഴുതും). (ഹെഡർ, ഫൂട്ടർ ക്രമീകരണങ്ങൾ\n"
"മറ്റുള്ളവ > ഹെഡർ+ഫൂട്ടർ ക്രമീകരണങ്ങൾ വഴിയാണ് ഇംപോർട്ട് ചെയ്യുന്നത്.)"

#: temp.glade:7758 temp.glade:19947
msgid "Layout"
msgstr "ലേഔട്ട്"

#: temp.glade:7763
msgid "Import page size, margins, columns,\n"
"line spacing and related settings."
msgstr "പേജ് വലുപ്പം, മാർജിനുകൾ, കോളങ്ങൾ,\n"
"വരിയകലം, അനുബന്ധ ക്രമീകരണങ്ങൾ എന്നിവ ഇംപോർട്ട് ചെയ്യുന്നു."

#: temp.glade:7792
msgid "Enabling this option will import the main font and script settings (Fonts+Scripts tab), including text direction, line breaking and spacing.\n"
"Fonts that have been set within individual Styles are also updated to match the source. (Hyphenation settings are imported with Other > Body Tab settings.)"
msgstr "ഈ ഓപ്ഷൻ ഓണാക്കിയാൽ പ്രധാന ഫോണ്ടും സ്ക്രിപ്റ്റ് ക്രമീകരണങ്ങളും (ഫോണ്ടുകൾ+സ്ക്രിപ്റ്റുകൾ ടാബ്) ഇംപോർട്ട് ചെയ്യും. എഴുത്തിന്റെ ദിശ, വരി മുറിക്കൽ, സ്പേസിംഗ് എന്നിവയും ഇതിൽ ഉൾപ്പെടും.\n"
"ഓരോ സ്റ്റൈലിലും പ്രത്യേകം സജ്ജീകരിച്ച ഫോണ്ടുകളും സോഴ്സിലേതുപോലെ പുതുക്കും. (ഹൈഫനേഷൻ ക്രമീകരണങ്ങൾ മറ്റുള്ളവ > ബോഡി ടാബ് ക്രമീകരണങ്ങൾക്കൊപ്പമാണ് ഇംപോർട്ട് ചെയ്യുന്നത്.)"

#: temp.glade:7809 temp.glade:21045
msgid "Fonts+Script"
msgstr "ഫോണ്ടുകൾ+സ്ക്രിപ്റ്റ്"

#: temp.glade:7814
msgid "Import the font and script settings (Fonts+Scripts tab),\n"
"including fonts set within individual styles."
msgstr "ഫോണ്ടും സ്ക്രിപ്റ്റ് ക്രമീകരണങ്ങളും (ഫോണ്ടുകൾ+സ്ക്രിപ്റ്റുകൾ ടാബ്) ഇംപോർട്ട് ചെയ്യുക.\n"
"ഓരോ സ്റ്റൈലിലും പ്രത്യേകം സജ്ജീകരിച്ച ഫോണ്ടുകളും ഇതിൽ ഉൾപ്പെടും."

#: temp.glade:7843
msgid "This will selectively import any Styles which are different from the Default settings.\n"
"Styles from ptxprint-mods.sty are imported with Other > Advanced settings (custom.sty is never imported).\n"
"Fonts set within styles are only imported if Fonts+Script is also ticked.\n"
"You may also want to RESET the current configuration (see below) before importing styles."
msgstr "ഡിഫോൾട്ട് ക്രമീകരണങ്ങളിൽ നിന്ന് വ്യത്യസ്തമായ സ്റ്റൈലുകൾ മാത്രം തിരഞ്ഞെടുത്ത് ഇംപോർട്ട് ചെയ്യും.\n"
"ptxprint-mods.sty-യിലെ സ്റ്റൈലുകൾ മറ്റുള്ളവ > അഡ്വാൻസ്ഡ് ക്രമീകരണങ്ങൾക്കൊപ്പമാണ് ഇംപോർട്ട് ചെയ്യുന്നത് (custom.sty ഒരിക്കലും ഇംപോർട്ട് ചെയ്യില്ല).\n"
"ഫോണ്ടുകൾ+സ്ക്രിപ്റ്റ് കൂടി ടിക്ക് ചെയ്തിട്ടുണ്ടെങ്കിൽ മാത്രമേ സ്റ്റൈലുകളിൽ സജ്ജീകരിച്ച ഫോണ്ടുകൾ ഇംപോർട്ട് ചെയ്യൂ.\n"
"സ്റ്റൈലുകൾ ഇംപോർട്ട് ചെയ്യുന്നതിന് മുമ്പ് നിലവിലെ കോൺഫിഗറേഷൻ റീസെറ്റ് ചെയ്യുന്നതും (താഴെ കാണുക) നല്ലതാണ്."

#: temp.glade:7857
msgid "Override ALL Style Settings"
msgstr "എല്ലാ സ്റ്റൈൽ ക്രമീകരണങ്ങളും മാറ്റിയെഴുതുക"

#: temp.glade:7861
msgid "Normally only styles that have not been changed\n"
"in the receiving configuration will be imported.\n"
"But if you require ALL styles to be updated\n"
"regardless of whether they have already been\n"
"modified locally, then enable this option.\n"
"(This also applies to fonts in styles imported\n"
"with Fonts+Script.)"
msgstr "സാധാരണയായി, ഇംപോർട്ട് സ്വീകരിക്കുന്ന\n"
"കോൺഫിഗറേഷനിൽ മാറ്റം വരുത്തിയിട്ടില്ലാത്ത\n"
"സ്റ്റൈലുകൾ മാത്രമേ ഇംപോർട്ട് ചെയ്യൂ.\n"
"എന്നാൽ ഇവിടെ നേരത്തേ മാറ്റം വരുത്തിയവ\n"
"ഉൾപ്പെടെ എല്ലാ സ്റ്റൈലുകളും പുതുക്കണമെങ്കിൽ\n"
"ഈ ഓപ്ഷൻ ഓണാക്കുക.\n"
"(ഫോണ്ടുകൾ+സ്ക്രിപ്റ്റ് വഴി ഇംപോർട്ട് ചെയ്യുന്ന\n"
"സ്റ്റൈലുകളിലെ ഫോണ്ടുകൾക്കും ഇത് ബാധകമാണ്.)"

#: temp.glade:7887 temp.glade:34796
msgid "Styles"
msgstr "സ്റ്റൈലുകൾ"

#: temp.glade:7892
msgid "Import the style settings (Styles tab),\n"
"merged into the target configuration."
msgstr "സ്റ്റൈൽ ക്രമീകരണങ്ങൾ (സ്റ്റൈലുകൾ ടാബ്) ഇംപോർട്ട് ചെയ്ത്\n"
"ടാർഗറ്റ് കോൺഫിഗറേഷനിൽ ലയിപ്പിക്കുക."

#: temp.glade:7924
msgid "Other settings can be imported as needed:"
msgstr "മറ്റ് ക്രമീകരണങ്ങൾ ആവശ്യാനുസരണം ഇംപോർട്ട് ചെയ്യാം:"

#: temp.glade:7956
msgid "Body Tab settings"
msgstr "ബോഡി ടാബ് ക്രമീകരണങ്ങൾ"

#: temp.glade:7960
msgid "Import the settings of the Body tab."
msgstr "ബോഡി ടാബിലെ ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യുക."

#: temp.glade:7973
msgid "Notes+Refs settings"
msgstr "കുറിപ്പുകൾ+റഫറൻസുകൾ ക്രമീകരണങ്ങൾ"

#: temp.glade:7977
msgid "Import the settings of the Notes+Refs tab."
msgstr "കുറിപ്പുകൾ+റഫറൻസുകൾ ടാബിലെ ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യുക."

#: temp.glade:7990
msgid "Header+Footer settings"
msgstr "ഹെഡർ+ഫൂട്ടർ ക്രമീകരണങ്ങൾ"

#: temp.glade:7994
msgid "Import the settings of the\n"
"Header+Footer tab."
msgstr "ഹെഡർ+ഫൂട്ടർ ടാബിലെ\n"
"ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യുക."

#: temp.glade:8008
msgid "Thumb Tabs settings"
msgstr "തമ്പ് ടാബുകൾ ക്രമീകരണങ്ങൾ"

#: temp.glade:8012
msgid "Import the thumb tab settings\n"
"(Tabs+Borders tab)."
msgstr "തമ്പ് ടാബ് ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യുക\n"
"(ടാബുകൾ+ബോർഡറുകൾ ടാബ്)."

#: temp.glade:8025
msgid "Overwrite Front Matter"
msgstr "ആമുഖ പേജുകൾ മാറ്റിയെഴുതുക"

#: temp.glade:8029
msgid "Replace the front matter in the target with\n"
"the source's, instead of only adding the\n"
"parts that are missing."
msgstr "ടാർഗറ്റിൽ ഇല്ലാത്ത ഭാഗങ്ങൾ മാത്രം ചേർക്കുന്നതിന്\n"
"പകരം, ടാർഗറ്റിലെ ആമുഖ പേജുകൾ മുഴുവനായി\n"
"സോഴ്സിലേതുകൊണ്ട് മാറ്റിസ്ഥാപിക്കുക."

#: temp.glade:8043
msgid "Advanced settings"
msgstr "അഡ്വാൻസ്ഡ് ക്രമീകരണങ്ങൾ"

#: temp.glade:8047
msgid "This includes everything on the Advanced tab\n"
"with the exception of Custom Script processing\n"
"and Customized Styles (custom.sty)."
msgstr "അഡ്വാൻസ്ഡ് ടാബിലെ എല്ലാം ഇതിൽ ഉൾപ്പെടും,\n"
"കസ്റ്റം സ്ക്രിപ്റ്റ് പ്രോസസ്സിംഗും കസ്റ്റമൈസ്\n"
"ചെയ്ത സ്റ്റൈലുകളും (custom.sty) ഒഴികെ."

#: temp.glade:8073
msgid "Cover settings"
msgstr "കവർ ക്രമീകരണങ്ങൾ"

#: temp.glade:8077
msgid "Import the cover settings, cover styles\n"
"and the cover pages of the front matter."
msgstr "കവർ ക്രമീകരണങ്ങൾ, കവർ സ്റ്റൈലുകൾ,\n"
"ആമുഖ പേജുകളിലെ കവർ പേജുകൾ എന്നിവ ഇംപോർട്ട് ചെയ്യുക."

#: temp.glade:8091
msgid "Front +Back Matter"
msgstr "ആമുഖ + അനുബന്ധ പേജുകൾ"

#: temp.glade:8095
msgid "This includes most of the settings on\n"
"the Peripherals tab, but not the Variables\n"
"and Values. Front Matter and also Section\n"
"Introductions are included in this."
msgstr "ആമുഖ-അനുബന്ധ ഭാഗങ്ങൾ ടാബിലെ മിക്ക\n"
"ക്രമീകരണങ്ങളും ഇതിൽ ഉൾപ്പെടും, എന്നാൽ\n"
"വേരിയബിളുകളും മൂല്യങ്ങളും ഉൾപ്പെടില്ല. ആമുഖ\n"
"പേജുകളും ഭാഗങ്ങളുടെ ആമുഖങ്ങളും ഇതിൽ ഉൾപ്പെടും."

#: temp.glade:8123
msgid "Custom Script"
msgstr "കസ്റ്റം സ്ക്രിപ്റ്റ്"

#: temp.glade:8128
msgid "This includes the Custom Script processing\n"
"defined on the Advanced tab.\n"
"\n"
"Note that it is not possible to extract a\n"
"custom script from a PDF file, which is\n"
"why this option is sometimes disabled."
msgstr "അഡ്വാൻസ്ഡ് ടാബിൽ നിർവചിച്ച കസ്റ്റം\n"
"സ്ക്രിപ്റ്റ് പ്രോസസ്സിംഗ് ഇതിൽ ഉൾപ്പെടും.\n"
"\n"
"ഒരു PDF ഫയലിൽ നിന്ന് കസ്റ്റം സ്ക്രിപ്റ്റ്\n"
"വേർതിരിച്ചെടുക്കാൻ കഴിയില്ല. അതുകൊണ്ടാണ്\n"
"ഈ ഓപ്ഷൻ ചിലപ്പോൾ ലഭ്യമല്ലാത്തത്."

#: temp.glade:8145
msgid "Borders + Decorations"
msgstr "ബോർഡറുകൾ + അലങ്കാരങ്ങൾ"

#: temp.glade:8149
msgid "This includes the various decorative\n"
"borders and other ornamental features\n"
"including section headers, end-of-book\n"
"and verse number decorators."
msgstr "വിവിധ അലങ്കാര ബോർഡറുകളും മറ്റ്\n"
"അലങ്കാര ഘടകങ്ങളും ഇതിൽ ഉൾപ്പെടും:\n"
"ഭാഗ തലക്കെട്ടുകൾ, പുസ്തകാന്ത്യം,\n"
"വാക്യ നമ്പറുകൾ എന്നിവയുടെ അലങ്കാരങ്ങൾ."

#: temp.glade:8164
msgid "Variables + Meta Data"
msgstr "വേരിയബിളുകൾ + മെറ്റാ ഡാറ്റ"

#: temp.glade:8168
msgid "Import the variables (Peripherals tab) and the\n"
"publication details: copyright statement,\n"
"licence, colophon and configuration notes.\n"
"The book selection and any password are not imported."
msgstr "വേരിയബിളുകളും (ആമുഖ-അനുബന്ധ ഭാഗങ്ങൾ ടാബ്)\n"
"പ്രസിദ്ധീകരണ വിവരങ്ങളും ഇംപോർട്ട് ചെയ്യുക: പകർപ്പവകാശ\n"
"പ്രസ്താവന, ലൈസൻസ്, കൊളോഫോൺ, കോൺഫിഗറേഷൻ കുറിപ്പുകൾ.\n"
"പുസ്തകങ്ങളുടെ തിരഞ്ഞെടുപ്പും പാസ്‌വേഡും ഇംപോർട്ട് ചെയ്യില്ല."

#: temp.glade:8195
msgid "Texpert Hacks"
msgstr "Texpert ഹാക്കുകൾ"

#: temp.glade:8199
msgid "Import the expert TeX (TeXpert) settings."
msgstr "വിദഗ്ദ്ധർക്കുള്ള TeX (TeXpert) ക്രമീകരണങ്ങൾ ഇംപോർട്ട് ചെയ്യുക."

#: temp.glade:8211
msgid "Finishing settings"
msgstr "ഫിനിഷിംഗ് ക്രമീകരണങ്ങൾ"

#: temp.glade:8215
msgid "This includes everything on the Finishing tab."
msgstr "ഫിനിഷിംഗ് ടാബിലെ എല്ലാം ഇതിൽ ഉൾപ്പെടും."

#: lib/ptxprint/gtkstyleditor.py:74 lib/ptxprint/gtkstyleditor.py:130
msgid "Other"
msgstr "മറ്റുള്ളവ"

#: temp.glade:8262
msgid "Use the Other tab of this dialog to\n"
"choose more groups of settings.\n"
"If this is not ticked, none of the\n"
"boxes on the Other tab are used."
msgstr "കൂടുതൽ ക്രമീകരണ ഗ്രൂപ്പുകൾ തിരഞ്ഞെടുക്കാൻ\n"
"ഈ ഡയലോഗിലെ മറ്റുള്ളവ ടാബ് ഉപയോഗിക്കുക.\n"
"ഇത് ടിക്ക് ചെയ്തിട്ടില്ലെങ്കിൽ, മറ്റുള്ളവ\n"
"ടാബിലെ ബോക്സുകളൊന്നും ഉപയോഗിക്കില്ല."

#: temp.glade:8295
msgid "This option is automatically enabled when the target\n"
"Configuration does not already exist; or\n"
"when exporting to an external folder of settings."
msgstr "ടാർഗറ്റ് കോൺഫിഗറേഷൻ നിലവിൽ ഇല്ലെങ്കിലോ,\n"
"പുറത്തുള്ള ഒരു ക്രമീകരണ ഫോൾഡറിലേക്ക് എക്സ്പോർട്ട്\n"
"ചെയ്യുമ്പോഴോ ഈ ഓപ്ഷൻ സ്വയം ഓണാകും."

#: temp.glade:8313
msgid "Everything"
msgstr "എല്ലാം"

#: temp.glade:8318
msgid "Import all settings and files of the\n"
"source configuration, whatever the\n"
"other boxes say."
msgstr "മറ്റ് ബോക്സുകളിൽ എന്ത് തിരഞ്ഞെടുത്താലും,\n"
"സോഴ്സ് കോൺഫിഗറേഷനിലെ എല്ലാ ക്രമീകരണങ്ങളും\n"
"ഫയലുകളും ഇംപോർട്ട് ചെയ്യുക."

#: temp.glade:8373
msgid "Whole Bible"
msgstr "മുഴുവൻ ബൈബിൾ"

#: temp.glade:8377
msgid "Paratext Project"
msgstr "Paratext പ്രോജക്റ്റ്"

#: temp.glade:8381
msgid "This Publication"
msgstr "ഈ പ്രസിദ്ധീകരണം"

#: lib/ptxprint/pdf_viewer.py:35 lib/ptxprint/pdf_viewer.py:36
msgid "Center"
msgstr "മധ്യത്തിൽ"

#: temp.glade:8420 temp.glade:13000 temp.glade:14367
msgid "5"
msgstr "5"

#: temp.glade:8484
msgid "Pick a Font (and Typeface)"
msgstr "ഫോണ്ട് (ടൈപ്പ്ഫേസും) തിരഞ്ഞെടുക്കുക"

#: temp.glade:8561
msgid "Choose a font from the installed fonts.\n"
"Fonts shown in BOLD have all 4 typefaces.\n"
"\n"
"If you cannot locate the desired font\n"
"in this list, then it is quite likely that\n"
"it has not been installed \"For all Users\"\n"
"in the Windows system."
msgstr "ഇൻസ്റ്റാൾ ചെയ്തിട്ടുള്ള ഫോണ്ടുകളിൽ നിന്ന് ഒരു ഫോണ്ട് തിരഞ്ഞെടുക്കുക.\n"
"ബോൾഡ് ആയി കാണിക്കുന്ന ഫോണ്ടുകൾക്ക് 4 ടൈപ്പ്ഫേസുകളും ഉണ്ട്.\n"
"\n"
"ആവശ്യമുള്ള ഫോണ്ട് ഈ ലിസ്റ്റിൽ\n"
"കണ്ടെത്താൻ കഴിയുന്നില്ലെങ്കിൽ, അത് Windows\n"
"സിസ്റ്റത്തിൽ \"For all Users\" (എല്ലാ ഉപയോക്താക്കൾക്കും)\n"
"ആയി ഇൻസ്റ്റാൾ ചെയ്തിട്ടില്ലാത്തതാകാനാണ് സാധ്യത."

#: temp.glade:8595
msgid "Fonts which have all 4 typefaces\n"
"(regular, bold, italic, and bold-italic)\n"
"are shown in BOLD in the list above.\n"
"\n"
"If you cannot locate the desired font\n"
"in this list, then it is quite likely that\n"
"it has not been installed \"For all Users\"\n"
"in the Windows system."
msgstr "4 ടൈപ്പ്ഫേസുകളും (regular, bold,\n"
"italic, bold-italic) ഉള്ള ഫോണ്ടുകൾ\n"
"മുകളിലെ ലിസ്റ്റിൽ ബോൾഡ് ആയി കാണിക്കുന്നു.\n"
"\n"
"ആവശ്യമുള്ള ഫോണ്ട് ഈ ലിസ്റ്റിൽ\n"
"കണ്ടെത്താൻ കഴിയുന്നില്ലെങ്കിൽ, അത് Windows\n"
"സിസ്റ്റത്തിൽ \"For all Users\" (എല്ലാ ഉപയോക്താക്കൾക്കും)\n"
"ആയി ഇൻസ്റ്റാൾ ചെയ്തിട്ടില്ലാത്തതാകാനാണ് സാധ്യത."

#: temp.glade:8606
msgid "Typeface:"
msgstr "ടൈപ്പ്ഫേസ്:"

#: temp.glade:8641
msgid "Type the start of a font name\n"
"to jump to it in the list."
msgstr "ലിസ്റ്റിൽ ഒരു ഫോണ്ടിലേക്ക് പോകാൻ\n"
"അതിന്റെ പേരിന്റെ തുടക്കം ടൈപ്പ് ചെയ്യുക."

#: temp.glade:8693 temp.glade:8713
msgid "If the required font doesn't have a BOLD typeface, you can use this setting to create the BOLD effect. (For example, setting Embolden to 1.6 would thicken the Regular typeface making it appear as bold.)"
msgstr "ആവശ്യമുള്ള ഫോണ്ടിന് ബോൾഡ് ടൈപ്പ്ഫേസ് ഇല്ലെങ്കിൽ, ബോൾഡ് ഇഫക്റ്റ് ഉണ്ടാക്കാൻ ഈ ക്രമീകരണം ഉപയോഗിക്കാം. (ഉദാഹരണത്തിന്, കട്ടി കൂട്ടൽ 1.6 ആയി സജ്ജമാക്കിയാൽ Regular ടൈപ്പ്ഫേസിന് കട്ടി കൂടി അത് ബോൾഡ് പോലെ കാണപ്പെടും.)"

#: temp.glade:8695
msgid "Embolden"
msgstr "കട്ടി കൂട്ടൽ"

#: temp.glade:8736 temp.glade:8758
msgid "If the required font does not have an ITALIC typeface, you can use this setting to create the ITALIC effect. (For example, setting Slant to 0.15 would slant the Regular typeface by 15% making it appear as italic.)"
msgstr "ആവശ്യമുള്ള ഫോണ്ടിന് ഇറ്റാലിക് ടൈപ്പ്ഫേസ് ഇല്ലെങ്കിൽ, ഇറ്റാലിക് ഇഫക്റ്റ് ഉണ്ടാക്കാൻ ഈ ക്രമീകരണം ഉപയോഗിക്കാം. (ഉദാഹരണത്തിന്, ചരിവ് 0.15 ആയി സജ്ജമാക്കിയാൽ Regular ടൈപ്പ്ഫേസ് 15% ചരിഞ്ഞ് ഇറ്റാലിക് പോലെ കാണപ്പെടും.)"

#: temp.glade:8760
msgid "Slant"
msgstr "ചരിവ്"

#: temp.glade:8778
msgid "Fake Bold/Italic"
msgstr "കൃത്രിമ ബോൾഡ്/ഇറ്റാലിക്"

#: temp.glade:8783
msgid "If the font you are using doesn't\n"
"have multiple typefaces (such\n"
"as Bold, Italic and Bold-Italic)\n"
"then you can \"fake\" these by\n"
"adding boldness and/or slant\n"
"to the regular typeface."
msgstr "നിങ്ങൾ ഉപയോഗിക്കുന്ന ഫോണ്ടിന്\n"
"ഒന്നിലധികം ടൈപ്പ്ഫേസുകൾ (Bold,\n"
"Italic, Bold-Italic പോലുള്ളവ)\n"
"ഇല്ലെങ്കിൽ, regular ടൈപ്പ്ഫേസിന്\n"
"കട്ടിയും കൂടാതെ/അല്ലെങ്കിൽ ചരിവും\n"
"നൽകി ഇവ കൃത്രിമമായി ഉണ്ടാക്കാം."

#: temp.glade:8816 temp.glade:8837
msgid "The shapes of the characters can be stretched\n"
"(larger) or condensed (smaller) to occupy\n"
"more horizontal space, or less (shrink text).\n"
"1.00 = 100% = normal\n"
"0.95 =   95% = shrink text\n"
"1.05 = 105% = expand text"
msgstr "കൂടുതൽ തിരശ്ചീന സ്ഥലം എടുക്കാൻ അക്ഷരങ്ങളുടെ\n"
"ആകൃതി വലിച്ചുനീട്ടാം (വലുതാക്കാം), അല്ലെങ്കിൽ\n"
"കുറച്ച് സ്ഥലം എടുക്കാൻ ചുരുക്കാം (ടെക്സ്റ്റ് ചുരുക്കുക).\n"
"1.00 = 100% = സാധാരണ\n"
"0.95 =   95% = ടെക്സ്റ്റ് ചുരുക്കുക\n"
"1.05 = 105% = ടെക്സ്റ്റ് വികസിപ്പിക്കുക"

#: temp.glade:8822
msgid "Stretch"
msgstr "വീതി ക്രമീകരണം"

#: temp.glade:8843 temp.glade:12286 temp.glade:12306
msgid "1.00"
msgstr "1.00"

#: temp.glade:8885
msgid "You can enable/disable any font features \n"
"for the selected font. For example:\n"
"smcp=1, cv12=2\n"
"Use 'Select Features...' to choose them\n"
"from a list."
msgstr "തിരഞ്ഞെടുത്ത ഫോണ്ടിന്റെ ഏത് ഫോണ്ട് ഫീച്ചറുകളും \n"
"പ്രവർത്തനക്ഷമമാക്കുകയോ ഒഴിവാക്കുകയോ ചെയ്യാം. ഉദാഹരണം:\n"
"smcp=1, cv12=2\n"
"ലിസ്റ്റിൽ നിന്ന് അവ തിരഞ്ഞെടുക്കാൻ\n"
"'ഫീച്ചറുകൾ തിരഞ്ഞെടുക്കുക...' ഉപയോഗിക്കുക."

#: temp.glade:8900
msgid "Contextual Spaces"
msgstr "സന്ദർഭാനുസൃത സ്പേസുകൾ"

#: temp.glade:8905
msgid "Set this option if the font changes the width of \n"
"spaces depending on the text around them."
msgstr "ചുറ്റുമുള്ള ടെക്സ്റ്റിനനുസരിച്ച് ഫോണ്ട് സ്പേസുകളുടെ \n"
"വീതി മാറ്റുന്നുണ്ടെങ്കിൽ ഈ ഓപ്ഷൻ തിരഞ്ഞെടുക്കുക."

#: temp.glade:8918
msgid "Graphite Rendering"
msgstr "Graphite റെൻഡറിംഗ്"

#: temp.glade:8923
msgid "If you require this font to use\n"
"SIL's Graphite Rendering\n"
"technology, then enable this.\n"
"\n"
"Changing this clears the font features."
msgstr "ഈ ഫോണ്ട് SIL-ന്റെ Graphite\n"
"റെൻഡറിംഗ് സാങ്കേതികവിദ്യ\n"
"ഉപയോഗിക്കണമെങ്കിൽ, ഇത് പ്രവർത്തനക്ഷമമാക്കുക.\n"
"\n"
"ഇത് മാറ്റുമ്പോൾ ഫോണ്ട് ഫീച്ചറുകൾ മായ്ക്കപ്പെടും."

#: temp.glade:8940
msgid "Select Features..."
msgstr "ഫീച്ചറുകൾ തിരഞ്ഞെടുക്കുക..."

#: temp.glade:8945
msgid "Choose font features (and the language)\n"
"from a list of those this font supports."
msgstr "ഈ ഫോണ്ട് പിന്തുണയ്ക്കുന്നവയുടെ ലിസ്റ്റിൽ നിന്ന്\n"
"ഫോണ്ട് ഫീച്ചറുകൾ (ഭാഷയും) തിരഞ്ഞെടുക്കുക."

#: temp.glade:8961
msgid "All known unicode-encoded number/digit systems\n"
"are catered for. So if you don't want to use the\n"
"Latin/Arabic numbers [0-9], you can pick the\n"
"appropriate script here. (Make sure the font you\n"
"are using supports these digits too.)"
msgstr "യൂണിക്കോഡിലുള്ള എല്ലാ അറിയപ്പെടുന്ന സംഖ്യാ/അക്ക\n"
"സമ്പ്രദായങ്ങളും പിന്തുണയ്ക്കുന്നു. അതിനാൽ Latin/Arabic\n"
"അക്കങ്ങൾ [0-9] ഉപയോഗിക്കാൻ താൽപ്പര്യമില്ലെങ്കിൽ, അനുയോജ്യമായ\n"
"ലിപി ഇവിടെ തിരഞ്ഞെടുക്കാം. (നിങ്ങൾ ഉപയോഗിക്കുന്ന ഫോണ്ട്\n"
"ഈ അക്കങ്ങളെ പിന്തുണയ്ക്കുന്നുണ്ടെന്ന് ഉറപ്പാക്കുക.)"

#: temp.glade:8987
msgid "Digit mapping:"
msgstr "അക്കങ്ങളുടെ മാപ്പിംഗ്:"

#: temp.glade:9022
msgid "Select Font Features..."
msgstr "ഫോണ്ട് ഫീച്ചറുകൾ തിരഞ്ഞെടുക്കുക..."

#: temp.glade:9142
msgid "Language:"
msgstr "ഭാഷ:"

#: temp.glade:9154
msgid "Choose the language the font should use.\n"
"Some fonts change letter shapes for\n"
"particular languages."
msgstr "ഫോണ്ട് ഉപയോഗിക്കേണ്ട ഭാഷ തിരഞ്ഞെടുക്കുക.\n"
"ചില ഫോണ്ടുകൾ പ്രത്യേക ഭാഷകൾക്കായി\n"
"അക്ഷരങ്ങളുടെ ആകൃതി മാറ്റുന്നു."

#: temp.glade:9219
msgid "format as bold"
msgstr "ബോൾഡ് ആയി ഫോർമാറ്റ് ചെയ്യുക"

#: temp.glade:9223
msgid "format as italics"
msgstr "ഇറ്റാലിക് ആയി ഫോർമാറ്റ് ചെയ്യുക"

#: temp.glade:9227
msgid "format as bold italics"
msgstr "ബോൾഡ് ഇറ്റാലിക് ആയി ഫോർമാറ്റ് ചെയ്യുക"

#: temp.glade:9231
msgid "format with emphasis"
msgstr "ഊന്നൽ നൽകി ഫോർമാറ്റ് ചെയ്യുക"

#: temp.glade:9235
msgid "with ⸤floor⸥ brackets"
msgstr "⸤ഫ്ലോർ⸥ ബ്രാക്കറ്റുകളോടെ"

