#: temp.glade:21504
msgid "Hide Empty Verses"
msgstr "ശൂന്യവും ചില വാക്കുകളും അല്ലാതെ വിജയഗയം മറയ്ക്കുക"

#: temp.glade:21505
msgid "Show or hide empty verses"
msgstr "ശൂന്യമായ മാസം കാണിക്കുക അല്ലെങ്കിൽ മറയ്ക്കുക"

