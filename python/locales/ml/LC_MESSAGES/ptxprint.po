#: temp.glade:15336
msgid "Adjustments"
msgstr "അഡ്ജസ്റ്റ്മെന്റുകൾ"

#: temp.glade:15341
msgid "Show color-coded lines on the left \n"
"and right edges of paragraphs to\n"
"indicate the kind of shrink or\n"
"stretch that has been applied as well\n"
"as the amount (thickness of line).\n"
"\n"
"These adjustment annotations are not\n"
"part of the PDF, but are only overlaid\n"
"on the text to help refine the layout.\n"
"\n"
"Key:\n"
"\n"
"Left=shrink       Right=expand\n"
"\n"
"blue=shrink/expand lines\n"
"red=shrink/expand text\n"
"\n"
"Interleaved red+blue indicates\n"
"that both lines and text have\n"
"been shrunk (or both expanded)."
msgstr "ഖണ്ഡികകളുടെ ഇടത്തും വലത്തും\n"
"അരികുകളിൽ നിറമുള്ള വരകൾ കാണിക്കുക.\n"
"ഏതുതരം ചുരുക്കലോ വലുതാക്കലോ ആണ്\n"
"പ്രയോഗിച്ചതെന്നും അത് എത്രത്തോളമാണെന്നും\n"
"(വരയുടെ കനം) ഇവ സൂചിപ്പിക്കുന്നു.\n"
"\n"
"ഈ ക്രമീകരണ സൂചനകൾ PDF-ന്റെ\n"
"ഭാഗമല്ല. ലേഔട്ട് മെച്ചപ്പെടുത്താൻ സഹായിക്കാനായി\n"
"ടെക്സ്റ്റിനു മുകളിൽ കാണിക്കുന്നു എന്നു മാത്രം.\n"
"\n"
"സൂചന:\n"
"\n"
"ഇടത്=ചുരുക്കൽ       വലത്=വലുതാക്കൽ\n"
"\n"
"നീല=വരികൾ ചുരുക്കൽ/വലുതാക്കൽ\n"
"ചുവപ്പ്=ടെക്സ്റ്റ് ചുരുക്കൽ/വലുതാക്കൽ\n"
"\n"
"ചുവപ്പും നീലയും ഇടകലർന്നു കണ്ടാൽ\n"
"വരികളും ടെക്സ്റ്റും രണ്ടും\n"
"ചുരുക്കി (അല്ലെങ്കിൽ രണ്ടും വലുതാക്കി) എന്നർത്ഥം."

