#: temp.glade:21146
msgid "Start 1st Chapter on a New Page"
msgstr "1-ാം അദ്ധ്യായം പുതിയ പേജിൽ ആരംഭിക്കുക"

#: temp.glade:21147
msgid "Start new page after introduction"
msgstr "പുസ്തകത്തിന്‍റെ വിവരണത്തിന്‍റാരംഭം മാത്രം"

