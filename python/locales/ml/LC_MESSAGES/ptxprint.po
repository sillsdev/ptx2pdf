msgstr "ക്രമീകരണങ്ങൾ"

#: temp.glade:15476
msgid "Layout Analysis"
msgstr "ലേഔട്ട് വിശകലനം"

#: temp.glade:15481
msgid "This option analyzes the text\n"
"to highlight layout issues:\n"
" - character collisions\n"
" - missing glyphs (bad glyphs)\n"
" - excessive horizontal space\n"
" - vertical rivers of space"
msgstr "ലേഔട്ടിലെ പ്രശ്നങ്ങൾ എടുത്തുകാണിക്കാൻ\n"
"ഈ ഓപ്ഷൻ ടെക്സ്റ്റ് വിശകലനം ചെയ്യുന്നു:\n"
" - അക്ഷരങ്ങൾ തമ്മിൽ കൂട്ടിമുട്ടൽ\n"
" - ഇല്ലാത്ത ഗ്ലിഫുകൾ (തെറ്റായ ഗ്ലിഫുകൾ)\n"
" - അമിതമായ തിരശ്ചീന സ്ഥലം\n"
" - ലംബമായി ഒഴുകുന്ന ഒഴിഞ്ഞ ഇടങ്ങൾ"

#: temp.glade:15509
