#: lib/ptxprint/texpert.py:111
msgid "The ref character style can include an attribute like loc=\"GEN 1:2\". Should this be used to make a clickable link?"
msgstr "ref कैरेक्टर स्टाइल में loc=\"GEN 1:2\" जैसा एट्रिब्यूट हो सकता है। क्या इससे क्लिक करने लायक लिंक बनाया जाए?"

#: lib/ptxprint/texpert.py:112
msgid "Use href-link attrib on jmp to make a link"
msgstr "लिंक बनाने के लिए jmp पर href-link एट्रिब्यूट इस्तेमाल करें"

#: lib/ptxprint/texpert.py:113
msgid "The jmp character style can include an attribute like href-link=\"https://my.web.site/\". Should this be used to make a clickable link?"
msgstr "jmp कैरेक्टर स्टाइल में href-link=\"https://my.web.site/\" जैसा एट्रिब्यूट हो सकता है। क्या इससे क्लिक करने लायक लिंक बनाया जाए?"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Underline only"
msgstr "सिर्फ़ अंडरलाइन"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "No line"
msgstr "कोई लाइन नहीं"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Dashed line"
msgstr "डैश वाली लाइन"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Viewer default"
msgstr "व्यूअर की डिफ़ॉल्ट"

#: lib/ptxprint/texpert.py:116
msgid "Box style for URL links"
msgstr "URL लिंक के लिए बॉक्स स्टाइल"

#: lib/ptxprint/texpert.py:116
msgid "Active web links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\URLLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "PDF में चालू वेब लिंक पर बॉक्स (ठोस, डैश या बिंदुओं वाली लाइन) या अंडरलाइन का निशान होता है। आपके व्यूअर में शायद पहले से एक सेटिंग हो। रंग बदलने के लिए ptxprint-mods.tex में \\def\\URLLinkBorderCol{0.9 0.5 0.5} या ऐसा ही कुछ लिखें।"

#: lib/ptxprint/texpert.py:119
msgid "Box style for GOTO links"
msgstr "GOTO लिंक के लिए बॉक्स स्टाइल"

#: lib/ptxprint/texpert.py:119
msgid "Active internal links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "PDF में चालू अंदरूनी लिंक पर बॉक्स (ठोस, डैश या बिंदुओं वाली लाइन) या अंडरलाइन का निशान होता है। आपके व्यूअर में शायद पहले से एक सेटिंग हो। रंग बदलने के लिए ptxprint-mods.tex में \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} या ऐसा ही कुछ लिखें।"

#: lib/ptxprint/texpert.py:120
msgid "Use glyph metrics"
msgstr "ग्लिफ़ मेट्रिक्स इस्तेमाल करें"

#: lib/ptxprint/texpert.py:121
msgid "PTXprint can use either the actual glyph metrics in a line or the font metrics to calculate line heights and depths. Font metrics gives more consistent results."
msgstr "लाइन की ऊँचाई और गहराई का हिसाब लगाने के लिए PTXprint लाइन के असली ग्लिफ़ मेट्रिक्स या फ़ॉन्ट मेट्रिक्स, दोनों में से कोई भी इस्तेमाल कर सकता है। फ़ॉन्ट मेट्रिक्स से नतीजे ज़्यादा एक जैसे आते हैं।"

#: lib/ptxprint/texpert.py:123
msgid "Use system fonts"
msgstr "सिस्टम फ़ॉन्ट इस्तेमाल करें"

#: lib/ptxprint/texpert.py:124
msgid "Use fonts from your system as well as your project. Note that you need to restart PTXprint for this setting to take effect."
msgstr "अपने प्रोजेक्ट के साथ-साथ सिस्टम के फ़ॉन्ट भी इस्तेमाल करें। ध्यान दें कि यह सेटिंग लागू होने के लिए PTXprint को दोबारा चालू करना होगा।"

#: lib/ptxprint/texpert.py:125
msgid "Underline thickness (em)"
msgstr "अंडरलाइन की मोटाई (em)"

#: lib/ptxprint/texpert.py:126
msgid "This sets the thickness of the text underline, (measured in ems)."
msgstr "यह टेक्स्ट की अंडरलाइन की मोटाई तय करता है (em में नापी जाती है)।"

#: lib/ptxprint/texpert.py:128
msgid "Underline vertical position (em)"
msgstr "अंडरलाइन की खड़ी जगह (em)"

#: lib/ptxprint/texpert.py:129
msgid "This sets how far (in ems) the underline is below the text and what it is relative to. If negative, it is the distance below the baseline. If positive (or zero), it is the distance below the bottom of any descenders."
msgstr "यह तय करता है कि अंडरलाइन टेक्स्ट से कितनी नीचे (em में) हो और किस से नापी जाए। अगर नंबर माइनस में है, तो यह बेसलाइन से नीचे की दूरी है। अगर प्लस (या ज़ीरो) है, तो यह डिसेंडर के सबसे निचले हिस्से से नीचे की दूरी है।"

#: lib/ptxprint/texpert.py:131
msgid "Underline Spaces"
msgstr "खाली जगहों पर अंडरलाइन"

#: lib/ptxprint/texpert.py:132
msgid "Underline spaces in underlined runs"
msgstr "अंडरलाइन किए हुए हिस्सों में खाली जगहों पर भी अंडरलाइन लगाएँ"

#: lib/ptxprint/texpert.py:133
msgid "Log font creation"
msgstr "फ़ॉन्ट बनने का लॉग रखें"

#: lib/ptxprint/texpert.py:134
msgid "Create <jobname>.fontusage in the local/ptxprint/<config>/ directory, which will list the page number and exact font definition when each new style is first used."
msgstr "local/ptxprint/<config>/ फ़ोल्डर में <jobname>.fontusage बनाएँ। इसमें हर नया स्टाइल पहली बार इस्तेमाल होने पर पेज नंबर और फ़ॉन्ट की पूरी जानकारी लिखी जाएगी।"

#: lib/ptxprint/texpert.py:136
msgid "Mid-Page Footnotes"
msgstr "पेज के बीच में फ़ुटनोट"

#: lib/ptxprint/texpert.py:137
msgid "Should footnotes go before a single-double column transition"
msgstr "क्या फ़ुटनोट एक कॉलम से दो कॉलम में बदलने की जगह से पहले आएँ"

#: lib/ptxprint/texpert.py:138
msgid "Final Page Notes Down"
msgstr "आख़िरी पेज के नोट नीचे"

#: lib/ptxprint/texpert.py:139
msgid "Push notes on the final page to the bottom of the page"
msgstr "आख़िरी पेज के नोट को पेज के नीचे धकेलें"

#: lib/ptxprint/texpert.py:140
msgid "Reset Callers at Each Book"
msgstr "हर किताब पर कॉलर रीसेट करें"

#: lib/ptxprint/texpert.py:141
msgid "Re-start the footnote and cross-reference callers at the start of each book"
msgstr "हर किताब की शुरुआत में फ़ुटनोट और क्रॉस-रेफ़रेंस कॉलर दोबारा शुरू करें"

#: lib/ptxprint/texpert.py:142
msgid "Endnotes at Each Book"
msgstr "हर किताब के अंत में एंडनोट"

#: lib/ptxprint/texpert.py:143
msgid "Output endnotes at the end of each book"
msgstr "एंडनोट हर किताब के अंत में दिखाएँ"

#: lib/ptxprint/texpert.py:144
msgid "Enhanced paragraphed footnotes"
msgstr "बेहतर पैराग्राफ़ वाले फ़ुटनोट"

#: lib/ptxprint/texpert.py:145
msgid "Paragraphed footnotes which allow \\fp to work and also the ifparnotes... controls below. Causes some spacing differences compared to old-style."
msgstr "पैराग्राफ़ वाले फ़ुटनोट, जिनमें \\fp काम करता है और नीचे के ifparnotes... कंट्रोल भी काम करते हैं। पुराने तरीके की तुलना में स्पेसिंग में कुछ फ़र्क़ आता है।"

#: lib/ptxprint/texpert.py:146
msgid "Remove depth above paragraphed notes"
msgstr "पैराग्राफ़ वाले नोट के ऊपर की डेप्थ हटाएँ"

#: lib/ptxprint/texpert.py:147
msgid "Kern away (kill) the glyph/font depth of note types before paragraphed notes, using the value of \\prevdepth"
msgstr "पैराग्राफ़ वाले नोट से पहले के नोट टाइप की ग्लिफ़/फ़ॉन्ट डेप्थ को \\prevdepth की वैल्यू से कर्न करके हटाएँ"

#: lib/ptxprint/texpert.py:148
msgid "Remove depth after paragraphed notes"
msgstr "पैराग्राफ़ वाले नोट के बाद की डेप्थ हटाएँ"

#: lib/ptxprint/texpert.py:149
msgid "Kill the depth of (the last row of) paragraphed note styles. Paragraphed notes will use the margin as their baseline."
msgstr "पैराग्राफ़ वाले नोट स्टाइल की (आख़िरी लाइन की) डेप्थ हटाएँ। पैराग्राफ़ वाले नोट मार्जिन को अपनी बेसलाइन बनाएँगे।"

#: lib/ptxprint/texpert.py:150
msgid "Use grid not font/glyph height at rule"
msgstr "रूल पर फ़ॉन्ट/ग्लिफ़ की ऊँचाई की जगह ग्रिड इस्तेमाल करें"

#: lib/ptxprint/texpert.py:151
msgid "If true, the footnote rule is positioned relative to the hypothetical baseline above the topmost footnote, rather than relative to the glyph/font height."
msgstr "चालू हो तो फ़ुटनोट रूल, सबसे ऊपर वाले फ़ुटनोट के ऊपर की काल्पनिक बेसलाइन के हिसाब से रखा जाता है, ग्लिफ़/फ़ॉन्ट की ऊँचाई के हिसाब से नहीं।"

#: lib/ptxprint/texpert.py:152
msgid "Use grid not font/glyph height between notes"
msgstr "नोट के बीच फ़ॉन्ट/ग्लिफ़ की ऊँचाई की जगह ग्रिड इस्तेमाल करें"

#: lib/ptxprint/texpert.py:153
msgid "If true, then the \\InterNoteSpace is relative to the hypothetical baseline above the topmost footnote, rather than the glyph/font height. \\InterNoteSpace is triggered between note styles."
msgstr "चालू हो तो \\InterNoteSpace, सबसे ऊपर वाले फ़ुटनोट के ऊपर की काल्पनिक बेसलाइन के हिसाब से होता है, ग्लिफ़/फ़ॉन्ट की ऊँचाई के हिसाब से नहीं। \\InterNoteSpace नोट स्टाइल के बीच लगता है।"

#: lib/ptxprint/texpert.py:154
msgid "Use glyph height not font height in footnotes"
msgstr "फ़ुटनोट में फ़ॉन्ट की ऊँचाई की जगह ग्लिफ़ की ऊँचाई इस्तेमाल करें"

#: lib/ptxprint/texpert.py:155
msgid "Does the note use the font's descender design parameter, or the actual bottom of the glyph. If the former (and depth is not killed), then the bottom of notes have a common baseline across pages. If the latter, then the glyphs sit as close to the bottom margin as they can, which may permit an extra line of text."
msgstr "नोट फ़ॉन्ट के डिसेंडर डिज़ाइन पैरामीटर का इस्तेमाल करे या ग्लिफ़ के असली निचले हिस्से का? अगर पहला (और डेप्थ हटाई नहीं गई), तो सभी पेजों पर नोट की निचली बेसलाइन एक जैसी रहती है। अगर दूसरा, तो ग्लिफ़ नीचे के मार्जिन के जितने पास हो सकें बैठते हैं, जिससे टेक्स्ट की एक और लाइन आ सकती है।"

#: lib/ptxprint/texpert.py:156
msgid "Last Note: interlinepenalty"
msgstr "आख़िरी नोट: interlinepenalty"

#: lib/ptxprint/texpert.py:157
msgid "Penalty for breaking between lines of the last footnote."
msgstr "आख़िरी फ़ुटनोट की लाइनों के बीच ब्रेक करने की पेनल्टी।"

#: lib/ptxprint/texpert.py:158
msgid "Last Note: widowpenalty"
msgstr "आख़िरी नोट: widowpenalty"

#: lib/ptxprint/texpert.py:159
msgid "Extra penalty for breaking at the last line of the last footnote."
msgstr "आख़िरी फ़ुटनोट की आख़िरी लाइन पर ब्रेक करने की अतिरिक्त पेनल्टी।"

#: lib/ptxprint/texpert.py:160
msgid "Last Note: clubpenalty"
msgstr "आख़िरी नोट: clubpenalty"

#: lib/ptxprint/texpert.py:161
msgid "Extra penalty for breaking at the first line of the last footnote."
msgstr "आख़िरी फ़ुटनोट की पहली लाइन पर ब्रेक करने की अतिरिक्त पेनल्टी।"

#: lib/ptxprint/texpert.py:162
msgid "Last Note: penalty at par"
msgstr "आख़िरी नोट: पैराग्राफ़ पर पेनल्टी"

#: lib/ptxprint/texpert.py:163
msgid "Penalty for breaking at an explicit footnote-paragraph in the last footnote."
msgstr "आख़िरी फ़ुटनोट में साफ़ तौर पर दिए फ़ुटनोट-पैराग्राफ़ पर ब्रेक करने की पेनल्टी।"

#: lib/ptxprint/texpert.py:164
msgid "Split notes: Shortest note to shave"
msgstr "नोट बाँटना: शेव करने के लिए सबसे छोटा नोट"

#: lib/ptxprint/texpert.py:165
msgid "If footnotes might be shaved, how many lines must it be?"
msgstr "अगर फ़ुटनोट शेव किए जा सकते हैं, तो वह कम से कम कितनी लाइन का होना चाहिए?"

#: lib/ptxprint/texpert.py:166
msgid "Split notes: min lines to move."
msgstr "नोट बाँटना: खिसकाने के लिए कम से कम लाइनें"

#: lib/ptxprint/texpert.py:167
msgid "If a footnote is being shaved (split onto next page), what is the minimum number of lines to move?"
msgstr "अगर फ़ुटनोट शेव हो रहा है (अगले पेज पर बँट रहा है), तो कम से कम कितनी लाइनें खिसकानी हैं?"

#: lib/ptxprint/texpert.py:168
msgid "Split notes: note lines to stay"
msgstr "नोट बाँटना: पेज पर रहने वाली नोट लाइनें"

#: lib/ptxprint/texpert.py:169
msgid "If a footnote is being shaved (split onto next page), how many lines of (all) notes must remain on the page?"
msgstr "अगर फ़ुटनोट शेव हो रहा है (अगले पेज पर बँट रहा है), तो (सभी) नोट की कितनी लाइनें पेज पर रहनी चाहिए?"

#: lib/ptxprint/texpert.py:170
msgid "Study note factor-Single column"
msgstr "स्टडी नोट फ़ैक्टर-सिंगल कॉलम"

#: lib/ptxprint/texpert.py:171
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "बेकार के साइकिल और अधूरे पेज से बचने के लिए, सिंगल-कॉलम मोड में इनपुट जमा करते समय TeX स्टडी नोट की ऊँचाई के अनुमान का कितना हिस्सा इस्तेमाल करे? (100=10 प्रतिशत)"

#: lib/ptxprint/texpert.py:172
msgid "Study note factor-Two column"
msgstr "स्टडी नोट फ़ैक्टर-टू कॉलम"

#: lib/ptxprint/texpert.py:173
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "बेकार के साइकिल और अधूरे पेज से बचने के लिए, टू-कॉलम मोड में इनपुट जमा करते समय TeX स्टडी नोट की ऊँचाई के अनुमान का कितना हिस्सा इस्तेमाल करे? (100=10 प्रतिशत)"

#: lib/ptxprint/texpert.py:174
msgid "Study note factor-Diglot"
msgstr "स्टडी नोट फ़ैक्टर-डाइग्लॉट"

#: lib/ptxprint/texpert.py:175
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "बेकार के साइकिल और अधूरे पेज से बचने के लिए, डाइग्लॉट इनपुट जमा करते समय TeX स्टडी नोट की ऊँचाई के अनुमान का कितना हिस्सा इस्तेमाल करे? (100=10 प्रतिशत)"

#: lib/ptxprint/texpert.py:176
msgid "Footnote factor-Single column"
msgstr "फ़ुटनोट फ़ैक्टर-सिंगल कॉलम"

#: lib/ptxprint/texpert.py:177
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "बेकार के साइकिल और अधूरे पेज से बचने के लिए, सिंगल-कॉलम मोड में इनपुट जमा करते समय TeX नोट की ऊँचाई के अनुमान का कितना हिस्सा इस्तेमाल करे? (100=10 प्रतिशत)"

#: lib/ptxprint/texpert.py:178
msgid "Footnote factor-Two column"
msgstr "फ़ुटनोट फ़ैक्टर-दो कॉलम"

#: lib/ptxprint/texpert.py:179
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "बेकार के साइकिल और अधूरे पेज से बचने के लिए, टू-कॉलम मोड में इनपुट जमा करते समय TeX नोट की ऊँचाई के अनुमान का कितना हिस्सा इस्तेमाल करे? (100=10 प्रतिशत)"

#: lib/ptxprint/texpert.py:180
msgid "Footnote factor-Diglot"
msgstr "फ़ुटनोट फ़ैक्टर-डाइग्लॉट"

#: lib/ptxprint/texpert.py:181
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "बेकार के साइकिल और अधूरे पेज से बचने के लिए, डाइग्लॉट इनपुट जमा करते समय TeX नोट की ऊँचाई के अनुमान का कितना हिस्सा इस्तेमाल करे? (100=10 प्रतिशत)"

#: lib/ptxprint/texpert.py:182
msgid "Footnote factor-Centre column"
msgstr "फ़ुटनोट फ़ैक्टर-बीच का कॉलम"

#: lib/ptxprint/texpert.py:183
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering centre-column notes? (100=10percent)"
msgstr "बेकार के साइकिल और अधूरे पेज से बचने के लिए, बीच वाले कॉलम के नोट जमा करते समय TeX नोट की ऊँचाई के अनुमान का कितना हिस्सा इस्तेमाल करे? (100=10 प्रतिशत)"

#: lib/ptxprint/texpert.py:184
msgid "Distance of margin notes from text"
msgstr "मार्जिन नोट की टेक्स्ट से दूरी"

#: lib/ptxprint/texpert.py:185
msgid "The size of the gap between the margin notes and the text"
msgstr "मार्जिन नोट और टेक्स्ट के बीच की खाली जगह का नाप"

#: lib/ptxprint/texpert.py:187
msgid "Balance diglot/polyglot notes"
msgstr "डाइग्लॉट/पॉलीग्लॉट नोट बराबर करें"

#: lib/ptxprint/texpert.py:188
msgid "When there's a note on column R (for example), does that reduce the space from other columns?"
msgstr "जब (जैसे) कॉलम R में कोई नोट हो, तो क्या इससे दूसरे कॉलम की जगह कम हो जाती है?"

#: lib/ptxprint/texpert.py:189
msgid "Diglot/polyglot merged paragraphed notes are RTL"
msgstr "डाइग्लॉट/पॉलीग्लॉट के जुड़े हुए पैराग्राफ़ नोट RTL हैं"

#: lib/ptxprint/texpert.py:190
msgid "When merged notes are not shown as individual paragraphs, the result must be arranged as though RTL or LTR (however the individual notes are structured). This defines the paragraph alignment."
msgstr "जब मर्ज किए गए नोट अलग-अलग पैराग्राफ़ के रूप में नहीं दिखाए जाते, तो नतीजा RTL या LTR की तरह सजाया जाना चाहिए (चाहे अलग-अलग नोट किसी भी तरह बने हों)। यह पैराग्राफ़ की अलाइनमेंट तय करता है।"

#: lib/ptxprint/texpert.py:191
msgid "Adjust Versification of Projects"
msgstr "प्रोजेक्ट की वर्सिफ़िकेशन ठीक करें"

#: lib/ptxprint/texpert.py:192
msgid "If versification differs between projects, adjust diglot/polyglot projects to match the primary (L) project."
msgstr "अगर प्रोजेक्ट के बीच वर्सिफ़िकेशन अलग हो, तो डाइग्लॉट/पॉलीग्लॉट प्रोजेक्ट को मुख्य (L) प्रोजेक्ट के जैसा कर दें।"

#: lib/ptxprint/texpert.py:193
msgid "Keep existing verse numbers (as \\vp)"
msgstr "मौजूदा पद संख्याएँ रखें (\\vp के रूप में)"

#: lib/ptxprint/texpert.py:194
msgid "When adjusting versification, show the original verse numbers in their new (adjusted) location."
msgstr "वर्सिफ़िकेशन ठीक करते समय, असली पद संख्याएँ उनकी नई (ठीक की गई) जगह पर दिखाएँ।"

#: lib/ptxprint/texpert.py:195
msgid "Show old chapter numbers if changed (in \\vp)"
msgstr "बदलने पर पुरानी अध्याय संख्याएँ दिखाएँ (\\vp में)"

#: lib/ptxprint/texpert.py:196
msgid "When adjusting versification, show the adjusted chapter numbers (only) if they have changed."
msgstr "वर्सिफ़िकेशन ठीक करते समय, ठीक की गई अध्याय संख्याएँ (सिर्फ़) तब दिखाएँ जब वे बदली हों।"

#: lib/ptxprint/texpert.py:197
msgid "Show Diglot Trace Marks"
msgstr "डाइग्लॉट ट्रेस मार्क दिखाएँ"

#: lib/ptxprint/texpert.py:198
msgid "Insert visible trace marks in diglot output"
msgstr "डाइग्लॉट आउटपुट में दिखने वाले ट्रेस मार्क डालें"

#: lib/ptxprint/texpert.py:199
msgid "Extra Trace Mark Info"
msgstr "ट्रेस मार्क की अतिरिक्त जानकारी"

#: lib/ptxprint/texpert.py:200
msgid "Add extra information to diglot trace marks. (debugging only - can alter layout)"
msgstr "डाइग्लॉट ट्रेस मार्क में अतिरिक्त जानकारी जोड़ें। (सिर्फ़ डीबग के लिए - लेआउट बदल सकता है)"

#: lib/ptxprint/texpert.py:201
msgid "Diglot Shading Padding"
msgstr "डाइग्लॉट शेडिंग पैडिंग"

#: lib/ptxprint/texpert.py:202
msgid "The amount of side padding (pt) on the shaded background of a diglot"
msgstr "डाइग्लॉट की शेड वाली बैकग्राउंड पर दोनों तरफ़ की पैडिंग (pt) का नाप"

#: lib/ptxprint/texpert.py:204
msgid "Borders start at body text"
msgstr "बॉर्डर बॉडी टेक्स्ट से शुरू हों"

#: lib/ptxprint/texpert.py:204
msgid "Borders include book intros"
msgstr "बॉर्डर में किताब का परिचय शामिल हो"

#: lib/ptxprint/texpert.py:204
msgid "Wide book intros for per-column textborders"
msgstr "हर कॉलम के टेक्स्ट बॉर्डर के लिए चौड़ा किताब परिचय"

#: lib/ptxprint/texpert.py:205
msgid "How does text-border behave in diglots?"
msgstr "डाइग्लॉट में टेक्स्ट-बॉर्डर कैसे काम करता है?"

#: lib/ptxprint/texpert.py:205
msgid "Historically, diglot text-borders put the border around book introductions. This control allows that (substandard) behaviour to be chosen, and also allows  experimental code to make books with per-column textborders use full-width text for introductory text."
msgstr "पहले, डाइग्लॉट के टेक्स्ट-बॉर्डर किताब के परिचय के चारों ओर भी बॉर्डर लगाते थे। यह कंट्रोल उस (कमज़ोर) तरीके को चुनने देता है। साथ ही यह एक्सपेरिमेंटल कोड को हर कॉलम के टेक्स्ट बॉर्डर वाली किताबों में परिचय के टेक्स्ट के लिए पूरी चौड़ाई इस्तेमाल करने देता है।"

#: lib/ptxprint/texpert.py:206
msgid "Unprintable page recovery."
msgstr "न छपने वाले पेज की रिकवरी।"

#: lib/ptxprint/texpert.py:207
msgid "If notes / figures make a page unprintable: -1: immediately stop; 0: print failed contents and try to struggle on; >0 grow page height by up to N lines."
msgstr "अगर नोट / चित्र की वजह से पेज छप न सके: -1: तुरंत रुक जाएँ; 0: जो हो सका वह छापें और आगे बढ़ने की कोशिश करें; >0 पेज की ऊँचाई ज़्यादा से ज़्यादा N लाइन तक बढ़ाएँ।"

#: lib/ptxprint/texpert.py:208
msgid "1xBiggest baseline"
msgstr "1x सबसे बड़ी बेसलाइन"

#: lib/ptxprint/texpert.py:208
msgid "2xSmallest baseline"
msgstr "2x सबसे छोटी बेसलाइन"

#: lib/ptxprint/texpert.py:208
msgid "2xBiggest baseline"
msgstr "2x सबसे बड़ी बेसलाइन"

#: lib/ptxprint/texpert.py:208
msgid "3xSmallest baseline"
msgstr "3x सबसे छोटी बेसलाइन"

#: lib/ptxprint/texpert.py:208
msgid "Page-full test."
msgstr "पेज-भरा टेस्ट।"

#: lib/ptxprint/texpert.py:209
msgid "When a (non-title) chunk has finished, the amount of unused space below which diglot will immediately output a page,  rather than trying to fit the next chunk. (irrespective of how short it is). Higher values encourage underfilled pages, but can prevent orphaning of the 1st line of poetry."
msgstr "जब (बिना शीर्षक वाला) एक हिस्सा पूरा हो जाए, तो खाली जगह इस नाप से कम होने पर डाइग्लॉट अगला हिस्सा फ़िट करने की कोशिश किए बिना तुरंत पेज बना देगा (चाहे वह कितना भी छोटा हो)। ज़्यादा नाप से पेज कम भरे रह सकते हैं, लेकिन कविता की पहली लाइन अकेली रह जाने से बचती है।"

#: lib/ptxprint/texpert.py:210
msgid "Default Figures Top Left"
msgstr "चित्र डिफ़ॉल्ट रूप से ऊपर बाएँ"

#: lib/ptxprint/texpert.py:211
msgid "Default figure positions to top left"
msgstr "चित्र की डिफ़ॉल्ट जगह ऊपर बाएँ रखें"

#: lib/ptxprint/texpert.py:212
msgid "Ref Before Caption"
msgstr "कैप्शन से पहले रेफ़रेंस"

#: lib/ptxprint/texpert.py:213
msgid "Output reference before caption"
msgstr "कैप्शन से पहले रेफ़रेंस दिखाएँ"

#: lib/ptxprint/texpert.py:214
msgid "Show Caption Before Image"
msgstr "कैप्शन को तस्वीर से पहले दिखाएँ"

#: lib/ptxprint/texpert.py:215
msgid "Output caption before image"
msgstr "कैप्शन को तस्वीर से पहले दिखाएँ"

#: lib/ptxprint/texpert.py:216
msgid "Space (pt) beside cutout/sidebar"
msgstr "कटआउट/साइडबार के पास जगह (pt)"

#: lib/ptxprint/texpert.py:217
msgid "This sets the default gap (pt) between the body text and the side of a figure/sidebar in a cutout."
msgstr "यह कटआउट में मुख्य टेक्स्ट और फ़िगर/साइडबार के किनारे के बीच की डिफ़ॉल्ट दूरी (pt) तय करता है।"

#: lib/ptxprint/texpert.py:218
msgid "Space between picture & caption"
msgstr "तस्वीर और कैप्शन के बीच जगह"

#: lib/ptxprint/texpert.py:219
msgid "Increase/Reduce the gap between figures and their captions"
msgstr "फ़िगर और उनके कैप्शन के बीच की दूरी बढ़ाएँ/घटाएँ"

#: lib/ptxprint/texpert.py:220
msgid "Default space beside picture"
msgstr "तस्वीर के पास डिफ़ॉल्ट जगह"

#: lib/ptxprint/texpert.py:221
msgid "Picture horizontal margin*2"
msgstr "तस्वीर का क्षैतिज मार्जिन*2"

#: lib/ptxprint/texpert.py:222
msgid "Show comprehensive illustration credits"
msgstr "तस्वीरों के पूरे क्रेडिट दिखाएँ"

#: lib/ptxprint/texpert.py:223
msgid "Instead of using the catch-all phrasing 'All other illustrations by...' show a comprehensive list of every artist and all pages that contain their illustrations."
msgstr "'All other illustrations by...' जैसा आम वाक्य इस्तेमाल करने के बजाय, हर कलाकार और उन सभी पन्नों की पूरी सूची दिखाएँ जिनमें उनकी तस्वीरें हैं।"

#: lib/ptxprint/texpert.py:225
msgid "No PDF Bookmarks"
msgstr "PDF बुकमार्क नहीं"

#: lib/ptxprint/texpert.py:226
msgid "Don’t output PDF bookmarks"
msgstr "PDF बुकमार्क न बनाएँ"

#: lib/ptxprint/texpert.py:227
msgid "Allow Active Links in PDF"
msgstr "PDF में चालू लिंक की इजाज़त दें"

#: lib/ptxprint/texpert.py:228
msgid "Make links active inside PDF"
msgstr "PDF के अंदर लिंक चालू करें"

#: lib/ptxprint/texpert.py:229
msgid "Use Book Codes in PDF Bookmarks"
msgstr "PDF बुकमार्क में किताब के कोड इस्तेमाल करें"

#: lib/ptxprint/texpert.py:230
msgid "Use book codes instead of book names in bookmarks"
msgstr "बुकमार्क में किताब के नाम की जगह किताब के कोड इस्तेमाल करें"

#: lib/ptxprint/texpert.py:231
msgid "Disable Transparency in PDF"
msgstr "PDF में ट्रांसपेरेंसी बंद करें"

#: lib/ptxprint/texpert.py:232
msgid "Disable transparency output in PDF"
msgstr "PDF में ट्रांसपेरेंसी आउटपुट बंद करें"

#: lib/ptxprint/texpert.py:233
msgid "Show adjust points"
msgstr "ऐडजस्ट पॉइंट दिखाएँ"

#: lib/ptxprint/texpert.py:234
msgid "Show adjust points in the margin of the text."
msgstr "टेक्स्ट के मार्जिन में ऐडजस्ट पॉइंट दिखाएँ।"

#: lib/ptxprint/texpert.py:235
msgid "Mark Trigger Points"
msgstr "ट्रिगर पॉइंट पर निशान लगाएँ"

#: lib/ptxprint/texpert.py:236
msgid "Display trigger points in output"
msgstr "आउटपुट में ट्रिगर पॉइंट दिखाएँ"

#: lib/ptxprint/texpert.py:237
msgid "Show USFM codes"
msgstr "USFM कोड दिखाएँ"

#: lib/ptxprint/texpert.py:238
msgid "Show the USFM markers in the margin beside paragraphs."
msgstr "पैराग्राफ़ के पास मार्जिन में USFM मार्कर दिखाएँ।"

#: lib/ptxprint/texpert.py:239
msgid "Show Error Bars For Overfull Lines"
msgstr "ज़्यादा भरी लाइनों के लिए एरर बार दिखाएँ"

#: lib/ptxprint/texpert.py:240
msgid "Enable this option to have TeX make overfull lines stand out."
msgstr "TeX ज़्यादा भरी लाइनों को अलग से दिखाए, इसके लिए यह विकल्प चालू करें।"

#: lib/ptxprint/texpert.py:243
msgid "Spine Overlap onto Back Cover (mm)"
msgstr "स्पाइन का बैक कवर पर फैलाव (mm)"

#: lib/ptxprint/texpert.py:244
msgid "If you want the spine graphic or colour to spill over onto the back cover page, then set the amount of overlap here."
msgstr "अगर आप चाहते हैं कि स्पाइन की ग्राफ़िक या रंग बैक कवर पेज पर भी फैले, तो फैलाव की मात्रा यहाँ तय करें।"

#: lib/ptxprint/texpert.py:246
msgid "Spine Overlap onto Front Cover (mm)"
msgstr "स्पाइन का फ़्रंट कवर पर फैलाव (mm)"

#: lib/ptxprint/texpert.py:247
msgid "If you want the spine graphic or colour to spill over onto the front cover page, then set the amount of overlap here."
msgstr "अगर आप चाहते हैं कि स्पाइन की ग्राफ़िक या रंग फ़्रंट कवर पेज पर भी फैले, तो फैलाव की मात्रा यहाँ तय करें।"

#: lib/ptxprint/texpert.py:249
msgid "Cover Bleed (mm)"
msgstr "कवर ब्लीड (mm)"

#: lib/ptxprint/texpert.py:250
msgid "Bleed is the section of artwork that goes beyond where the paper is cut. This ensures that the image goes right to the edge of the cover after it has been trimmed."
msgstr "ब्लीड आर्टवर्क का वह हिस्सा है जो कागज़ कटने की जगह से आगे तक जाता है। इससे कवर कटने के बाद भी तस्वीर कवर के किनारे तक पहुँचती है।"

#: lib/ptxprint/texpert.py:252
msgid "Hard Cover Art Bleed (mm)"
msgstr "हार्ड कवर आर्ट ब्लीड (mm)"

#: lib/ptxprint/texpert.py:253
msgid "Art Bleed is specifically for hard cover binding and is the setting which enables images to go beyond the size of the cover in order to wrap around the hard cover and stuck down under the inner backing sheet."
msgstr "आर्ट ब्लीड खास तौर पर हार्ड कवर बाइंडिंग के लिए है। इस सेटिंग से तस्वीरें कवर के साइज़ से आगे जा सकती हैं, ताकि वे हार्ड कवर पर लिपट जाएँ और अंदर की बैकिंग शीट के नीचे चिपक जाएँ।"

#: lib/ptxprint/texpert.py:258
msgid "Auto-update Delay (seconds)"
msgstr "ऑटो-अपडेट की देरी (सेकंड)"

#: lib/ptxprint/texpert.py:259
msgid "Right-clicking again on the PDF within this time (3 second default) will prevent the Auto-update from running."
msgstr "इस समय (डिफ़ॉल्ट 3 सेकंड) के अंदर PDF पर दोबारा राइट-क्लिक करने से ऑटो-अपडेट नहीं चलेगा।"

#: lib/ptxprint/texpert.py:260
msgid "Shrink Text Step Value (%)"
msgstr "टेक्स्ट छोटा करने का स्टेप (%)"

#: lib/ptxprint/texpert.py:261
msgid "Step Value to shrink text using right-click context menu adjustment."
msgstr "राइट-क्लिक मेन्यू से टेक्स्ट छोटा करते समय हर बार का स्टेप।"

#: lib/ptxprint/texpert.py:262
msgid "Minimum Text Shrink (%)"
msgstr "टेक्स्ट कम से कम कितना छोटा हो (%)"

#: lib/ptxprint/texpert.py:263
msgid "Limit how much text can shrink to using right-click context menu adjustment."
msgstr "राइट-क्लिक मेन्यू से टेक्स्ट कितना छोटा किया जा सकता है, इसकी सीमा तय करें।"

#: lib/ptxprint/texpert.py:264
msgid "Expand Text Step Value (%)"
msgstr "टेक्स्ट बढ़ाने का स्टेप (%)"

#: lib/ptxprint/texpert.py:265
msgid "Step Value to expand text using right-click context menu adjustment."
msgstr "राइट-क्लिक मेन्यू से टेक्स्ट बढ़ाते समय हर बार कितना बदलाव हो, यह मान चुनें।"

#: lib/ptxprint/texpert.py:266
msgid "Maximum Text Expand (%)"
msgstr "टेक्स्ट अधिकतम कितना बढ़े (%)"

#: lib/ptxprint/texpert.py:267
msgid "Limit how much text can expand to using right-click context menu adjustment."
msgstr "राइट-क्लिक मेन्यू से टेक्स्ट कितना बड़ा किया जा सकता है, इसकी सीमा तय करें।"

#: lib/ptxprint/texpert.py:268
msgid "Bad Space minimum width (em)"
msgstr "खराब स्पेस की न्यूनतम चौड़ाई (em)"

#: lib/ptxprint/texpert.py:269
msgid "Minimum width for a bad space. 0 says to calculate for the 20 worst spaces in the doc"
msgstr "खराब स्पेस की न्यूनतम चौड़ाई। 0 का मतलब है कि डॉक्यूमेंट के 20 सबसे खराब स्पेस के लिए हिसाब लगाया जाए।"

#: lib/ptxprint/texpert.py:270
msgid "Bad intercharacter space minimum width (em)"
msgstr "अक्षरों के बीच खराब स्पेस की न्यूनतम चौड़ाई (em)"

#: lib/ptxprint/texpert.py:271
msgid "Minimum width for a bad inter character space."
msgstr "अक्षरों के बीच खराब स्पेस की न्यूनतम चौड़ाई।"

#: lib/ptxprint/texpert.py:272
msgid "Precise collisions"
msgstr "सटीक टकराव"

#: lib/ptxprint/texpert.py:273
msgid "Only show precise collisions between glyphs rather than overlapping bounding boxes - slow"
msgstr "बाउंडिंग बॉक्स के ओवरलैप की जगह ग्लिफ़ के बीच सिर्फ़ सटीक टकराव दिखाएँ - धीमा है।"

#: lib/ptxprint/texpert.py:274
msgid "Collision Detection Padding (pt)"
msgstr "टकराव जाँच की पैडिंग (pt)"

#: lib/ptxprint/texpert.py:275
msgid "Minimum space between bounding boxes of glyphs before a collision is flagged."
msgstr "टकराव दिखाने से पहले ग्लिफ़ के बाउंडिंग बॉक्स के बीच न्यूनतम जगह।"

#: lib/ptxprint/texpert.py:276
msgid "River Detection Threshold (em)"
msgstr "रिवर जाँच की सीमा (em)"

#: lib/ptxprint/texpert.py:277
msgid "The sum of all the widths in the river must be above this for the river to be detected"
msgstr "रिवर पकड़ने के लिए रिवर की सभी चौड़ाइयों का जोड़ इससे ज़्यादा होना चाहिए।"

#: lib/ptxprint/texpert.py:278
msgid "River Detection minimum required maximum width (em)"
msgstr "रिवर जाँच में ज़रूरी न्यूनतम अधिकतम चौड़ाई (em)"

#: lib/ptxprint/texpert.py:279
msgid "Minimum width required for the widest part of the river"
msgstr "रिवर के सबसे चौड़े हिस्से के लिए ज़रूरी न्यूनतम चौड़ाई।"

#: lib/ptxprint/texpert.py:28
msgid "Maximum layout version"
msgstr "अधिकतम लेआउट वर्शन"

#: lib/ptxprint/texpert.py:280
msgid "River Detection minimum width (em)"
msgstr "रिवर जाँच की न्यूनतम चौड़ाई (em)"

#: lib/ptxprint/texpert.py:281
msgid "Minimum width of any space in a river for it to be included"
msgstr "रिवर में शामिल होने के लिए किसी भी स्पेस की न्यूनतम चौड़ाई।"

#: lib/ptxprint/texpert.py:282
msgid "River Detection maximum line leading (em)"
msgstr "रिवर जाँच में अधिकतम लाइन लीडिंग (em)"

#: lib/ptxprint/texpert.py:283
msgid "Any lines separated by a gap greater than this will be considered not to be in the same river"
msgstr "इससे ज़्यादा गैप वाली लाइनों को एक ही रिवर का हिस्सा नहीं माना जाएगा।"

#: lib/ptxprint/texpert.py:284
msgid "River Detection minimum overlap (em)"
msgstr "रिवर जाँच में न्यूनतम ओवरलैप (em)"

#: lib/ptxprint/texpert.py:285
msgid "Minimum overlap in ems required for two spaces above each other to be considered part of the same river"
msgstr "ऊपर-नीचे के दो स्पेस को एक ही रिवर का हिस्सा मानने के लिए ज़रूरी न्यूनतम ओवरलैप (em में)।"

#: lib/ptxprint/texpert.py:29
msgid "Maximum layout version to use or 0 for any. Used to maintain backward compatibility when the TeX macros have been changed in newer versions of PTXprint."
msgstr "इस्तेमाल करने के लिए अधिकतम लेआउट वर्शन, या किसी भी वर्शन के लिए 0। PTXprint के नए वर्शन में TeX मैक्रो बदलने पर पुराने के साथ मेल बनाए रखने के लिए यह इस्तेमाल होता है।"

#: lib/ptxprint/texpert.py:290
msgid "Time limit for the whole job (minutes)"
msgstr "पूरे काम की समय सीमा (मिनट)"

#: lib/ptxprint/texpert.py:291
msgid "The page filler works on all the books together. When this time is reached, the page filler stops. A book that is not finished keeps the pages that are already filled. Usually this affects only the longest book.\n"
"Higher: more time to find a good layout for every page."
msgstr "पेज फ़िलर सभी किताबों पर एक साथ काम करता है। यह समय पूरा होने पर पेज फ़िलर रुक जाता है। जो किताब पूरी नहीं हुई, उसके भरे हुए पेज वैसे ही रहते हैं। आम तौर पर यह सिर्फ़ सबसे लंबी किताब पर असर करता है।\n"
"ज़्यादा: हर पेज का अच्छा लेआउट ढूँढने के लिए ज़्यादा समय।"

#: lib/ptxprint/texpert.py:295
msgid "Earlier pages to retry"
msgstr "दोबारा आज़माने वाले पिछले पेज"

#: lib/ptxprint/texpert.py:296
msgid "If the page filler cannot fill a page, it backtracks to the page before and tries a different layout there. This is the largest number of pages it can backtrack.\n"
"Higher: fewer failed pages, but much slower.\n"
"Lower: faster, but more pages may fail. 0 = never backtrack (fastest).\n"
"Affects: Speed."
msgstr "अगर पेज फ़िलर कोई पेज नहीं भर पाता, तो वह पिछले पेज पर लौटकर वहाँ अलग लेआउट आज़माता है। यह उन पेजों की सबसे बड़ी संख्या है जितने पीछे वह लौट सकता है।\n"
"ज़्यादा: कम पेज फ़ेल होंगे, लेकिन काफ़ी धीमा होगा।\n"
"कम: तेज़ होगा, लेकिन ज़्यादा पेज फ़ेल हो सकते हैं। 0 = कभी पीछे नहीं लौटना (सबसे तेज़)।\n"
"असर: स्पीड।"

#: lib/ptxprint/texpert.py:30
msgid "Legacy 1/14 LineSpacing"
msgstr "पुरानी 1/14 लाइन स्पेसिंग"

#: lib/ptxprint/texpert.py:301
msgid "Paragraphs to adjust on each page"
msgstr "हर पेज पर बदलने वाले पैराग्राफ़"

#: lib/ptxprint/texpert.py:302
msgid "The largest number of paragraphs on one page that the page filler may stretch or shrink. Each poetry line (\\q1, \\q2 …) counts as one paragraph. Each extra paragraph doubles the number of layouts the page filler tries.\n"
"Higher: more ways to fill each page, so fewer failed pages, but each page takes longer.\n"
"Lower: faster, but more pages may fail.\n"
"Affects: Speed."
msgstr "एक पेज पर पैराग्राफ़ की वह सबसे बड़ी संख्या जिन्हें पेज फ़िलर खींच या सिकोड़ सकता है। कविता की हर लाइन (\\q1, \\q2 …) एक पैराग्राफ़ गिनी जाती है। हर अतिरिक्त पैराग्राफ़ से पेज फ़िलर के आज़माए लेआउट दोगुने हो जाते हैं।\n"
"ज़्यादा: हर पेज भरने के ज़्यादा तरीके, इसलिए कम पेज फ़ेल होंगे, लेकिन हर पेज में ज़्यादा समय लगेगा।\n"
"कम: तेज़ होगा, लेकिन ज़्यादा पेज फ़ेल हो सकते हैं।\n"
"असर: स्पीड।"

#: lib/ptxprint/texpert.py:309
msgid "Widest word space allowed (× text size)"
msgstr "सबसे चौड़ा शब्द स्पेस (× टेक्स्ट साइज़)"

#: lib/ptxprint/texpert.py:31
msgid "In the past, SpaceAbove and SpaceBelow were, in effect units of 1/14 of the base line spacing. This has changed so they are now in units of 1/12 of the base line spacing. Enabling this compatibility reverts the units."
msgstr "पहले SpaceAbove और SpaceBelow असल में बेस लाइन स्पेसिंग के 1/14 की इकाई में होते थे। अब इसे बदलकर बेस लाइन स्पेसिंग के 1/12 की इकाई कर दिया गया है। इस मेल को चालू करने से पुरानी इकाई लौट आती है।"

#: lib/ptxprint/texpert.py:310
msgid "When the page filler stretches a paragraph, the average space between words must not be wider than this. 1.0 = as wide as the text size. A normal word space is about 0.3 to 0.5.\n"
"Higher: easier to fill pages, but the text can look too spread out.\n"
"Lower: tighter, better-looking text, but pages are harder to fill and take longer.\n"
"Affects: Quality and Speed."
msgstr "जब पेज फ़िलर किसी पैराग्राफ़ को खींचता है, तो शब्दों के बीच की औसत जगह इससे ज़्यादा चौड़ी नहीं होनी चाहिए। 1.0 = टेक्स्ट साइज़ जितनी चौड़ी। आम शब्द स्पेस लगभग 0.3 से 0.5 होता है।\n"
"ज़्यादा: पेज भरना आसान, लेकिन टेक्स्ट बहुत फैला हुआ दिख सकता है।\n"
"कम: टेक्स्ट कसा हुआ और बेहतर दिखता है, लेकिन पेज भरना मुश्किल होता है और ज़्यादा समय लगता है।\n"
"असर: क्वालिटी और स्पीड।"

#: lib/ptxprint/texpert.py:315
msgid "Keep paragraphs close to normal width"
msgstr "पैराग्राफ़ को आम चौड़ाई के पास रखें"

#: lib/ptxprint/texpert.py:316
msgid "The page filler prefers small changes to a paragraph over big changes. This setting controls how strong that preference is. Higher: the page filler tries small changes first, so the text looks more even.\n"
"Lower: the page filler accepts big changes more easily.\n"
"Affects: Quality."
msgstr "पेज फ़िलर पैराग्राफ़ में बड़े बदलाव की जगह छोटे बदलाव को पसंद करता है। यह सेटिंग तय करती है कि यह पसंद कितनी मज़बूत हो। ज़्यादा: पेज फ़िलर पहले छोटे बदलाव आज़माता है, इसलिए टेक्स्ट ज़्यादा एक जैसा दिखता है।\n"
"कम: पेज फ़िलर बड़े बदलाव आसानी से मान लेता है।\n"
"असर: क्वालिटी।"

#: lib/ptxprint/texpert.py:321
msgid "Penalise shrink or stretch"
msgstr "सिकोड़ने या खींचने पर पेनल्टी"

#: lib/ptxprint/texpert.py:322
msgid "Tells the page filler whether to shrink paragraphs or stretch them when both are possible.\n"
"Positive numbers: penalise stretching (so the text prefers to shrink more).\n"
"Negative numbers: penalise shrinking. (so the text prefers to stretch more).\n"
"0: no preference.\n"
"A bigger number (+ or −) means a higher penalty.\n"
"Affects: Quality."
msgstr "जब दोनों मुमकिन हों, तब पेज फ़िलर को बताता है कि पैराग्राफ़ सिकोड़ें या खींचें।\n"
"पॉज़िटिव संख्या: खींचने पर पेनल्टी (टेक्स्ट ज़्यादा सिकुड़ना पसंद करेगा)।\n"
"नेगेटिव संख्या: सिकोड़ने पर पेनल्टी (टेक्स्ट ज़्यादा खिंचना पसंद करेगा)।\n"
"0: कोई पसंद नहीं।\n"
"बड़ी संख्या (+ या −) का मतलब है ज़्यादा पेनल्टी।\n"
"असर: क्वालिटी।"

#: lib/ptxprint/texpert.py:328
msgid "Keep neighbouring paragraphs alike"
msgstr "आस-पास के पैराग्राफ़ एक जैसे रखें"

#: lib/ptxprint/texpert.py:329
msgid "The page filler compares each paragraph with the paragraph before it. It tries to avoid a very stretched paragraph next to a very shrunk one.\n"
"Higher: neighbouring paragraphs look more alike, so the page looks more even.\n"
"Lower: neighbouring paragraphs can look more different.\n"
"Affects: Quality."
msgstr "पेज फ़िलर हर पैराग्राफ़ को उससे पहले वाले पैराग्राफ़ से मिलाकर देखता है। वह कोशिश करता है कि बहुत खिंचे हुए पैराग्राफ़ के पास बहुत सिकुड़ा हुआ पैराग्राफ़ न आए।\n"
"ज़्यादा: पास-पास के पैराग्राफ़ एक जैसे दिखते हैं, इसलिए पेज ज़्यादा बराबर दिखता है।\n"
"कम: पास-पास के पैराग्राफ़ अलग-अलग दिख सकते हैं।\n"
"असर: क्वालिटी पर।"

#: lib/ptxprint/texpert.py:335
msgid "The cost of imbalance in a polyglot slice"
msgstr "पॉलीग्लॉट स्लाइस में असंतुलन की कीमत"

#: lib/ptxprint/texpert.py:336
msgid "How bad is it for a polyglot slice to not be balanced. This the multiplier of that cost\n"
"Only relevant to diglot and polyglot projects"
msgstr "पॉलीग्लॉट स्लाइस का संतुलित न होना कितना बुरा है? यह उस कीमत का गुणक है।\n"
"यह सिर्फ़ डाइग्लॉट और पॉलीग्लॉट प्रोजेक्ट के लिए है।"

#: lib/ptxprint/texpert.py:339
msgid "Use \\toc3 for Tab Text"
msgstr "टैब टेक्स्ट के लिए \\toc3 इस्तेमाल करें"

#: lib/ptxprint/texpert.py:34 lib/ptxprint/texpert.py:40
msgid "Next page"
msgstr "अगला पेज"

#: lib/ptxprint/texpert.py:34
msgid "Same page"
msgstr "उसी पेज पर"

#: lib/ptxprint/texpert.py:34
msgid "Odd page"
msgstr "दायाँ (विषम) पेज"

#: lib/ptxprint/texpert.py:340
msgid "Use \\toc3 for tab text if no \\zthumbtab"
msgstr "अगर \\zthumbtab न हो, तो टैब टेक्स्ट के लिए \\toc3 इस्तेमाल करें"

#: lib/ptxprint/texpert.py:342
msgid "Tilde is No Break Space"
msgstr "टिल्ड नो-ब्रेक स्पेस है"

#: lib/ptxprint/texpert.py:343
msgid "Treat ~ as non breaking space"
msgstr "~ को नो-ब्रेक स्पेस मानें"

#: lib/ptxprint/texpert.py:344
msgid "Remove \\ref ... \\ref* links"
msgstr "\\ref ... \\ref* लिंक हटाएँ"

#: lib/ptxprint/texpert.py:345
msgid "USFM 3.2 allows additional reference links to be inserted as part of \\xt ... \\xt* markup. This frequently appear in DBL text bundles, but are unhandled by PTXprint. Allow these to be removed from the USFM prior to typesetting."
msgstr "USFM 3.2 में \\xt ... \\xt* मार्कअप के हिस्से के तौर पर और रेफ़रेंस लिंक डाले जा सकते हैं। ये अक्सर DBL टेक्स्ट बंडल में दिखते हैं, लेकिन PTXprint इन्हें नहीं सँभालता। टाइपसेट करने से पहले इन्हें USFM से हटाने की छूट दें।"

#: lib/ptxprint/texpert.py:346
msgid "End decoration skip"
msgstr "अंत सजावट की दूरी"

#: lib/ptxprint/texpert.py:347
msgid "The gap between the end of the book and the book-end decoration"
msgstr "किताब के अंत और किताब-अंत की सजावट के बीच की जगह"

#: lib/ptxprint/texpert.py:348
msgid "Thumbtab rotated adjustment"
msgstr "थंबटैब घुमाव सुधार"

#: lib/ptxprint/texpert.py:349
msgid "Shift thumbtab text"
msgstr "थंबटैब का टेक्स्ट खिसकाएँ"

#: lib/ptxprint/texpert.py:35
msgid "Where to start a new book"
msgstr "नई किताब कहाँ से शुरू हो"

#: lib/ptxprint/texpert.py:35
msgid "Does a scripture book start on a new page, the same page as the previous book (if <65% of page has been used), or an odd page"
msgstr "पवित्र शास्त्र की किताब नए पेज से शुरू हो, पिछली किताब वाले पेज पर ही (अगर पेज का <65% हिस्सा भरा है), या दायें (विषम) पेज से"

#: lib/ptxprint/texpert.py:36
msgid "Page full factor"
msgstr "पेज भरने का अनुपात"

#: lib/ptxprint/texpert.py:37
msgid "This setting is related to how full a page needs to be to force the next book to start on a new page."
msgstr "यह सेटिंग बताती है कि अगली किताब को नए पेज से शुरू करने के लिए पिछला पेज कितना भरा होना चाहिए।"

#: lib/ptxprint/texpert.py:40
msgid "No page breaks"
msgstr "कोई पेज ब्रेक नहीं"

#: lib/ptxprint/texpert.py:40
msgid "On an odd page"
msgstr "दायें (विषम) पेज पर"

#: lib/ptxprint/texpert.py:40
msgid "Grouped"
msgstr "समूह में"

#: lib/ptxprint/texpert.py:41
msgid "Where to start a new intro page"
msgstr "नया इंट्रो पेज कहाँ से शुरू हो"

#: lib/ptxprint/texpert.py:41
msgid "Does an intro page start on a new page, the same page as the previous book, an odd page, or group all adjacent intro pages into an odd paged group"
msgstr "इंट्रो पेज नए पेज से शुरू हो, पिछली किताब वाले पेज पर ही, दायें (विषम) पेज से, या सारे पास-पास के इंट्रो पेज एक विषम पेज वाले समूह में रखे जाएँ"

#: lib/ptxprint/texpert.py:42
msgid "Unbalanced Lines (Max)"
msgstr "असंतुलित लाइनें (ज़्यादा से ज़्यादा)"

#: lib/ptxprint/texpert.py:43
msgid "Maximum number of unbalanced lines allowed in 2-column layout. Recommended range 1-5."
msgstr "2-कॉलम लेआउट में असंतुलित लाइनों की ज़्यादा से ज़्यादा गिनती। सुझाई गई सीमा 1-5 है।"

#: lib/ptxprint/texpert.py:44
msgid "Variable line spacing maximum stretch"
msgstr "बदलती लाइन स्पेसिंग का अधिकतम खिंचाव"

#: lib/ptxprint/texpert.py:45
msgid "Maximum stretch to insert between lines in variable line spacing in pts"
msgstr "बदलती लाइन स्पेसिंग में लाइनों के बीच जोड़ा जाने वाला अधिकतम खिंचाव (pt में)"

#: lib/ptxprint/texpert.py:46
msgid "Variable line spacing maximum shrink"
msgstr "बदलती लाइन स्पेसिंग का अधिकतम सिकुड़ाव"

#: lib/ptxprint/texpert.py:47
msgid "Maximum shrink to insert between lines in variable line spacing in pts"
msgstr "बदलती लाइन स्पेसिंग में लाइनों के बीच से घटाया जाने वाला अधिकतम सिकुड़ाव (pt में)"

#: lib/ptxprint/texpert.py:48
msgid "No Top Space"
msgstr "ऊपर जगह नहीं"

#: lib/ptxprint/texpert.py:49
msgid "Don’t insert space above headings at the start of a column"
