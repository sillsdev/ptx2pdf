"km = Khmer\n"
"ko = Korean\n"
"my = Myanmar\n"
"th = Thai\n"
"zh = Chinese\n"
"   OR\n"
"gr = Graphite"
msgstr ""

#: temp.glade:20928
msgid "RTL Book\n"
"Binding"
msgstr "आरटीएल पुस्तक\n"
"बाइंडिंग"

#: temp.glade:20930
msgid "Set the binding to Right (for RTL publications)"
msgstr "बाइंडिंग को दायें सेट करें (RTL प्रकाशनों के लिए)"

