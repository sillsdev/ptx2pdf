msgstr "Tikpela:"

#: temp.glade:39177
msgid "Finished page size of the book, from the Layout page settings."
msgstr "Las sais bilong pes bilong buk, i kam long ol Layout pes seting."

#: temp.glade:39179
msgid "Trim size:"
msgstr "Trim sais:"

#: temp.glade:39190
msgid "How many copies of the book to be printed."
msgstr "Hamas kopi bilong buk bai ol i printim."

