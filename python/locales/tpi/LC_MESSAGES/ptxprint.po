#: temp.glade:1629
msgid "PTXprint: Import Scripture..."
msgstr "PTXprint: Importim Skripsa..."

#: temp.glade:1702 temp.glade:1727
msgid "The Berean Standard Bible is\n"
"a Public Domain English Bible.\n"
"It is bundled with PTXprint but\n"
"needs to be installed in your\n"
"Projects folder.\n"
"\n"
"This is a good training project\n"
"and can also be used in diglots."
msgstr "Berean Standard Bible em wanpela Inglis Baibel\n"
"bilong olgeta manmeri (Public Domain).\n"
"Em i stap wantaim PTXprint tasol\n"
"yu mas instolim long Projects folder bilong yu.\n"
"\n"
"Em i gutpela projek bilong lainim wok,\n"
"na yu ken usim long diglot tu."

#: temp.glade:1711
msgid "Install Sample Text:\n"
"Berean Standard Bible"
msgstr "Instalim Sampel Tekst:\n"
"Berean Standard Bible"

#: temp.glade:1723
msgid "Install BSB"
msgstr "Instalim BSB"

#: temp.glade:1776
msgid " OR "
msgstr " O "

