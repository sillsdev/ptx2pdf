#: temp.glade:6932
msgid "Warning!\n"
"This will reset ALL the UI settings \n"
"for the CURRENT configuration to\n"
"their default values.\n"
"\n"
"Note that it will NOT reset the Style \n"
"settings stored in the .sty files.\n"
"\n"
"The reset is not saved until you next\n"
"save, print, or import with OK."
msgstr "Warning!\n"
"Dispela bai i bekim OLGETA UI seting \n"
