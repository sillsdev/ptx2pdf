msgstr "Pasin bilong pasim buk:"

#: temp.glade:39231
msgid "Currency:"
msgstr "Moni:"

#: temp.glade:39282
msgid "Black & white"
msgstr "Blak na wait"

#: temp.glade:39283
msgid "Full color"
msgstr "Olgeta kala"

