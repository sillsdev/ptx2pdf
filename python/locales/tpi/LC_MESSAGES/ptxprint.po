msgstr "Hevi long Fallback Font - makim wanpela font long Fonts+Scripts tab.\n"
"(Tainim of opsen 'Use Fallback Font' o makim wanpela gutpela font)"

#: lib/ptxprint/runjob.py:77
msgid "Cannot find the Font specified. Install it, restart PTXprint and try again\n"
"or change the font to one that is already installed. More details below."
msgstr "I no inap painim Font ol i makim.  Instolim, kirapim gen PTXprint na traim gen\n"
"o senisim font i go long wanpela i stap pinis. Ol moa toktok i stap daun."

#: lib/ptxprint/runjob.py:776
msgid "Rerunning because the {} changed"
msgstr "Mi ranim genbilong {} i senis"

#: lib/ptxprint/runjob.py:784
msgid "Rerunning because the delayed file asked us to"
msgstr "Mi ranim gen long wanem delayed file i askim mipela"

#: lib/ptxprint/runjob.py:79
msgid "Font size setting issue. Check to see if the font size in a style\n"
"in or near the reference below is incorrect (maybe it is set to 0.00)."
msgstr "Hevi long seting bilong sais bilong font. Skelim sapos sais bilong font long wanpela stail\n"
"klostu long o long reference i stap daun i no stret (ken i stap 0.00)."

#: lib/ptxprint/runjob.py:798
msgid "Maximum runs exceeded"
msgstr "Ol run i go antap long limit"

#: lib/ptxprint/runjob.py:81 lib/ptxprint/runjob.py:82
msgid "Possibly a TeX macro issue - contact support, or post a bug report"
msgstr "Ken i gat hevi long TeX macro - toktok wantaim support, o salim wanpela bug report"

#: lib/ptxprint/runjob.py:83 lib/ptxprint/runjob.py:84
msgid "Possibly a faulty installation."
msgstr "Ken i gat rong long instolesen."

#: lib/ptxprint/runjob.py:85
msgid "Unknown issue. Possibly related to Right-aligned tabbed leaders. Try turning off various settings on the Advanced Tab."
msgstr "Hevi i no klia. Ken i gat wanpela pasin long Right-aligned tabbed leaders. Traim long tainim of ol narapela seting long Advanced Tab."

#: lib/ptxprint/runjob.py:87
msgid "Oops! Something unexpected happened causing this unhandled error.\n"
"Try using the 'Tidy Up' button on the Help tab and then try again.\n"
"If you are still unable to proceed, use the 'Create Archive...' button\n"
"on the Help tab to create a .zip file. Send it to your PTXprint support person\n"
"for further assistance. Please include a description of the problem, and if\n"
"known, state which setting was changed since it last worked."
msgstr "Oops! Wanpela samting i no stret i kamap na kamapim dispela hevi mipela i no save long en.\n"
"Traim long yusim boton 'Tidy Up' long Help tab na traim gen.\n"
"Sapos yu no inap go het yet, yusim boton 'Create Archive...'\n"
"long Help tab bilong wokim wanpela .zip file. Salim i go long man bilong helpim PTXprint\n"
"bilong kisim moa halivim. Plis raitim stori bilong hevi, na sapos yu save,\n"
"raitim wanem seting yu senisim bihain long taim em i wok gut."

#: lib/ptxprint/runjob.py:904
msgid "Nothing to compare with yet: make a change and print again"
msgstr "I no gat wanpela samting long komperim wantaim yet: mekim wanpela senis na printim gen"

#: lib/ptxprint/runjob.py:905
msgid "Cannot find the PDF to compare with: {}"
msgstr "I no inap painim PDF bilong komperim wantaim: {}"

#: lib/ptxprint/runjob.py:907
msgid "No differences found"
msgstr "I no gat ol difrens"

#: lib/ptxprint/runjob.py:908
msgid "Cannot compare PDFs: Poppler or the image libraries are not available"
msgstr "I no inap kompeim ol PDF: Poppler o ol laibrari bilong piksa i no stap"

#: lib/ptxprint/runjob.py:909
msgid "Cannot compare PDFs: the pages are different sizes"
msgstr "I no inap kompeim ol PDF: ol pes i gat narapela bikpela"

#: lib/ptxprint/runjob.py:910
msgid "No differences found, but the old Diff PDF is open and cannot be removed"
msgstr "I no gat wanpela difrens, tasol olpela Diff PDF i op na i no inap rausim"

#: lib/ptxprint/runjob.py:911
msgid "No pages could be compared. Check the Start Page Offset"
msgstr "I no gat wanpela pes i inap kompeim. Lukim Start Page Offset"

#: lib/ptxprint/runjob.py:912
msgid "The PDFs could not be compared"
msgstr "I no inap kompeim ol PDF"

#: lib/ptxprint/runjob.py:945 lib/ptxprint/runjob.py:948
msgid "pages"
msgstr "ol pes"

#: lib/ptxprint/runjob.py:945 lib/ptxprint/runjob.py:948
msgid "page"
msgstr "pes"

#: lib/ptxprint/runjob.py:946
msgid "Check pages:"
msgstr "Skelim ol pes:"

#: lib/ptxprint/runjob.py:962 lib/ptxprint/runjob.py:964
