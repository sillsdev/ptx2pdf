msgstr "PTXprint [{}] - Bekim!"

#: lib/ptxprint/runjob.py:931 lib/ptxprint/runjob.py:943 lib/ptxprint/runjob.py:948
msgid "Failed to create: "
msgstr "I no inap kamapim: "

#: lib/ptxprint/runjob.py:932
msgid "Faulty PDF, could not parse"
msgstr "PDF i gat rong, i no inap ridim"

#: lib/ptxprint/runjob.py:940
msgid "To fix this error: Use a different font which is not a Variable Font."
msgstr "Bilong stretim dispela rong: Yusim narapela font i no Variable Font."

#: lib/ptxprint/runjob.py:942
msgid "Bad xdvi file, probably failed to load a picture or font"
msgstr "Xdvi fail i nogat gutpela, ating i no inap lodim wanpela piksa o font"

#: lib/ptxprint/runjob.py:955
msgid "Rerun to fix: "
msgstr "Ranim gen bilong stretim: "

#: lib/ptxprint/scriptsnippets.py:172
msgid "First verse on left"
msgstr "Namba bilong ves i go pastaim long han kais"

#: lib/ptxprint/scriptsnippets.py:302
msgid "Enabling horizontal gridding"
msgstr "Make i ken yusim horizontal grid"

#: lib/ptxprint/scriptsnippets.py:303
msgid "Align chapter numbers with grid and remove spaces before verses"
msgstr "Putim ol namba bilong kapitel long grid na rausim ol spes i stap bifor long ol ves"

#: lib/ptxprint/scriptsnippets.py:304
msgid "Automatic halfwidth punctuation pairs"
msgstr "Otomatik hafwait punctuation pairs"

#: lib/ptxprint/scriptsnippets.py:305
msgid "Adjust spacing of punctuation pairs so they take up a single full width character"
msgstr "Senisim spes bilong ol punctuation pairs bai tupela i kisim wanpela full width karakta tasol"

#: lib/ptxprint/scriptsnippets.py:92 lib/ptxprint/scriptsnippets.py:102
msgid "Syllable line breaking"
msgstr "Brukim lain long syllable"

#: lib/ptxprint/scriptsnippets.py:93
msgid "Show Hyphen"
msgstr "Soim Hyphen"

#: lib/ptxprint/texmodel.py:1099
msgid "PTXprint [{}] - USFM Check Error!"
msgstr "PTXprint [{}] - USFM Check Rong!"

#: lib/ptxprint/texmodel.py:1101
msgid "These errors were triggered when running canonical checks"
msgstr "Ol dispela rong i kamap taim ol i ranim ol canonical check"

#: lib/ptxprint/texmodel.py:1102
msgid "Checking errors: "
msgstr "Ol rong bilong skelim: "

#: lib/ptxprint/texmodel.py:1186
msgid "PTXprint [{}] - USFM Text Error!"
msgstr "PTXprint [{}] - USFM Text Rong!"

#: lib/ptxprint/texmodel.py:1189
msgid "These errors were triggered while internally parsing the USFM"
msgstr "Ol dispela rong i kamap taim ol i parsim USFM insait"

#: lib/ptxprint/texmodel.py:1189
msgid " for "
msgstr " bilong "

#: lib/ptxprint/texmodel.py:1190
msgid "Parsing errors: "
msgstr "Ol rong bilong parsim: "

#: lib/ptxprint/texmodel.py:1671
msgid "\\message{{Warning: No copyright statement found for: {} on pages {}}}"
msgstr "\\message{{Warning: No gat tok bilong raits bilong: {} long ol pes {}}}"

#: lib/ptxprint/texmodel.py:457
msgid "Missing font ({})"
msgstr "Font i lus ({})"

#: lib/ptxprint/texmodel.py:985
msgid "If this error just appeared after upgrading then check whether the USFM markers like \\p and \\v used in changes.txt rules have been 'escaped' with an additional \\ (e.g. \\\\p and \\\\v) as is required by the latest version."
msgstr "Sapos dispela hevi i kamap tasol bihain long yu apgredim, orait lukim sapos ol USFM marka olsem \\p na \\v long ol lo bilong changes.txt i gat narapela \\ moa (olsem \\\\p na \\\\v), bikos nupela versen i laikim olsem."

#: lib/ptxprint/texpert.py:100
msgid "Penalty for a bad (but not impossible) place to break"
msgstr "Penalti bilong wanpela ples i no gutpela (tasol i no inap) long brukim lain"

#: lib/ptxprint/texpert.py:101
msgid "Optional break penalty"
msgstr "Penalti bilong optional break"

#: lib/ptxprint/texpert.py:102
msgid "Penalty for the optional break"
msgstr "Penalti bilong optional break"

#: lib/ptxprint/texpert.py:103
msgid "Hyphenation threshold"
msgstr "Hyphenation threshold"

#: lib/ptxprint/texpert.py:104
msgid "Paragraph badness threshold before trying hyphenation. Set to -1 to always hyphenate"
msgstr "Threshold bilong baksait bilong paragraf pastaim long traim hyphenation. Putim -1 sapos yu laik olgeta taim i hyphenate"

#: lib/ptxprint/texpert.py:105
msgid "Penalty for inserting hyphen"
msgstr "Penalti bilong putim hyphen"

#: lib/ptxprint/texpert.py:106
msgid "Hyphenation penalty"
msgstr "Hyphenation penalti"

#: lib/ptxprint/texpert.py:107
msgid "Double hyphenation penalty"
msgstr "Dabol hyphenation penalti"

#: lib/ptxprint/texpert.py:108
msgid "Penalty for consecutive hyphenation across two lines"
msgstr "Penalti sapos hyphenation i kamap long tupela lain i stap wanwan baksait"

#: lib/ptxprint/texpert.py:110
msgid "Use loc attrib on ref to make a link"
msgstr "Usim loc attrib long ref long mekim link"

#: lib/ptxprint/texpert.py:111
msgid "The ref character style can include an attribute like loc=\"GEN 1:2\". Should this be used to make a clickable link?"
msgstr "Ref karakta stail i ken gat attrib olsem loc=\"GEN 1:2\". Yu laik usim dispela long mekim wanpela link ol i ken klikim?"

#: lib/ptxprint/texpert.py:112
msgid "Use href-link attrib on jmp to make a link"
msgstr "Usim href-link attrib long jmp long mekim link"

#: lib/ptxprint/texpert.py:113
msgid "The jmp character style can include an attribute like href-link=\"https://my.web.site/\". Should this be used to make a clickable link?"
msgstr "Jmp karakta stail i ken gat attrib olsem href-link=\"https://my.web.site/\". Yu laik usim dispela long mekim wanpela link ol i ken klikim?"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Underline only"
msgstr "Anda lain tasol"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "No line"
msgstr "I no gat lain"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Dashed line"
msgstr "Lain i bruk-bruk"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Viewer default"
msgstr "Seting bilong viewer"

#: lib/ptxprint/texpert.py:116
msgid "Box style for URL links"
msgstr "Stail bilong bokis bilong URL link"

#: lib/ptxprint/texpert.py:116
msgid "Active web links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\URLLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "Ol web link i wok long PDF i gat mak olsem bokis (solid, lain i bruk-bruk o ol dot) o anda lain. Viewer bilong yu i gat seting bilong en. Makim kala wantaim \\def\\URLLinkBorderCol{0.9 0.5 0.5} o olsem long ptxprint-mods.tex."

#: lib/ptxprint/texpert.py:119
msgid "Box style for GOTO links"
msgstr "Stail bilong bokis bilong GOTO link"

#: lib/ptxprint/texpert.py:119
msgid "Active internal links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "Ol insait link long PDF i gat mak olsem bokis (solid, lain i bruk-bruk o ol dot) o anda lain. Viewer bilong yu i gat seting bilong en. Makim kala wantaim \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} o olsem long ptxprint-mods.tex."

#: lib/ptxprint/texpert.py:120
msgid "Use glyph metrics"
msgstr "Usim glyph metrics"

#: lib/ptxprint/texpert.py:121
msgid "PTXprint can use either the actual glyph metrics in a line or the font metrics to calculate line heights and depths. Font metrics gives more consistent results."
msgstr "PTXprint i ken usim glyph metrics tru long wanpela lain o font metrics long kisim hai na dip bilong lain. Font metrics i givim ol risal i wankain moa."

#: lib/ptxprint/texpert.py:123
msgid "Use system fonts"
msgstr "Usim ol system font"

#: lib/ptxprint/texpert.py:124
msgid "Use fonts from your system as well as your project. Note that you need to restart PTXprint for this setting to take effect."
msgstr "Usim ol font bilong kompiuta bilong yu wantaim ol font bilong projek. Tingim olsem yu mas pasim PTXprint na opim gen bambai dispela seting i ken wok."

#: lib/ptxprint/texpert.py:125
msgid "Underline thickness (em)"
msgstr "Tikpela bilong underline (em)"

#: lib/ptxprint/texpert.py:126
msgid "This sets the thickness of the text underline, (measured in ems)."
msgstr "Dispela i makim tikpela bilong underline bilong tekst (ol i kaunim long em)."

#: lib/ptxprint/texpert.py:128
msgid "Underline vertical position (em)"
msgstr "Ples antap o daun bilong underline (em)"

#: lib/ptxprint/texpert.py:129
msgid "This sets how far (in ems) the underline is below the text and what it is relative to. If negative, it is the distance below the baseline. If positive (or zero), it is the distance below the bottom of any descenders."
msgstr "Dispela i makim hamas (long em) underline i stap daun long tekst, na em i stap daun long wanem samting. Sapos namba i minus, em i stap daun long baseline. Sapos namba i plas (o zero), em i stap daun long as bilong ol descender."

#: lib/ptxprint/texpert.py:131
msgid "Underline Spaces"
msgstr "Underline long ol spes"

#: lib/ptxprint/texpert.py:132
msgid "Underline spaces in underlined runs"
msgstr "Putim underline long ol spes insait long ol tekst i gat underline"

#: lib/ptxprint/texpert.py:133
msgid "Log font creation"
msgstr "Raitim log bilong ol font"

#: lib/ptxprint/texpert.py:134
msgid "Create <jobname>.fontusage in the local/ptxprint/<config>/ directory, which will list the page number and exact font definition when each new style is first used."
msgstr "Kamapim <jobname>.fontusage long folder local/ptxprint/<config>/. Em bai soim namba bilong pes na stretpela definisen bilong font taim ol i usim wanpela nupela stail long nambawan taim."

#: lib/ptxprint/texpert.py:136
msgid "Mid-Page Footnotes"
msgstr "Ol footnote long namel bilong pes"

#: lib/ptxprint/texpert.py:137
msgid "Should footnotes go before a single-double column transition"
msgstr "Ol footnote i mas go pastaim long senis bilong wanpela kolum i go long tupela kolum o?"

#: lib/ptxprint/texpert.py:138
msgid "Final Page Notes Down"
msgstr "Ol not long las pes i go daun"

#: lib/ptxprint/texpert.py:139
msgid "Push notes on the final page to the bottom of the page"
msgstr "Pusim ol not long las pes i go long as bilong pes"

#: lib/ptxprint/texpert.py:140
msgid "Reset Callers at Each Book"
msgstr "Stat gen long ol caller long olgeta buk"

#: lib/ptxprint/texpert.py:141
msgid "Re-start the footnote and cross-reference callers at the start of each book"
msgstr "Stat gen long ol caller bilong footnote na cross-reference long stat bilong olgeta buk"

#: lib/ptxprint/texpert.py:142
msgid "Endnotes at Each Book"
msgstr "Ol endnote long olgeta buk"

#: lib/ptxprint/texpert.py:143
msgid "Output endnotes at the end of each book"
msgstr "Putim ol endnote long pinis bilong olgeta buk"

#: lib/ptxprint/texpert.py:144
msgid "Enhanced paragraphed footnotes"
msgstr "Ol footnote paragraf i gutpela moa"

#: lib/ptxprint/texpert.py:145
msgid "Paragraphed footnotes which allow \\fp to work and also the ifparnotes... controls below. Causes some spacing differences compared to old-style."
msgstr "Ol footnote paragraf i larim \\fp i wok, na ol kontrol bilong ifparnotes... daun tu i wok. I mekim sampela senis long spes bilong ol lain i no olsem bipo."

#: lib/ptxprint/texpert.py:146
msgid "Remove depth above paragraphed notes"
msgstr "Rausim depth antap long ol not paragraf"

#: lib/ptxprint/texpert.py:147
msgid "Kern away (kill) the glyph/font depth of note types before paragraphed notes, using the value of \\prevdepth"
msgstr "Rausim (kill) depth bilong glyph/font bilong ol kain not i stap pastaim long ol not paragraf, long usim veliu bilong \\prevdepth"

#: lib/ptxprint/texpert.py:148
msgid "Remove depth after paragraphed notes"
msgstr "Rausim depth bihain long ol not paragraf"

#: lib/ptxprint/texpert.py:149
msgid "Kill the depth of (the last row of) paragraphed note styles. Paragraphed notes will use the margin as their baseline."
msgstr "Rausim depth bilong (las rot bilong) ol stail bilong not paragraf. Ol not paragraf bai usim margin olsem baseline bilong ol."

#: lib/ptxprint/texpert.py:150
msgid "Use grid not font/glyph height at rule"
msgstr "Usim grid, i no hait bilong font/glyph, long rule"

#: lib/ptxprint/texpert.py:151
msgid "If true, the footnote rule is positioned relative to the hypothetical baseline above the topmost footnote, rather than relative to the glyph/font height."
msgstr "Sapos i tru, rul bilong futnot i stap long ples i gat as long baselain antap long futnot i stap antap tru, i no long hait bilong glif/font."

#: lib/ptxprint/texpert.py:152
msgid "Use grid not font/glyph height between notes"
msgstr "Usim grid, i no hait bilong font/glif namel long ol nout"

#: lib/ptxprint/texpert.py:153
msgid "If true, then the \\InterNoteSpace is relative to the hypothetical baseline above the topmost footnote, rather than the glyph/font height. \\InterNoteSpace is triggered between note styles."
msgstr "Sapos i tru, orait \\InterNoteSpace i stap long as long baselain antap long futnot i stap antap tru, i no long hait bilong glif/font. \\InterNoteSpace i kamap namel long ol stail bilong nout."

#: lib/ptxprint/texpert.py:154
msgid "Use glyph height not font height in footnotes"
msgstr "Usim hait bilong glif, i no hait bilong font, long ol futnot"

#: lib/ptxprint/texpert.py:155
msgid "Does the note use the font's descender design parameter, or the actual bottom of the glyph. If the former (and depth is not killed), then the bottom of notes have a common baseline across pages. If the latter, then the glyphs sit as close to the bottom margin as they can, which may permit an extra line of text."
msgstr "Nout i usim descender design parameter bilong font, o i usim tru as daun bilong glif? Sapos i usim namba wan (na depth i no kilim), orait as daun bilong ol nout i gat wanpela baselain long olgeta pes. Sapos i usim namba tu, orait ol glif i stap klostu long margin daun olsem ol i ken, na maski i ken larim wanpela extra lain bilong tok i stap."

#: lib/ptxprint/texpert.py:156
msgid "Last Note: interlinepenalty"
msgstr "Las Nout: interlinepenalty"

#: lib/ptxprint/texpert.py:157
msgid "Penalty for breaking between lines of the last footnote."
msgstr "Penalti bilong brukim namel long ol lain bilong las futnot."

#: lib/ptxprint/texpert.py:158
msgid "Last Note: widowpenalty"
msgstr "Las Nout: widowpenalty"

#: lib/ptxprint/texpert.py:159
msgid "Extra penalty for breaking at the last line of the last footnote."
msgstr "Extra penalti bilong brukim long las lain bilong las futnot."

#: lib/ptxprint/texpert.py:160
msgid "Last Note: clubpenalty"
msgstr "Las Nout: clubpenalty"

#: lib/ptxprint/texpert.py:161
msgid "Extra penalty for breaking at the first line of the last footnote."
msgstr "Extra penalti bilong brukim long namba wan lain bilong las futnot."

#: lib/ptxprint/texpert.py:162
msgid "Last Note: penalty at par"
msgstr "Las Nout: penalti long par"

#: lib/ptxprint/texpert.py:163
msgid "Penalty for breaking at an explicit footnote-paragraph in the last footnote."
msgstr "Penalti bilong brukim long wanpela eksplisit futnot-paragraf insait long las futnot."

#: lib/ptxprint/texpert.py:164
msgid "Split notes: Shortest note to shave"
msgstr "Skelim nout: Nout i sotpela tru long shave"

#: lib/ptxprint/texpert.py:165
msgid "If footnotes might be shaved, how many lines must it be?"
msgstr "Sapos ol futnot i ken i go through long shave, hamas lain i mas stap?"

#: lib/ptxprint/texpert.py:166
msgid "Split notes: min lines to move."
msgstr "Skelim nout: liklik namba bilong lain long muvim."

#: lib/ptxprint/texpert.py:167
msgid "If a footnote is being shaved (split onto next page), what is the minimum number of lines to move?"
msgstr "Sapos wanpela futnot i go through long shave (i brukim i go long nekis pes), hamas lain i liklik tru long muvim?"

#: lib/ptxprint/texpert.py:168
msgid "Split notes: note lines to stay"
msgstr "Skelim nout: ol lain bilong nout i mas stap"

#: lib/ptxprint/texpert.py:169
msgid "If a footnote is being shaved (split onto next page), how many lines of (all) notes must remain on the page?"
msgstr "Sapos wanpela futnot i go through long shave (i brukim i go long nekis pes), hamas lain bilong (olgeta) nout i mas stap long pes?"

#: lib/ptxprint/texpert.py:170
msgid "Study note factor-Single column"
msgstr "Faktor bilong nout bilong stadi-Wanpela kolum"

#: lib/ptxprint/texpert.py:171
msgid "To avoid needless cylces/underful pages, what portion of a study note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "Bilong abrusim ol sikel i no gat yus o ol pes i no pulap, hamas hap bilong skelim hait bilong wanpela nout bilong stadi TeX i mas usim taim em i kisim input long mod bilong wanpela kolum? (100=10 pesen)"

#: lib/ptxprint/texpert.py:172
msgid "Study note factor-Two column"
msgstr "Faktor bilong nout bilong stadi-Tupela kolum"

#: lib/ptxprint/texpert.py:173
msgid "To avoid needless cylces/underful pages, what portion of a study note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "Bilong abrusim ol sikel i no gat yus o ol pes i no pulap, hamas hap bilong skelim hait bilong wanpela nout bilong stadi TeX i mas usim taim em i kisim input long mod bilong tupela kolum? (100=10 pesen)"

#: lib/ptxprint/texpert.py:174
msgid "Study note factor-Diglot"
msgstr "Faktor bilong nout bilong stadi-Daiglot"

#: lib/ptxprint/texpert.py:175
msgid "To avoid needless cylces/underful pages, what portion of a study note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "Bilong abrusim ol sikel i no gat yus o ol pes i no pulap, hamas hap bilong skelim hait bilong wanpela nout bilong stadi TeX i mas usim taim em i kisim daiglot input? (100=10 pesen)"

#: lib/ptxprint/texpert.py:176
msgid "Footnote factor-Single column"
msgstr "Fakta bilong nout daunbilo-Wanpela kolum"

#: lib/ptxprint/texpert.py:177
msgid "To avoid needless cylces/underful pages, what portion of a note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "Bilong abrusim ol saikel i no gat wok na ol pes i no pulap, hamas hap bilong hait stima bilong wanpela nout TeX i mas yusim taim em i bungim ol input long wanpela-kolum mod? (100=10percent)"

#: lib/ptxprint/texpert.py:178
msgid "Footnote factor-Two column"
msgstr "Fakta bilong nout daunbilo-Tupela kolum"

#: lib/ptxprint/texpert.py:179
msgid "To avoid needless cylces/underful pages, what portion of a note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "Bilong abrusim ol saikel i no gat wok na ol pes i no pulap, hamas hap bilong hait stima bilong wanpela nout TeX i mas yusim taim em i bungim ol input long tupela-kolum mod? (100=10percent)"

#: lib/ptxprint/texpert.py:180
msgid "Footnote factor-Diglot"
msgstr "Fakta bilong nout daunbilo-Diglot"

#: lib/ptxprint/texpert.py:181
msgid "To avoid needless cylces/underful pages, what portion of a note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "Bilong abrusim ol saikel i no gat wok na ol pes i no pulap, hamas hap bilong hait stima bilong wanpela nout TeX i mas yusim taim em i bungim ol diglot input? (100=10percent)"

#: lib/ptxprint/texpert.py:182
msgid "Footnote factor-Centre column"
msgstr "Fakta bilong nout daunbilo-Kolum namel"

#: lib/ptxprint/texpert.py:183
msgid "To avoid needless cylces/underful pages, what portion of a note's height-estimate should TeX apply when gathering centre-column notes? (100=10percent)"
msgstr "Bilong abrusim ol saikel i no gat wok na ol pes i no pulap, hamas hap bilong hait stima bilong wanpela nout TeX i mas yusim taim em i bungim ol nout bilong kolum namel? (100=10percent)"

#: lib/ptxprint/texpert.py:184
msgid "Distance of margin notes from text"
msgstr "Longpela bilong ol nout long margin long ol tok"

#: lib/ptxprint/texpert.py:185
msgid "The size of the gap between the margin notes and the text"
msgstr "Biknes bilong spes namel long ol nout long margin na ol tok"

#: lib/ptxprint/texpert.py:187
msgid "Balance diglot/polyglot notes"
msgstr "Ekwalaisim ol diglot/polyglot nout"

#: lib/ptxprint/texpert.py:188
msgid "When there's a note on column R (for example), does that reduce the space from other columns?"
msgstr "Sapos i gat wanpela nout long kolum R (olsem), em i mekim spes bilong ol narapela kolum i liklik?"

#: lib/ptxprint/texpert.py:189
msgid "Diglot/polyglot merged paragraphed notes are RTL"
msgstr "Ol diglot/polyglot nout i bung na i stap long pereg i RTL"

#: lib/ptxprint/texpert.py:190
msgid "When merged notes are not shown as individual paragraphs, the result must be arranged as though RTL or LTR (however the induvidual notes are structured). This defines the paragraph alignment."
msgstr "Taim ol nout i bung i no soim olsem ol wanwan pereg, ol i mas stap olsem RTL o LTR (olsem ol wanwan nout i stap). Dispela i makim ol pereg i stap long wanem sait."

#: lib/ptxprint/texpert.py:191
msgid "Adjust Versification of Projects"
msgstr "Senisim Versification bilong ol Projek"

#: lib/ptxprint/texpert.py:192
msgid "If versification differs between projects, adjust diglot/polyglot projects to match the primary (L) project."
msgstr "Sapos versification i narapela namel long ol projek, senisim ol diglot/polyglot projek long i stap wankain olsem namba wan projek (L)."

#: lib/ptxprint/texpert.py:193
msgid "Keep existing verse numbers (as \\vp)"
msgstr "Holim ol namba bilong ves i stap pinis (olsem \\vp)"

#: lib/ptxprint/texpert.py:194
msgid "When adjusting versification, show the original verse numbers in their new (adjusted) location."
msgstr "Taim yu senisim versification, soim ol namba bilong ves i stap pastaim long nupela ples bilong ol (i senis pinis)."

#: lib/ptxprint/texpert.py:195
msgid "Show old chapter numbers if changed (in \\vp)"
msgstr "Soim ol olpela namba bilong kapitel sapos i senis (long \\vp)"

#: lib/ptxprint/texpert.py:196
msgid "When adjusting versification, show the adjusted chapter numbers (only) if they have changed."
msgstr "Taim yu senisim versification, soim ol namba bilong kapitel i senis pinis (tasol) sapos ol i senis."

#: lib/ptxprint/texpert.py:197
msgid "Show Diglot Trace Marks"
msgstr "Soim ol Diglot Trace Mark"

#: lib/ptxprint/texpert.py:198
msgid "Insert visible trace marks in diglot output"
msgstr "Putim ol trace mark ol man i ken lukim long diglot output"

#: lib/ptxprint/texpert.py:199
msgid "Extra Trace Mark Info"
msgstr "Narapela Infomesen bilong Trace Mark"

#: lib/ptxprint/texpert.py:200
msgid "Add extra information to diglot trace marks. (debugging only - can alter layout)"
msgstr "Putim narapela infomesen long ol diglot trace mark. (bilong painim rong tasol - i ken senisim layout)"

#: lib/ptxprint/texpert.py:201
msgid "Diglot Shading Padding"
msgstr "Diglot Shading Padding"

#: lib/ptxprint/texpert.py:202
msgid "The amount of side padding (pt) on the shaded background of a diglot"
msgstr "Hamas bilong sait (pt) long kala bilong baksait bilong diglot"

#: lib/ptxprint/texpert.py:204
msgid "Borders start at body text"
msgstr "Ol border i stat long bodi tekst"

#: lib/ptxprint/texpert.py:204
msgid "Borders include book intros"
msgstr "Ol border i garim ol intro bilong buk"

#: lib/ptxprint/texpert.py:204
msgid "Wide book intros for per-column textborders"
msgstr "Ol intro bilong buk i brot long olgeta wan wan kolum textborder"

#: lib/ptxprint/texpert.py:205
msgid "How does text-border behave in diglots?"
msgstr "Textborder i wok olsem wanem long ol diglot?"

#: lib/ptxprint/texpert.py:205
msgid "Historically, diglot text-borders put the border around book introductions. This control allows that (substandard) behaviour to be chosen, and also allows  experimental code to make books with per-column textborders use full-width text for introductory text."
msgstr "Bipo, ol textborder bilong diglot i putim border raunim ol intro bilong buk. Dispela kontrol i larim yu makim dispela pasin (i no gutpela tumas), na tu i larim eksperimental kod long ol buk i gat textborder long wan wan kolum long yusim tekst i go olgeta bilong ol intro."

#: lib/ptxprint/texpert.py:206
msgid "Unprintable page recovery."
msgstr "Kamapim bek pes i no inap long printim."

#: lib/ptxprint/texpert.py:207
msgid "If notes / figures make a page unprintable: -1: immediately stop; 0: print failed contents and try to struggle on; >0 grow page height by up to N lines."
msgstr "Sapos ol nots / piksa i mekim wanpela pes i no inap long printim: -1: stop kwiktaim; 0: printim ol samting i pundaun na traim long go het; >0 bikim ténsim hait bilong pes inap long N lain."

#: lib/ptxprint/texpert.py:208
msgid "1xBiggest baseline"
msgstr "1x bikpela baseline"

#: lib/ptxprint/texpert.py:208
msgid "2xSmallest baseline"
msgstr "2x liklik baseline"

#: lib/ptxprint/texpert.py:208
msgid "2xBiggest baseline"
msgstr "2x bikpela baseline"

#: lib/ptxprint/texpert.py:208
msgid "3xSmallest baseline"
msgstr "3x liklik baseline"

#: lib/ptxprint/texpert.py:208
msgid "Page-full test."
msgstr "Pes-pulap test."

#: lib/ptxprint/texpert.py:209
msgid "When a (non-title) chunk has finished, the amount of unused space below which diglot will immediately output a page,  rather than trying to fit the next chunk. (irrespective of how short it is). Higher values encourage underfilled pages, but can prevent orphaning of the 1st line of poetry."
msgstr "Taim wanpela pis (i no taitel) i pinis, sapos hamas ples i no gat samting i stap aninit long dispela, diglot bai kwiktaim aut wanpela pes, na i no traim long putim nekis pis. (maski em i sotpela o nogat). Bikpela namba i mekim ol pes i no pulap, tasol inap stopim namba 1 lain bilong poetri long i stap wanpela tasol."

#: lib/ptxprint/texpert.py:210
msgid "Default Figures Top Left"
msgstr "Piksa i stap long antap long left olsem standa"

#: lib/ptxprint/texpert.py:211
msgid "Default figure positions to top left"
msgstr "Ol piksa i stap long antap long left olsem standa"

#: lib/ptxprint/texpert.py:212
msgid "Ref Before Caption"
msgstr "Ref i stap bipo long kepsen"

#: lib/ptxprint/texpert.py:213
msgid "Output reference before caption"
msgstr "Putim ref bipo long kepsen"

#: lib/ptxprint/texpert.py:214
msgid "Show Caption Before Image"
msgstr "Soim kepsen bipo long piksa"

#: lib/ptxprint/texpert.py:215
msgid "Output caption before image"
msgstr "Putim kepsen bipo long piksa"

#: lib/ptxprint/texpert.py:216
msgid "Space (pt) beside cutout/sidebar"
msgstr "Spes (pt) long sait bilong cutout/sidebar"

#: lib/ptxprint/texpert.py:217
msgid "This sets the default gap (pt) between the body text and the side of a figure/sidebar in a cutout."
msgstr "Dispela i makim standa gap (pt) namel long bodi tekst na sait bilong piksa/sidebar long wanpela cutout."

#: lib/ptxprint/texpert.py:218
msgid "Space between picture & caption"
msgstr "Spes namel long piksa & kepsen"

#: lib/ptxprint/texpert.py:219
msgid "Increase/Reduce the gap between figures and their captions"
msgstr "Bikim o liklikim gap namel long ol piksa na kepsen bilong ol"

#: lib/ptxprint/texpert.py:220
msgid "Default space beside picture"
msgstr "Standa spes long sait bilong piksa"

#: lib/ptxprint/texpert.py:221
msgid "Picture horizontal margin*2"
msgstr "Hap bilong ol pikja long sait*2"

#: lib/ptxprint/texpert.py:222
msgid "Show comprehensive illustration credits"
msgstr "Soim olgeta nem bilong ol man i wokim ol piksa"

#: lib/ptxprint/texpert.py:223
msgid "Instead of using the catch-all phrasing 'All other illustrations by...' show a comprehensive list of every artist and all pages that contain their illustrations."
msgstr "Bilong no yusim tok 'Ol narapela piksa i kam long...', soim wanpela lista bilong olgeta man i wokim piksa na olgeta pes we ol piksa bilong ol i stap."

#: lib/ptxprint/texpert.py:225
msgid "No PDF Bookmarks"
msgstr "No gat PDF Bukmak"

#: lib/ptxprint/texpert.py:226
msgid "Don’t output PDF bookmarks"
msgstr "No kamapim ol PDF bukmak"

#: lib/ptxprint/texpert.py:227
msgid "Allow Active Links in PDF"
msgstr "Larim ol Link i wok long PDF"

#: lib/ptxprint/texpert.py:228
msgid "Make links active inside PDF"
msgstr "Mekim ol link i wok insait long PDF"

#: lib/ptxprint/texpert.py:229
msgid "Use Book Codes in PDF Bookmarks"
msgstr "Yusim Kod bilong Buk long PDF Bukmak"

#: lib/ptxprint/texpert.py:230
msgid "Use book codes instead of book names in bookmarks"
msgstr "Yusim kod bilong buk, i no nem bilong buk, long ol bukmak"

#: lib/ptxprint/texpert.py:231
msgid "Disable Transparency in PDF"
msgstr "Pasim Transparency long PDF"

#: lib/ptxprint/texpert.py:232
msgid "Disable transparency output in PDF"
msgstr "Pasim transparency long PDF"

#: lib/ptxprint/texpert.py:233
msgid "Show adjust points"
msgstr "Soim ol adjust point"

#: lib/ptxprint/texpert.py:234
msgid "Show adjust points in the margin of the text."
msgstr "Soim ol adjust point long margin bilong tekst."

#: lib/ptxprint/texpert.py:235
msgid "Mark Trigger Points"
msgstr "Makim ol Trigger Point"

#: lib/ptxprint/texpert.py:236
msgid "Display trigger points in output"
msgstr "Soim ol trigger point long ol samting i kamap"

#: lib/ptxprint/texpert.py:237
msgid "Show USFM codes"
msgstr "Soim ol USFM kod"

#: lib/ptxprint/texpert.py:238
msgid "Show the USFM markers in the margin beside paragraphs."
msgstr "Soim ol USFM marka long margin long sait bilong ol paragraf."

#: lib/ptxprint/texpert.py:239
msgid "Show Error Bars For Overfull Lines"
msgstr "Soim Error Bar bilong ol Lain i Tumas Longpela"

#: lib/ptxprint/texpert.py:240
msgid "Enable this option to have TeX make overfull lines stand out."
msgstr "Opim dispela seting na TeX bai soim klia ol lain i tumas longpela."

#: lib/ptxprint/texpert.py:243
msgid "Spine Overlap onto Back Cover (mm)"
msgstr "Spine i Go antap long Baksait Kava (mm)"

#: lib/ptxprint/texpert.py:244
msgid "If you want the spine graphic or colour to spill over onto the back cover page, then set the amount of overlap here."
msgstr "Sapos yu laik olsem piksa o kala bilong spine i go antap long baksait kava, makim hamas i go antap long hia."

#: lib/ptxprint/texpert.py:246
msgid "Spine Overlap onto Front Cover (mm)"
msgstr "Spine i Go antap long Pes Bilong Kava (mm)"

#: lib/ptxprint/texpert.py:247
msgid "If you want the spine graphic or colour to spill over onto the front cover page, then set the amount of overlap here."
msgstr "Sapos yu laik olsem piksa o kala bilong spine i go antap long pes bilong kava, makim hamas i go antap long hia."

#: lib/ptxprint/texpert.py:249
msgid "Cover Bleed (mm)"
msgstr "Bleed bilong Kava (mm)"

#: lib/ptxprint/texpert.py:250
msgid "Bleed is the section of artwork that goes beyond where the paper is cut. This ensures that the image goes right to the edge of the cover after it has been trimmed."
msgstr "Bleed em hap bilong piksa i go ausait long ples ol i katim pepa. Dispela i mekim na piksa i go olgeta long hap bilong kava bihain long ol i katim."

#: lib/ptxprint/texpert.py:252
msgid "Hard Cover Art Bleed (mm)"
msgstr "Bleed bilong Piksa long Hat Kava (mm)"

#: lib/ptxprint/texpert.py:253
msgid "Art Bleed is specifically for hard cover binding and is the setting which enables images to go beyond the size of the cover in order to wrap around the hard cover and stuck down under the inner backing sheet."
msgstr "Art Bleed em bilong hat kava binding tasol. Dispela seting i larim ol piksa i go ausait long sais bilong kava, bai ol i raunim hat kava na pas daunbilo long insait backing sit."

#: lib/ptxprint/texpert.py:258
msgid "Auto-update Delay (seconds)"
msgstr "Taim bilong Auto-update (sekan)"

#: lib/ptxprint/texpert.py:259
msgid "Right-clicking again on the PDF within this time (3 second default) will prevent the Auto-update from running."
msgstr "Sapos yu klikim raitsait gen long PDF insait long dispela taim (3 sekan em seting i stap pastaim), Auto-update bai i no ranim."

#: lib/ptxprint/texpert.py:260
msgid "Shrink Text Step Value (%)"
msgstr "Step Value bilong Liklikim Tekst (%)"

#: lib/ptxprint/texpert.py:261
msgid "Step Value to shrink text using right-click context menu adjustment."
msgstr "Step Value bilong liklikim tekst taim yu yusim senis long raitsait-klik menu."

#: lib/ptxprint/texpert.py:262
msgid "Minimum Text Shrink (%)"
msgstr "Liklik Tekst Winim Olgeta (%)"

#: lib/ptxprint/texpert.py:263
msgid "Limit how much text can shrink to using right-click context menu adjustment."
msgstr "Makim hamas tekst i ken liklik taim yu yusim senis long raitsait-klik menu."

#: lib/ptxprint/texpert.py:264
msgid "Expand Text Step Value (%)"
msgstr "Step Value bilong Bikim Tekst (%)"

#: lib/ptxprint/texpert.py:265
msgid "Step Value to expand text using right-click context menu adjustment."
msgstr "Step Value bilong bikim tekst taim yu yusim senis long raitsait-klik menu."

#: lib/ptxprint/texpert.py:266
msgid "Maximum Text Expand (%)"
msgstr "Bikpela Tekst Winim Olgeta (%)"

#: lib/ptxprint/texpert.py:267
msgid "Limit how much text can expand to using right-click context menu adjustment."
msgstr "Makim hamas tekst i ken bikpela taim yu yusim senis long raitsait-klik menu."

#: lib/ptxprint/texpert.py:268
msgid "Bad Space minimum width (em)"
msgstr "Liklik wait bilong Nogut Spes (em)"

#: lib/ptxprint/texpert.py:269
msgid "Minimum width for a bad space. 0 says to calculate for the 20 worst spaces in the doc"
msgstr "Liklik wait bilong wanpela nogut spes. 0 i makim long kaunim 20 nogut spes long dokumen."

#: lib/ptxprint/texpert.py:270
msgid "Bad intercharacter space minimum width (em)"
msgstr "Liklik wait bilong nogut spes namel long ol leta (em)"

#: lib/ptxprint/texpert.py:271
msgid "Minimum width for a bad inter character space."
msgstr "Liklik wait bilong wanpela nogut spes namel long ol leta."

#: lib/ptxprint/texpert.py:272
msgid "Precise collisions"
msgstr "Stretpela kolisen"

#: lib/ptxprint/texpert.py:273
msgid "Only show precise collisions between glyphs rather than overlapping bounding boxes - slow"
msgstr "Soim ol stretpela kolisen namel long ol glif tasol, i no ol bokis i pas wantaim - i slo."

#: lib/ptxprint/texpert.py:274
msgid "Collision Detection Padding (pt)"
msgstr "Padding bilong Painim Kolisen (pt)"

#: lib/ptxprint/texpert.py:275
msgid "Minimum space between bounding boxes of glyphs before a collision is flagged."
msgstr "Liklik spes namel long ol bokis bilong ol glif pastaim long kolisen i kisim mak."

#: lib/ptxprint/texpert.py:276
msgid "River Detection Threshold (em)"
msgstr "Limit bilong Painim Riva (em)"

#: lib/ptxprint/texpert.py:277
msgid "The sum of all the widths in the river must be above this for the river to be detected"
msgstr "Olgeta wait bilong riva i mas winim dispela namba bambai ol i ken painim riva."

#: lib/ptxprint/texpert.py:278
msgid "River Detection minimum required maximum width (em)"
msgstr "Liklik wait i mas igat bilong bikpela hap bilong Riva (em)"

#: lib/ptxprint/texpert.py:279
msgid "Minimum width required for the widest part of the river"
msgstr "Liklik wait i mas igat long hap bilong riva i go bikpela olgeta."

#: lib/ptxprint/texpert.py:28
msgid "Maximum layout version"
msgstr "Bikpela version bilong layout"

#: lib/ptxprint/texpert.py:280
msgid "River Detection minimum width (em)"
msgstr "Smolpela wait bilong Painim Riva (em)"

#: lib/ptxprint/texpert.py:281
msgid "Minimum width of any space in a river for it to be included"
msgstr "Smolpela wait bilong wanpela spes insait long riva bilong em i ken kam insait"

#: lib/ptxprint/texpert.py:282
msgid "River Detection maximum line leading (em)"
msgstr "Bikpela hap namel long ol lain bilong Painim Riva (em)"

#: lib/ptxprint/texpert.py:283
msgid "Any lines separated by a gap greater than this will be considered not to be in the same river"
msgstr "Sapos ol lain i gat hap namel i bikpela moa long dispela, ol i no stap long wanpela riva"

#: lib/ptxprint/texpert.py:284
msgid "River Detection minimum overlap (em)"
msgstr "Smolpela overlap bilong Painim Riva (em)"

#: lib/ptxprint/texpert.py:285
msgid "Minimum overlap in ems required for two spaces above each other to be considered part of the same river"
msgstr "Smolpela overlap long em i mas gat bilong tupela spes i stap antap long narapela na i stap insait long wanpela riva"

#: lib/ptxprint/texpert.py:29
msgid "Maximum layout version to use or 0 for any. Used to maintain backward compatibility when the TeX macros have been changed in newer versions of PTXprint."
msgstr "Bikpela nambawan bilong layout versen long usim, o 0 long olgeta. Em i helpim ol olpela versen long wok gut taim ol TeX makro i senis long ol nupela versen bilong PTXprint."

#: lib/ptxprint/texpert.py:290
msgid "Time limit for the whole job (minutes)"
msgstr "Taim limit bilong olgeta wok (minit)"

#: lib/ptxprint/texpert.py:291
msgid "The page filler works on all the books together. When this time is reached, the page filler stops. A book that is not finished keeps the pages that are already filled. Usually this affects only the longest book.\n"
"Higher: more time to find a good layout for every page."
msgstr "Page filler i wok long olgeta buk wantaim. Taim dispela taim i kamap, page filler i stop. Buk i no pinis i holim ol pes i pulap pinis.\n"
"Usually dispela i save kisim longpela buk tasol.\n"
"Haiaim: moa taim long painim gutpela layout bilong olgeta pes."

#: lib/ptxprint/texpert.py:295
msgid "Earlier pages to retry"
msgstr "Ol pes bipo long traim gen"

#: lib/ptxprint/texpert.py:296
msgid "If the page filler cannot fill a page, it backtracks to the page before and tries a different layout there. This is the largest number of pages it can backtrack.\n"
"Higher: fewer failed pages, but much slower.\n"
"Lower: faster, but more pages may fail. 0 = never backtrack (fastest).\n"
"Affects: Speed."
msgstr "Sapos page filler i no inap pulapim wanpela pes, em i go bek long pes bipo na traim narapela layout long hap. Dispela em i bikpela namba bilong ol pes em i ken go bek long en.\n"
"Haiaim: sotpela pes i no pulap, tasol i slo tumas.\n"
"Loaim: i kwik, tasol moa pes i ken no pulap. 0 = nogat bektrek (i kwikpela).\n"
"I senisim: Spid."

#: lib/ptxprint/texpert.py:30
msgid "Legacy 1/14 LineSpacing"
msgstr "Olpela 1/14 LineSpacing"

#: lib/ptxprint/texpert.py:301
msgid "Paragraphs to adjust on each page"
msgstr "Ol paragraf long senisim long olgeta pes"

#: lib/ptxprint/texpert.py:302
msgid "The largest number of paragraphs on one page that the page filler may stretch or shrink. Each poetry line (\\q1, \\q2 …) counts as one paragraph. Each extra paragraph doubles the number of layouts the page filler tries.\n"
"Higher: more ways to fill each page, so fewer failed pages, but each page takes longer.\n"
"Lower: faster, but more pages may fail.\n"
"Affects: Speed."
msgstr "Bikpela namba bilong ol paragraf long wanpela pes em page filler i ken stretch o shrink. Olgeta poetri lain (\\q1, \\q2 …) i wanpela paragraf. Olgeta extra paragraf i dabolim namba bilong ol layout page filler i traim.\n"
"Haiaim: moa rot long pulapim olgeta pes, olsem na sotpela pes i no pulap, tasol olgeta pes i kisim moa taim.\n"
"Loaim: i kwik, tasol moa pes i ken no pulap.\n"
"I senisim: Spid."

#: lib/ptxprint/texpert.py:309
msgid "Widest word space allowed (× text size)"
msgstr "Bikpela spes namel long ol wod i orait (× saiz bilong tekst)"

#: lib/ptxprint/texpert.py:31
msgid "In the past, SpaceAbove and SpaceBelow were, in effect units of 1/14 of the base line spacing. This has changed so they are now in units of 1/12 of the base line spacing. Enabling this compatibility reverts the units."
msgstr "Bipo, SpaceAbove na SpaceBelow i olsem ol yunit bilong 1/14 bilong base line spacing. Dispela i senis na nau ol i yunit bilong 1/12 bilong base line spacing. Sapos yu opim dispela, ol yunit i go bek long olpela."

#: lib/ptxprint/texpert.py:310
msgid "When the page filler stretches a paragraph, the average space between words must not be wider than this. 1.0 = as wide as the text size. A normal word space is about 0.3 to 0.5.\n"
"Higher: easier to fill pages, but the text can look too spread out.\n"
"Lower: tighter, better-looking text, but pages are harder to fill and take longer.\n"
"Affects: Quality and Speed."
msgstr "Taim page filler i stretchim wanpela paragraf, namba spes namel long ol wod i no ken bikpela moa long dispela. 1.0 = i bikpela olsem saiz bilong tekst. Spes namel long ol wod i stret em i klostu long 0.3 i go 0.5.\n"
"Haiaim: isi long pulapim ol pes, tasol tekst i ken lukim olsem i spred tumas.\n"
"Loaim: tekst i pas gut na i luk gutpela, tasol i hat long pulapim ol pes na i kisim moa taim.\n"
"I senisim: Kwaliti na Spid."

#: lib/ptxprint/texpert.py:315
msgid "Keep paragraphs close to normal width"
msgstr "Holim ol paragraf klostu long stret wait"

#: lib/ptxprint/texpert.py:316
msgid "The page filler prefers small changes to a paragraph over big changes. This setting controls how strong that preference is. Higher: the page filler tries small changes first, so the text looks more even.\n"
"Lower: the page filler accepts big changes more easily.\n"
"Affects: Quality."
msgstr "Page filler i laikim ol smolpela senis long wanpela paragraf winim ol bikpela senis. Dispela seting i makim strong bilong dispela laik. Haiaim: page filler i traim ol smolpela senis pastaim, olsem na tekst i luk moa gutpela.\n"
"Loaim: page filler i orait moa long ol bikpela senis.\n"
"I senisim: Kwaliti."

#: lib/ptxprint/texpert.py:321
msgid "Penalise shrink or stretch"
msgstr "Penalaisim shrink o stretch"

#: lib/ptxprint/texpert.py:322
msgid "Tells the page filler whether to shrink paragraphs or stretch them when both are possible.\n"
"Positive numbers: penalise stretching (so the text prefers to shrink more).\n"
"Negative numbers: penalise shrinking. (so the text prefers to stretch more).\n"
"0: no preference.\n"
"A bigger number (+ or −) means a higher penalty.\n"
"Affects: Quality."
msgstr "Tokim page filler long shrinkim ol paragraf o stretchim ol taim tupela i ken.\n"
"Ol positiv namba: penalaisim stretch (olsem na tekst i laik shrink moa).\n"
"Ol negativ namba: penalaisim shrink. (olsem na tekst i laik stretch moa).\n"
"0: nogat laik.\n"
"Bikpela namba (+ o −) i min bikpela penalti.\n"
"I senisim: Kwaliti."

#: lib/ptxprint/texpert.py:328
msgid "Keep neighbouring paragraphs alike"
msgstr "Holim ol paragraf i stap klostu i wankain"

#: lib/ptxprint/texpert.py:329
msgid "The page filler compares each paragraph with the paragraph before it. It tries to avoid a very stretched paragraph next to a very shrunk one.\n"
"Higher: neighbouring paragraphs look more alike, so the page looks more even.\n"
"Lower: neighbouring paragraphs can look more different.\n"
"Affects: Quality."
msgstr "Page filler i skelim wanpela wanpela paragraf wantaim paragraf i stap bipo long en. Em i traim long abrusim wanpela paragraf i stretch tumas i stap klostu long wanpela i shrink tumas.\n"
"Haiaim: ol paragraf i stap klostu i luk moa wankain, olsem na pes i luk moa gutpela.\n"
"Loaim: ol paragraf i stap klostu i ken luk narapela narapela.\n"
"I senisim: Kwaliti."

#: lib/ptxprint/texpert.py:336
msgid "Use \\toc3 for Tab Text"
msgstr "Usim \\toc3 long Tab Tekst"

#: lib/ptxprint/texpert.py:337
msgid "Use \\toc3 for tab text if no \\zthumbtab"
msgstr "Usim \\toc3 long tab tekst sapos nogat \\zthumbtab"

#: lib/ptxprint/texpert.py:339
msgid "Tilde is No Break Space"
msgstr "Tilde em i No Break Space"

#: lib/ptxprint/texpert.py:34 lib/ptxprint/texpert.py:40
msgid "Next page"
msgstr "Nekis pes"

#: lib/ptxprint/texpert.py:34
msgid "Same page"
msgstr "Sem pes"

#: lib/ptxprint/texpert.py:34
msgid "Odd page"
msgstr "Odd pes"

#: lib/ptxprint/texpert.py:340
msgid "Treat ~ as non breaking space"
msgstr "Skelim ~ olsem no break space"

#: lib/ptxprint/texpert.py:341
msgid "Remove \\ref ... \\ref* links"
msgstr "Rausim ol \\ref ... \\ref* link"

#: lib/ptxprint/texpert.py:342
msgid "USFM 3.2 allows additional reference links to be inserted as part of \\xt ... \\xt* markup. This frequently appear in DBL text bundles, but are unhandled by PTXprint. Allow these to be removed from the USFM prior to typesetting."
msgstr "USFM 3.2 i larim ol extra reference link i go insait olsem hap bilong \\xt ... \\xt* markup. Ol dispela i save kamap long ol DBL text bundle, tasol PTXprint i no save wokim. Larim ol i ken rausim ol dispela long USFM bipo long taipsetim."

#: lib/ptxprint/texpert.py:343
msgid "End decoration skip"
msgstr "End decoration skip"

#: lib/ptxprint/texpert.py:344
msgid "The gap between the end of the book and the book-end decoration"
msgstr "Spes namel long pinis bilong buk na decoration long pinis bilong buk"

#: lib/ptxprint/texpert.py:345
msgid "Thumbtab rotated adjustment"
msgstr "Thumbtab rotated adjustment"

#: lib/ptxprint/texpert.py:346
msgid "Shift thumbtab text"
msgstr "Muvim tekst bilong thumbtab"

#: lib/ptxprint/texpert.py:35
msgid "Where to start a new book"
msgstr "We long stat long nupela buk"

#: lib/ptxprint/texpert.py:35
