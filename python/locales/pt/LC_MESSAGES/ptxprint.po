msgstr "Lista de verificação de imagem: O que está acontecendo está claro neste contexto"

#: temp.glade:29600
msgid "Picture checklist: What is happening is NOT clear in this context"
msgstr "Lista de verificação de imagem: O que está acontecendo NÃO está claro neste contexto"

#: temp.glade:29617 temp.glade:29703
msgid "Unchecked"
msgstr "Não verificado"

#: temp.glade:29618
msgid "Picture checklist: Not checked for clarity in this context"
msgstr "Lista de verificação de imagem: Não verificado quanto à clareza neste contexto"

#: temp.glade:29636
msgid "Picture checklist: Carries wrong meaning in this context"
msgstr "Lista de verificação de imagem: Carrega significado errado neste contexto"

#: temp.glade:29654
msgid "Picture checklist: Carries expected meaning in this context"
msgstr "Lista de verificação de imagem: Carrega o significado esperado neste contexto"

#: temp.glade:29671
msgid "Picture checklist: Appropriateness of illustration"
msgstr "Lista de verificação de imagem: Adequação da ilustração"

#: temp.glade:29675
msgid "Select the appropriateness of the\n"
