msgstr "Data"

#: temp.glade:29759
msgid "Picture checklist: Approved by initials"
msgstr "Lista de verificação de imagem: Aprovado por iniciais"

#: temp.glade:29766
msgid "Initials"
msgstr "Iniciais"

#: temp.glade:29780
msgid "any publication"
msgstr "qualquer publicação"

#: temp.glade:29781
msgid "Picture checklist: Approved for use in ANY publication"
msgstr "Lista de verificação de imagem: Aprovado para uso em QUALQUER publicação"

#: temp.glade:29797
msgid "this publication"
msgstr "esta publicação"

#: temp.glade:29798
msgid "Picture checklist: Approved for use in THIS publication"
msgstr "Lista de verificação de imagem: Aprovado para uso nesta publicação"

#: temp.glade:29814
msgid "Approved to\n"
"be used in:"
msgstr "Aprovado para\n"
"uso em:"

#: temp.glade:29816
