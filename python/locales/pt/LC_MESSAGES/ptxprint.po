msgstr "Selecione a adequação da\n"
"ilustração dentro desta publicação."

#: temp.glade:29704
msgid "Picture checklist: Not checked if wrong meaning in this context"
msgstr "Lista de verificação de imagem: Não verificado se significado errado neste contexto"

#: temp.glade:29726
msgid "Consultant Approval:"
msgstr "Aprovação do Consultor:"

#: temp.glade:29740
msgid "Picture checklist: Approved by date"
msgstr "Lista de verificação de imagem: Aprovado por data"

#: temp.glade:29743
msgid "The most recent date that the\n"
"consultant approval updated."
msgstr "A data mais recente em que a\n"
"aprovação do consultor foi atualizada."

#: temp.glade:29749
