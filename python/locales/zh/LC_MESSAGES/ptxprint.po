msgstr "双语（或多语）"

#: temp.glade:30969
msgid "Enable diglot or discript publication"
msgstr "启用双语书或双文发布"

#: temp.glade:30973
msgid "A Diglot publication contains two\n"
"languages, or scripts, or texts.\n\n"
"A Polyglot contains more than two.\n"
"Right-click in the table below to\n"
"add other texts to the list.\n\n"
"Tip: use Save As first. Unticking this\n"
"later does not simply switch back; it\n"
"offers to save a single-text copy of\n"
"the configuration under a new name."
