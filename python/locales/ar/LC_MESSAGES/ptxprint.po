#: lib/ptxprint/gtkview.py:845
msgid "Cancel"
msgstr "إلغاء"

#: temp.glade:11497
msgid "Top: Above everything except the header line\n"
"Bottom: Below all verse text (and footnotes in diglot)\n"
"Before Verse: 'Here' where defined or before its Anchor Ref\n"
"After Paragraph: After this paragraph\n"
"Cutout: A notch/corner cut out of the text, starting at current line\n"
"\n"
"The above options may have other positioning parameters such\n"
"as: Left, Right, Center, no. of lines (up or down)."
msgstr "أعلى: فوق كل شيء ما عدا سطر الترويسة\n"
"أسفل: تحت كل نص الآيات (وتحت الحواشي السفلية في الدايغلوت)\n"
"قبل الآية: \"هنا\" حيث يُحدد أو قبل مرجع الارتكاز الخاص به\n"
"بعد الفقرة: بعد هذه الفقرة\n"
"قَطع: فجوة أو زاوية مقتطعة من النص، تبدأ من السطر الحالي\n"
"\n"
"قد تتضمن الخيارات أعلاه معاملات موضع أخرى مثل:\n"
"يسار، يمين، وسط، عدد الأسطر (للأعلى أو للأسفل)."

#: temp.glade:11519
msgid "The frame size determines how large the sidebar\n"
"will appear on the page.\n"
"\n"
"Span Width only allows a Top or Bottom vertical placement.\n"
"Column Width allows several other more precise placement \n"
"options: Before Verse, After Paragraph, or Cutout; and these\n"
"can have Left/Inner or Right/Outer Horizontal positioning set. \n"
" \n"
"When using single column layout, there is no\n"
"difference between Column Width and Span Width."
msgstr "يحدد حجم الإطار مدى كبر الشريط الجانبي\n"
"على الصفحة.\n"
"\n"
"يسمح عرض الامتداد بالموضع العمودي أعلى أو أسفل فقط.\n"
"يتيح عرض العمود خيارات تموضع أخرى أكثر دقة:\n"
"قبل الآية، أو بعد الفقرة، أو قص؛ ويمكن ضبط التموضع الأفقي\n"
"لها على يسار/داخل أو يمين/خارج. \n"
" \n"
"عند استخدام تخطيط العمود الواحد، لا يوجد\n"
"فرق بين عرض العمود وعرض الامتداد."

#: temp.glade:11530 temp.glade:28929
msgid "Frame Size:"
msgstr "حجم الإطار:"

#: temp.glade:11542 temp.glade:11679 temp.glade:29078 temp.glade:29099
msgid "The options available here change based\n"
"on the Frame Size and Vertical Position\n"
"settings. So if you can't find an option \n"
"you are looking for, then check those\n"
"settings first."
msgstr "تتغير الخيارات المتاحة هنا بحسب إعدادات\n"
"حجم الإطار والموضع العمودي. فإذا لم تجد الخيار\n"
"الذي تبحث عنه، فتحقق من تلك الإعدادات أولاً."

#: temp.glade:11562 temp.glade:11712
msgid "Some vertical position options allow a sidebar\n"
"to be moved up or down by a number of lines\n"
"or paragraphs.\n"
"\n"
"-Negative (minus) values specify to move UP.\n"
"+Positive (plus) values specify to move DOWN.\n"
"\n"
"Negative counts for cutouts raise the sidebar,\n"
"but the cutout will not affect earlier paragraphs. \n"
"Note that negative and fractional paragraph \n"
"counts are invalid."
msgstr "تتيح بعض خيارات الموضع العمودي نقل الشريط الجانبي\n"
"إلى أعلى أو أسفل بعدد من الأسطر\n"
"أو الفقرات.\n"
"\n"
"-القيم السالبة (ناقص) تعني النقل إلى الأعلى.\n"
"+القيم الموجبة (زائد) تعني النقل إلى الأسفل.\n"
"\n"
"تؤدي القيم السالبة للقصاصات إلى رفع الشريط الجانبي،\n"
"لكن القصاصة لن تؤثر في الفقرات السابقة.\n"
"لاحظ أن عدد الفقرات السالب أو الكسري\n"
"غير صالح."

#: temp.glade:11574 temp.glade:29209
msgid "Number of\n"
"Lines:"
msgstr "عدد\n"
"الأسطر:"

#: temp.glade:11591
msgid "The frame size determines the boundaries of where the\n"
"sidebar will appear on the page.\n"
"\n"
"Span Width only allows a Top or Bottom vertical placement.\n"
"\n"
"Column Width allows several other more precise placement \n"
"options: Before Verse, After Paragraph, or Cutout; and these\n"
"can have Left/Inner or Right/Outer Horizontal positioning set. \n"
" \n"
"Page (in Margins) is intended for sidebars that will cover an\n"
"entire page (i.e. preventing any scripture text from being on\n"
"that page), but will still show the header.\n"
"\n"
"Page (to Edge) is intended for sidebars to fill the entire page,\n"
"with no margins at all.\n"
"\n"
"When using single column layout, there is no\n"
"difference between Column Width and Span Width."
msgstr "يحدد حجم الإطار حدود المكان الذي سيظهر فيه\n"
"الشريط الجانبي على الصفحة.\n"
"\n"
"عرض الامتداد يسمح فقط بالموضع الرأسي أعلى الصفحة أو أسفلها.\n"
"\n"
"عرض العمود يتيح خيارات أخرى أكثر دقة للموضع:\n"
"قبل الآية، أو بعد الفقرة، أو منطقة مقتطعة؛ ويمكن\n"
"ضبط الموضع الأفقي على اليسار/الداخل أو اليمين/الخارج. \n"
" \n"
"صفحة (داخل الهوامش) مخصصة للأشرطة الجانبية التي تغطي\n"
"صفحة كاملة (أي تمنع ظهور أي نص من الكتاب المقدس في\n"
"تلك الصفحة)، لكن الترويسة تبقى ظاهرة.\n"
"\n"
"صفحة (حتى الحافة) مخصصة للأشرطة الجانبية التي تملأ الصفحة\n"
"بالكامل، دون أي هوامش.\n"
"\n"
"عند استخدام تخطيط العمود الواحد، لا يوجد\n"
"فرق بين عرض العمود وعرض الامتداد."

#: temp.glade:11639
msgid "Top: Above everything except the header line\n"
"Bottom: Below all verse text (and footnotes in diglot)\n"
"Before Verse: 'Here' where defined or before its Anchor Ref\n"
"After Paragraph: After this paragraph\n"
"Cutout: A notch/corner cut out of the text, starting at current line\n"
"Below Notes: Below the footnotes (Span Width only)\n"
"Fill: Stretch to fill the page (page sizes only)\n"
"\n"
"The above options may have other positioning parameters such\n"
"as: Left, Right, Center, no. of lines (up or down)."
msgstr "أعلى: فوق كل شيء ما عدا سطر الترويسة\n"
"أسفل: تحت كل نص الآيات (والحواشي في الثنائي اللغة)\n"
"قبل الآية: «هنا» حيث يُحدد أو قبل مرجع الارتساء\n"
"بعد الفقرة: بعد هذه الفقرة\n"
"قطع: فجوة/زاوية مقتطعة من النص، تبدأ من السطر الحالي\n"
"تحت الحواشي: تحت الحواشي (عرض الامتداد فقط)\n"
"ملء: يمتد لملء الصفحة (لأحجام الصفحات فقط)\n"
"\n"
"قد تحتوي الخيارات أعلاه على معاملات موضع أخرى\n"
"مثل: يسار، يمين، وسط، عدد الأسطر (للأعلى أو للأسفل)."

