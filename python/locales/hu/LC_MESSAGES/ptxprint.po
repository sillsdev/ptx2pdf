msgstr "A könyv vége és a könyv végi díszítés közötti rés"

#: lib/ptxprint/texpert.py:345
msgid "Thumbtab rotated adjustment"
msgstr "Elforgatott hüvelykujjas beállítás"

#: lib/ptxprint/texpert.py:346
msgid "Shift thumbtab text"
msgstr "A hüvelykujjtabló szövegének eltolása"

