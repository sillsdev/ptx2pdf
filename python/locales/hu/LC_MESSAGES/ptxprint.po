#: lib/ptxprint/texpert.py:28
msgid "Maximum layout version"
msgstr "Maximális elrendezési változat"

#: lib/ptxprint/texpert.py:29
msgid "Maximum layout version to use or 0 for any. Used to maintain backward compatibility when the TeX macros have been changed in newer versions of PTXprint."
msgstr "A maximálisan használható elrendezési verzió, vagy 0 bármelyik esetén. A visszafelé kompatibilitás fenntartására szolgál, ha a TeX makrók a PTXprint újabb verzióiban megváltoztak."

#: lib/ptxprint/texpert.py:30
msgid "Legacy 1/14 LineSpacing"
msgstr "Örökség 1/14 Vonaltávolság"

#: lib/ptxprint/texpert.py:31
msgid "In the past, SpaceAbove and SpaceBelow were, in effect units of 1/14 of the base line spacing. This has changed so they are now in units of 1/12 of the base line spacing. Enabling this compatibility reverts the units."
msgstr "Korábban a SpaceAbove és SpaceBelow az alapvonal távolságának 1/14-ed része volt. Ez megváltozott, így most már az alapvonal távolságának 1/12-es egységében vannak. A kompatibilitás engedélyezése visszaállítja az egységeket."

#: lib/ptxprint/texpert.py:34 lib/ptxprint/texpert.py:40
msgid "Next page"
msgstr "Következő oldal"

#: lib/ptxprint/texpert.py:34
msgid "Same page"
msgstr "Ugyanaz az oldal"

#: lib/ptxprint/texpert.py:34
msgid "Odd page"
msgstr "Páratlan oldal"

#: lib/ptxprint/texpert.py:35
msgid "Where to start a new book"
msgstr "Hol kezdjünk egy új könyvet"

#: lib/ptxprint/texpert.py:35
#, python-format
msgid "Does a scripture book start on a new page, the same page as the previous book (if <65% of page has been used), or an odd page"
msgstr "Egy szentíráskönyv új oldalon kezdődik, ugyanazon az oldalon, mint az előző könyv (ha az oldal <65%-át használták fel), vagy egy páratlan oldalon."

#: lib/ptxprint/texpert.py:36
msgid "Page full factor"
msgstr "Oldal teljes tényező"

#: lib/ptxprint/texpert.py:37
msgid "This setting is related to how full a page needs to be to force the next book to start on a new page."
msgstr "Ez a beállítás azzal kapcsolatos, hogy mennyire kell tele lennie egy oldalnak ahhoz, hogy a következő könyv új oldalról induljon."

#: lib/ptxprint/texpert.py:40
msgid "No page breaks"
msgstr "Nincs oldaltörés"

#: lib/ptxprint/texpert.py:40
msgid "On an odd page"
msgstr "Egy furcsa oldalon"

#: lib/ptxprint/texpert.py:40
msgid "Grouped"
msgstr "Csoportosított"

#: lib/ptxprint/texpert.py:41
msgid "Where to start a new intro page"
msgstr "Hol kezdjünk egy új bemutatkozó oldalt"

#: lib/ptxprint/texpert.py:41
msgid "Does an intro page start on a new page, the same page as the previous book, an odd page, or group all adjacent intro pages into an odd paged group"
msgstr "A bevezető oldal egy új oldalon kezdődik, ugyanazon az oldalon, mint az előző könyvben, egy páratlan oldalon, vagy az összes szomszédos bevezető oldalt egy páratlan oldalcsoportba csoportosítja?"

#: lib/ptxprint/texpert.py:42
msgid "Unbalanced Lines (Max)"
msgstr "Kiegyenlítetlen vonalak (Max)"

#: lib/ptxprint/texpert.py:43
msgid "Maximum number of unbalanced lines allowed in 2-column layout. Recommended range 1-5."
msgstr "A 2 oszlopos elrendezésben megengedett maximális számú kiegyensúlyozatlan sorok száma. Ajánlott tartomány 1-5."

#: lib/ptxprint/texpert.py:44
msgid "Variable line spacing maximum stretch"
msgstr ""

#: lib/ptxprint/texpert.py:45
msgid "Maximum stretch to insert between lines in variable line spacing in pts"
msgstr ""

#: lib/ptxprint/texpert.py:46
msgid "Variable line spacing maximum shrink"
msgstr ""

#: lib/ptxprint/texpert.py:47
msgid "Maximum shrink to insert between lines in variable line spacing in pts"
msgstr ""

#: lib/ptxprint/texpert.py:48
msgid "No Top Space"
msgstr "Nincs felső hely"

#: lib/ptxprint/texpert.py:49
msgid "Don’t insert space above headings at the start of a column"
msgstr "Ne illesszen be szóközt a címsorok fölé az oszlopok elején"

#: lib/ptxprint/texpert.py:50
msgid "Suppress pagebreak after bookend-final"
msgstr "Oldaltörés elnyomása bookend-final után"

#: lib/ptxprint/texpert.py:51
msgid "Revert to old behaviour of not ensuring that the whole of the last book is output before back-matter PDFs"
msgstr "Visszatérés a régi viselkedéshez, amely nem biztosítja, hogy az utolsó könyv egésze kikerüljön a back-matter PDF-ek előtt."

#: lib/ptxprint/texpert.py:52
msgid "Noteline offset (mm)"
msgstr "Névvonal-eltolódás (mm)"

#: lib/ptxprint/texpert.py:53
msgid "Gap (mm) between noteline and text"
msgstr "A noteszvonal és a szöveg közötti hézag (mm)"

#: lib/ptxprint/texpert.py:54
msgid "Noteline margin (mm)"
msgstr "Noteline margó (mm)"

#: lib/ptxprint/texpert.py:55
msgid "Gap (mm) between noteline and edge of page"
msgstr "A noteszvonal és az oldal széle közötti távolság (mm)"

