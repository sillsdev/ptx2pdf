msgstr ""

#: lib/ptxprint/texpert.py:45
msgid "Maximum stretch to insert between lines in variable line spacing in pts"
msgstr ""

#: lib/ptxprint/texpert.py:46
msgid "Variable line spacing maximum shrink"
msgstr ""

#: lib/ptxprint/texpert.py:47
msgid "Maximum shrink to insert between lines in variable line spacing in pts"
msgstr ""

#: lib/ptxprint/texpert.py:48
msgid "No Top Space"
msgstr "Nincs felső hely"

#: lib/ptxprint/texpert.py:49
msgid "Don’t insert space above headings at the start of a column"
msgstr "Ne illesszen be szóközt a címsorok fölé az oszlopok elején"

#: lib/ptxprint/texpert.py:50
msgid "Suppress pagebreak after bookend-final"
msgstr "Oldaltörés elnyomása bookend-final után"

#: lib/ptxprint/texpert.py:51
msgid "Revert to old behaviour of not ensuring that the whole of the last book is output before back-matter PDFs"
msgstr "Visszatérés a régi viselkedéshez, amely nem biztosítja, hogy az utolsó könyv egésze kikerüljön a back-matter PDF-ek előtt."

#: lib/ptxprint/texpert.py:52
msgid "Noteline offset (mm)"
msgstr "Névvonal-eltolódás (mm)"

#: lib/ptxprint/texpert.py:53
msgid "Gap (mm) between noteline and text"
msgstr "A noteszvonal és a szöveg közötti hézag (mm)"

#: lib/ptxprint/texpert.py:54
msgid "Noteline margin (mm)"
msgstr "Noteline margó (mm)"

#: lib/ptxprint/texpert.py:55
msgid "Gap (mm) between noteline and edge of page"
msgstr "A noteszvonal és az oldal széle közötti távolság (mm)"

