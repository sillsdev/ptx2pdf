msgstr "အခန်းငယ် အလှဆင်ရုပ်ပုံ၏ အရွယ်အစားကို ချိန်ညှိပါ။ 1.0 = မူလအရွယ်၊\n"
"0.5 = တစ်ဝက်၊ 2.0 = နှစ်ဆ။"

#: temp.glade:32480
msgid "Move Ayah"
msgstr "Ayah ကို ရွှေ့ရန်"

#: temp.glade:32485
msgid "This option moves the Ayah\n"
