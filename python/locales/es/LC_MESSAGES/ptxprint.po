msgid "These errors were triggered when running canonical checks"
msgstr "Estos errores se produjeron al ejecutar las comprobaciones canónicas"

#: lib/ptxprint/texmodel.py:1139
msgid "Checking errors: "
msgstr "Comprobación de errores: "

#: lib/ptxprint/texmodel.py:1223
msgid "PTXprint [{}] - USFM Text Error!"
msgstr "PTXprint [{}] - ¡Error de texto USFM!"

#: lib/ptxprint/texmodel.py:1226
msgid "These errors were triggered while internally parsing the USFM"
msgstr "Estos errores se produjeron al analizar internamente el USFM"

#: lib/ptxprint/texmodel.py:1226
msgid " for "
msgstr " para "

#: lib/ptxprint/texmodel.py:1227
msgid "Parsing errors: "
msgstr "Errores de análisis sintáctico: "

#: lib/ptxprint/texmodel.py:1705
msgid "\\message{{Warning: No copyright statement found for: {} on pages {}}}"
msgstr "\\message{{Advertencia: No se ha encontrado ninguna declaración de derechos de autor para: {} en las páginas {}}}"

#: lib/ptxprint/texmodel.py:481
msgid "Missing font ({})"
msgstr "Falta la fuente ({})"

#: lib/ptxprint/texpert.py:100
msgid "Penalty for a bad (but not impossible) place to break"
msgstr "Penalidad por un mal (pero no imposible) lugar para romper"

#: lib/ptxprint/texpert.py:101
msgid "Optional break penalty"
msgstr "Pena de pausa opcional"

#: lib/ptxprint/texpert.py:102
msgid "Penalty for the optional break"
msgstr "Sanción por la interrupción facultativa"

#: lib/ptxprint/texpert.py:103
msgid "Hyphenation threshold"
msgstr "Límite de caracteres de separación silábica"

#: lib/ptxprint/texpert.py:104
msgid "Paragraph badness threshold before trying hyphenation. Set to -1 to always hyphenate"
msgstr "Límite de maldad del párrafo antes de intentar la separación silábica. Establecer en -1 para separar siempre con guión"

#: lib/ptxprint/texpert.py:105
msgid "Penalty for inserting hyphen"
msgstr "Penalidad por insertar guión"

#: lib/ptxprint/texpert.py:106
msgid "Hyphenation penalty"
msgstr "Penalización por división de palabras"

#: lib/ptxprint/texpert.py:107
msgid "Double hyphenation penalty"
msgstr "Penalización por doble guión"

#: lib/ptxprint/texpert.py:108
msgid "Penalty for consecutive hyphenation across two lines"
msgstr "Penalización por separación de palabra consecutiva en dos líneas"

#: lib/ptxprint/texpert.py:110
msgid "Use loc attrib on ref to make a link"
msgstr "Utilice el atributo loc en ref para hacer un enlace"

#: lib/ptxprint/texpert.py:111
msgid "The ref character style can include an attribute like loc=\"GEN 1:2\". Should this be used to make a clickable link?"
msgstr "El estilo de carácter ref puede incluir un atributo como loc=\"GEN 1:2\". ¿Debe utilizarse para crear un enlace en el que se pueda hacer clic?"

#: lib/ptxprint/texpert.py:112
msgid "Use href-link attrib on jmp to make a link"
msgstr "Utilice href-link attrib en jmp para hacer un enlace"

#: lib/ptxprint/texpert.py:113
msgid "The jmp character style can include an attribute like href-link=\"https://my.web.site/\". Should this be used to make a clickable link?"
msgstr "El estilo de carácter jmp puede incluir un atributo como href-link=\"https://my.web.site/\". ¿Debe utilizarse para crear un enlace en el que se pueda hacer clic?"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Underline only"
msgstr "Sólo subrayado"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "No line"
msgstr "Ninguna línea"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Dashed line"
msgstr "Línea discontinua"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Viewer default"
msgstr "Visor predeterminado"

#: lib/ptxprint/texpert.py:116
msgid "Box style for URL links"
msgstr "Estilo de caja para enlaces URL"

#: lib/ptxprint/texpert.py:116
msgid "Active web links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\URLLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "Los enlaces web activos en los PDF se marcan con un recuadro (línea continua, discontinua o punteada) o un subrayado. Es probable que tu visor tenga una configuración por defecto. Establece el color con \\def\\URLLinkBorderCol{0.9 0.5 0.5} o similar en ptxprint-mods.tex."

#: lib/ptxprint/texpert.py:119
msgid "Box style for GOTO links"
msgstr "Estilo de cuadro para enlaces IR A"

#: lib/ptxprint/texpert.py:119
msgid "Active internal links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "Los enlaces internos activos en los PDF se marcan con un recuadro (línea continua, discontinua o punteada) o un subrayado. Es probable que su visor tenga una configuración por defecto. Establece el color con \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} o similar en ptxprint-mods.tex."

#: lib/ptxprint/texpert.py:120
msgid "Use glyph metrics"
msgstr "Usar métricas de glifos"

#: lib/ptxprint/texpert.py:121
msgid "PTXprint can use either the actual glyph metrics in a line or the font metrics to calculate line heights and depths. Font metrics gives more consistent results."
msgstr "PTXprint puede utilizar la métrica real de los glifos en una línea o la métrica de la fuente para calcular las alturas y profundidades de las líneas.\n"
"La métrica de la fuente da resultados más consistentes."

#: lib/ptxprint/texpert.py:123
msgid "Use system fonts"
msgstr "Usar fuentes del sistema"

#: lib/ptxprint/texpert.py:124
msgid "Use fonts from your system as well as your project. Note that you need to restart PTXprint for this setting to take effect."
msgstr "Utilice fuentes de su sistema así como de su proyecto. Tenga en cuenta que debe reiniciar PTXprint para que este ajuste surta efecto."

#: lib/ptxprint/texpert.py:125
msgid "Underline thickness (em)"
msgstr "Grosor del subrayado (em)"

#: lib/ptxprint/texpert.py:126
msgid "This sets the thickness of the text underline, (measured in ems)."
msgstr "Establece el grosor del subrayado del texto, (medido en ems)."

#: lib/ptxprint/texpert.py:128
msgid "Underline vertical position (em)"
msgstr "Posición vertical del subrayado (em)"

#: lib/ptxprint/texpert.py:129
msgid "This sets how far (in ems) the underline is below the text and what it is relative to. If negative, it is the distance below the baseline. If positive (or zero), it is the distance below the bottom of any descenders."
msgstr "Esto establece la distancia (en ems) a la que se encuentra el subrayado por debajo del texto y a qué se refiere. Si es negativo, es la distancia por debajo de la línea de base. Si es positiva (o cero), es la distancia por debajo de la parte inferior de los descendentes."

#: lib/ptxprint/texpert.py:131
msgid "Underline Spaces"
msgstr "Subrayar espacios"

#: lib/ptxprint/texpert.py:132
msgid "Underline spaces in underlined runs"
msgstr "Subraye los espacios en las líneas subrayadas"

#: lib/ptxprint/texpert.py:133
msgid "Log font creation"
msgstr "Creación de fuentes de tipo «log»"

#: lib/ptxprint/texpert.py:134
msgid "Create <jobname>.fontusage in the local/ptxprint/<config>/ directory, which will list the page number and exact font definition when each new style is first used."
msgstr "Crea un archivo « <jobname>.fontusage» en el directorio «local/ptxprint/<config> », en el que se indicarán el número de página y la definición exacta de la fuente cada vez que se utilice por primera vez un nuevo estilo."

#: lib/ptxprint/texpert.py:136
msgid "Mid-Page Footnotes"
msgstr "Notas a pie en media de página"

#: lib/ptxprint/texpert.py:137
msgid "Should footnotes go before a single-double column transition"
msgstr "Deben ir las notas a pie de página antes de una transición a doble columna"

#: lib/ptxprint/texpert.py:138
msgid "Final Page Notes Down"
msgstr "Página final Notas abajo"

#: lib/ptxprint/texpert.py:139
msgid "Push notes on the final page to the bottom of the page"
msgstr "Empuje las notas de la última página a la parte inferior de la página"

#: lib/ptxprint/texpert.py:140
msgid "Reset Callers at Each Book"
msgstr "Restablecer los llamadores en cada libro"

#: lib/ptxprint/texpert.py:141
msgid "Re-start the footnote and cross-reference callers at the start of each book"
msgstr "Reiniciar los llamadores de las notas al pie de página y las referencias cruzadas al inicio de cada libro"

#: lib/ptxprint/texpert.py:142
msgid "Endnotes at Each Book"
msgstr "Notas finales en cada libro"

#: lib/ptxprint/texpert.py:143
msgid "Output endnotes at the end of each book"
msgstr "Poner las notas al final de cada libro"

#: lib/ptxprint/texpert.py:144
msgid "Enhanced paragraphed footnotes"
msgstr "Notas a pie de página con párrafos mejorados"

#: lib/ptxprint/texpert.py:145
msgid "Paragraphed footnotes which allow \\fp to work and also the ifparnotes... controls below. Causes some spacing differences compared to old-style."
msgstr "Notas a pie de página con párrafo que permiten que funcione \\fp y también los ifparnotes... controles de abajo. Causa algunas diferencias de espaciado en comparación con el estilo antiguo."

#: lib/ptxprint/texpert.py:146
msgid "Remove depth above paragraphed notes"
msgstr "Eliminar la profundidad por encima de las notas con párrafo"

#: lib/ptxprint/texpert.py:147
msgid "Kern away (kill) the glyph/font depth of note types before paragraphed notes, using the value of \\prevdepth"
msgstr "Elimina (matar) la profundidad del glifo/tipo de letra de los tipos de nota antes de las notas con párrafo, utilizando el valor de \\prevdepth"

#: lib/ptxprint/texpert.py:148
msgid "Remove depth after paragraphed notes"
msgstr "Eliminar la profundidad después de las notas con párrafo"

#: lib/ptxprint/texpert.py:149
msgid "Kill the depth of (the last row of) paragraphed note styles. Paragraphed notes will use the margin as their baseline."
msgstr "Elimina la profundidad de (la última fila de) los estilos de notas de párrafo. Las notas con párrafo utilizarán el margen como línea de base."

#: lib/ptxprint/texpert.py:150
msgid "Use grid not font/glyph height at rule"
msgstr "Utilizar la cuadrícula y no la altura de la fuente/glifo en la regla"

#: lib/ptxprint/texpert.py:151
msgid "If true, the footnote rule is positioned relative to the hypothetical baseline above the topmost footnote, rather than relative to the glyph/font height."
msgstr "Si es verdadero, la regla de nota al pie se posiciona en relación con la línea de base hipotética por encima de la nota al pie superior, en lugar de en relación con la altura del glifo/tipo de letra."

#: lib/ptxprint/texpert.py:152
msgid "Use grid not font/glyph height between notes"
msgstr "Utilizar cuadrícula y no altura de fuente/glifo entre notas"

#: lib/ptxprint/texpert.py:153
msgid "If true, then the \\InterNoteSpace is relative to the hypothetical baseline above the topmost footnote, rather than the glyph/font height. \\InterNoteSpace is triggered between note styles."
msgstr "Si es verdadero, entonces el \\InterNoteSpace es relativo a la línea de base hipotética por encima de la nota superior, en lugar de la altura del glifo/fuente. \\InterNoteSpace se activa entre estilos de nota."

#: lib/ptxprint/texpert.py:154
msgid "Use glyph height not font height in footnotes"
msgstr "Utilizar la altura del glifo y no la altura de la fuente en las notas a pie de página"

#: lib/ptxprint/texpert.py:155
msgid "Does the note use the font's descender design parameter, or the actual bottom of the glyph. If the former (and depth is not killed), then the bottom of notes have a common baseline across pages. If the latter, then the glyphs sit as close to the bottom margin as they can, which may permit an extra line of text."
msgstr "¿La nota utiliza el parámetro de diseño descendente de la fuente o la parte inferior real del glifo? Si es el primero (y no se mata la profundidad), entonces la parte inferior de las notas tiene una línea de base común en todas las páginas. En el segundo caso, los glifos se sitúan lo más cerca posible del margen inferior, lo que puede permitir una línea de texto adicional."

#: lib/ptxprint/texpert.py:156
msgid "Last Note: interlinepenalty"
msgstr "Última nota: interlinepenalty"

#: lib/ptxprint/texpert.py:157
msgid "Penalty for breaking between lines of the last footnote."
msgstr "Penalización por rotura entre líneas de la última nota a pie de página."

#: lib/ptxprint/texpert.py:158
msgid "Last Note: widowpenalty"
msgstr "Última nota: widowpenalty"

#: lib/ptxprint/texpert.py:159
msgid "Extra penalty for breaking at the last line of the last footnote."
msgstr "Penalización adicional por ruptura en la última línea de la última nota a pie de página."

#: lib/ptxprint/texpert.py:160
msgid "Last Note: clubpenalty"
msgstr "Última nota: clubpenalty"

#: lib/ptxprint/texpert.py:161
msgid "Extra penalty for breaking at the first line of the last footnote."
msgstr "Penalización adicional por ruptura en la primera línea de la última nota a pie de página."

#: lib/ptxprint/texpert.py:162
msgid "Last Note: penalty at par"
msgstr "Última nota: penalización a la par"

#: lib/ptxprint/texpert.py:163
msgid "Penalty for breaking at an explicit footnote-paragraph in the last footnote."
msgstr "Penalización por ruptura en una nota a pie de página explícita en la última nota a pie de página."

#: lib/ptxprint/texpert.py:164
msgid "Split notes: Shortest note to shave"
msgstr "Dividir notas: La nota más corta de afeitar"

#: lib/ptxprint/texpert.py:165
msgid "If footnotes might be shaved, how many lines must it be?"
msgstr "Si se pueden recortar las notas a pie de página, ¿de cuántas líneas debe constar?"

#: lib/ptxprint/texpert.py:166
msgid "Split notes: min lines to move."
msgstr "Notas divididas: líneas mínimas a mover."

#: lib/ptxprint/texpert.py:167
msgid "If a footnote is being shaved (split onto next page), what is the minimum number of lines to move?"
msgstr "Si se está rasurando una nota a pie de página (dividiéndola en la página siguiente), ¿cuál es el número mínimo de líneas que hay que desplazar?"

#: lib/ptxprint/texpert.py:168
msgid "Split notes: note lines to stay"
msgstr "Notas divididas: líneas de notas para quedarse"

#: lib/ptxprint/texpert.py:169
msgid "If a footnote is being shaved (split onto next page), how many lines of (all) notes must remain on the page?"
msgstr "Si se está rasurando una nota (dividiéndola en la página siguiente), ¿cuántas líneas de (todas) las notas deben permanecer en la página?"

#: lib/ptxprint/texpert.py:170
msgid "Study note factor-Single column"
msgstr "Factor de nota de estudio-Columna única"

#: lib/ptxprint/texpert.py:171
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "Para evitar ciclos innecesarios/páginas incompletas, ¿qué parte de la estimación de altura de una nota de estudio debe aplicar TeX al recoger la entrada en modo de una sola columna? (100=10por ciento)"

#: lib/ptxprint/texpert.py:172
msgid "Study note factor-Two column"
msgstr "Factor de nota de estudio-Dos columnas"

#: lib/ptxprint/texpert.py:173
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "Para evitar ciclos innecesarios/páginas incompletas, ¿qué parte de la estimación de altura de una nota de estudio debe aplicar TeX al recoger la entrada en modo de dos columnas? (100=10por ciento)"

#: lib/ptxprint/texpert.py:174
msgid "Study note factor-Diglot"
msgstr "Factor de nota de estudio-bilingüe"

#: lib/ptxprint/texpert.py:175
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "Para evitar ciclos innecesarios/páginas incompletas, ¿qué parte de la estimación de altura de una nota de estudio debe aplicar TeX al recoger la entrada bilingüe? (100=10por ciento)"

#: lib/ptxprint/texpert.py:176
msgid "Footnote factor-Single column"
msgstr "Factor de nota a pie de página-Columna única"

#: lib/ptxprint/texpert.py:177
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "Para evitar ciclos innecesarios/páginas incompletas, ¿qué parte de la estimación de altura de una nota debe aplicar TeX al recoger la entrada en modo de una sola columna? (100=10por ciento)"

#: lib/ptxprint/texpert.py:178
msgid "Footnote factor-Two column"
msgstr "Factor de nota a pie de página-Dos columnas"

#: lib/ptxprint/texpert.py:179
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "Para evitar ciclos innecesarios/páginas incompletas, ¿qué parte de la estimación de altura de una nota debe aplicar TeX al recoger la entrada en modo de dos columnas? (100=10por ciento)"

#: lib/ptxprint/texpert.py:180
msgid "Footnote factor-Diglot"
msgstr "Factor de nota a pie de página-bilingüe"

#: lib/ptxprint/texpert.py:181
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "Para evitar ciclos innecesarios/páginas incompletas, ¿qué parte de la estimación de altura de una nota debe aplicar TeX al recoger la entrada bilingüe? (100=10por ciento)"

#: lib/ptxprint/texpert.py:182
msgid "Footnote factor-Centre column"
msgstr "Factor de nota a pie de página-Columna central"

#: lib/ptxprint/texpert.py:183
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering centre-column notes? (100=10percent)"
msgstr "Para evitar ciclos innecesarios/páginas incompletas, ¿qué parte de la estimación de altura de una nota debe aplicar TeX al reunir las notas de la columna central? (100=10por ciento)"

#: lib/ptxprint/texpert.py:184
msgid "Distance of margin notes from text"
msgstr "Distancia de las notas al margen respecto al texto"

#: lib/ptxprint/texpert.py:185
msgid "The size of the gap between the margin notes and the text"
msgstr "El tamaño del espacio entre las notas al margen y el texto"

#: lib/ptxprint/texpert.py:187
msgid "Balance diglot/polyglot notes"
msgstr "Equilibrar las notas bilingües y multilingües"

#: lib/ptxprint/texpert.py:188
msgid "When there's a note on column R (for example), does that reduce the space from other columns?"
msgstr "Cuando hay una nota en la columna R (por ejemplo), ¿eso reduce el espacio de las demás columnas?"

#: lib/ptxprint/texpert.py:189
msgid "Diglot/polyglot merged paragraphed notes are RTL"
msgstr "Las notas en dos o más idiomas, agrupadas en párrafos, están escritas de derecha a izquierda (RTL)"

#: lib/ptxprint/texpert.py:190
msgid "When merged notes are not shown as individual paragraphs, the result must be arranged as though RTL or LTR (however the individual notes are structured). This defines the paragraph alignment."
msgstr "Cuando las notas fusionadas no se muestran como párrafos individuales, el resultado debe organizarse como si fuera de derecha a izquierda (RTL) o de izquierda a derecha (LTR), independientemente de cómo estén estructuradas las notas individuales. Esto define la alineación del párrafo."

#: lib/ptxprint/texpert.py:191
msgid "Adjust Versification of Projects"
msgstr "Ajustar la versificación de los proyectos"

#: lib/ptxprint/texpert.py:192
msgid "If versification differs between projects, adjust diglot/polyglot projects to match the primary (L) project."
msgstr "Si la versificación difiere entre proyectos, ajuste los proyectos bilingües/polyglot para que coincidan con el proyecto primario (L)."

#: lib/ptxprint/texpert.py:193
msgid "Keep existing verse numbers (as \\vp)"
msgstr "Mantener los números de versículos existentes (como \\vp)"

#: lib/ptxprint/texpert.py:194
msgid "When adjusting versification, show the original verse numbers in their new (adjusted) location."
msgstr "Al ajustar la versificación, muestre los números de versículo originales en su nueva ubicación (ajustada)."

#: lib/ptxprint/texpert.py:195
msgid "Show old chapter numbers if changed (in \\vp)"
msgstr "Mostrar los números de los capítulos antiguos si han cambiado (en \\vp)"

#: lib/ptxprint/texpert.py:196
msgid "When adjusting versification, show the adjusted chapter numbers (only) if they have changed."
msgstr "Al ajustar la versificación, muestre los números de capítulo ajustados (sólo) si han cambiado."

#: lib/ptxprint/texpert.py:197
msgid "Show Diglot Trace Marks"
msgstr "Mostrar marcas de rastreo bilingüe"

#: lib/ptxprint/texpert.py:198
msgid "Insert visible trace marks in diglot output"
msgstr "Insertar marcas de rastreo visibles en la salida bilingüe"

#: lib/ptxprint/texpert.py:199
msgid "Extra Trace Mark Info"
msgstr "Información adicional sobre marcas de seguimiento"

#: lib/ptxprint/texpert.py:200
msgid "Add extra information to diglot trace marks. (debugging only - can alter layout)"
msgstr "Añadir información extra a las marcas de rastreo bilingüe. (solo para depuración; puede alterar el diseño)"

#: lib/ptxprint/texpert.py:201
msgid "Diglot Shading Padding"
msgstr "Relleno de sombreado bilingüe"

#: lib/ptxprint/texpert.py:202
msgid "The amount of side padding (pt) on the shaded background of a diglot"
msgstr "La cantidad de relleno lateral (pt) en el fondo sombreado de un proyecto bilingüe"

#: lib/ptxprint/texpert.py:204
msgid "Borders start at body text"
msgstr "Los bordes empiezan en el cuerpo del texto"

#: lib/ptxprint/texpert.py:204
msgid "Borders include book intros"
msgstr "Los bordes incluyen introducciones de libros"

#: lib/ptxprint/texpert.py:204
msgid "Wide book intros for per-column textborders"
msgstr "Introducción amplia del libro para los bordes del texto por columna"

#: lib/ptxprint/texpert.py:205
msgid "How does text-border behave in diglots?"
msgstr "¿Cómo se comporta el borde del texto en los proyectos bilingües?"

#: lib/ptxprint/texpert.py:205
msgid "Historically, diglot text-borders put the border around book introductions. This control allows that (substandard) behaviour to be chosen, and also allows  experimental code to make books with per-column textborders use full-width text for introductory text."
msgstr "Históricamente, los bordes de texto diglotos colocaban el borde alrededor de las introducciones de los libros. Este control permite elegir ese comportamiento (por debajo del estándar) y también permite que el código experimental cree libros con bordes de texto por columna que utilicen texto de ancho completo para el texto introductorio."

#: lib/ptxprint/texpert.py:206
msgid "Unprintable page recovery."
msgstr "Recuperación de página no imprimible."

#: lib/ptxprint/texpert.py:207
msgid "If notes / figures make a page unprintable: -1: immediately stop; 0: print failed contents and try to struggle on; >0 grow page height by up to N lines."
msgstr "Si las notas / figuras hacen que una página no se pueda imprimir: -1: detenerse de inmediato; 0: imprimir el contenido fallido e intentar continuar; >0 aumentar la altura de la página hasta N líneas."

#: lib/ptxprint/texpert.py:208
msgid "1xBiggest baseline"
msgstr "1x la línea de base más grande"

#: lib/ptxprint/texpert.py:208
msgid "2xSmallest baseline"
msgstr "2x la línea de base más pequeña"

#: lib/ptxprint/texpert.py:208
msgid "2xBiggest baseline"
msgstr "2x la línea de base más grande"

#: lib/ptxprint/texpert.py:208
msgid "3xSmallest baseline"
msgstr "Línea base 3x más pequeña"

#: lib/ptxprint/texpert.py:208
msgid "Page-full test."
msgstr "Prueba de página llena."

#: lib/ptxprint/texpert.py:209
msgid "When a (non-title) chunk has finished, the amount of unused space below which diglot will immediately output a page,  rather than trying to fit the next chunk. (irrespective of how short it is). Higher values encourage underfilled pages, but can prevent orphaning of the 1st line of poetry."
msgstr "Cuando termina un bloque (que no sea de título), es la cantidad de espacio sin usar por debajo de la cual el texto bilingüe producirá inmediatamente una página, en lugar de intentar encajar el siguiente bloque (sin importar lo corto que sea). Los valores más altos favorecen páginas poco llenas, pero pueden evitar que la 1.ª línea de poesía quede huérfana."

#: lib/ptxprint/texpert.py:210
msgid "Default Figures Top Left"
msgstr "Por defecto las imágenes se ubican en la parte superior izquierda"

#: lib/ptxprint/texpert.py:211
msgid "Default figure positions to top left"
msgstr "Posiciones predeterminadas de las cifras arriba a la izquierda"

#: lib/ptxprint/texpert.py:212
msgid "Ref Before Caption"
msgstr "Referencia antes del título"

#: lib/ptxprint/texpert.py:213
msgid "Output reference before caption"
msgstr "Mostrar referencia antes de la leyenda"

#: lib/ptxprint/texpert.py:214
msgid "Show Caption Before Image"
msgstr "Mostrar leyenda antes de la ilustración"

#: lib/ptxprint/texpert.py:215
msgid "Output caption before image"
msgstr "Mostrar la leyenda antes de la ilustración"

#: lib/ptxprint/texpert.py:216
msgid "Space (pt) beside cutout/sidebar"
msgstr "Espacio (pt) al lado del recorte/barra lateral"

#: lib/ptxprint/texpert.py:217
msgid "This sets the default gap (pt) between the body text and the side of a figure/sidebar in a cutout."
msgstr "Establece el espacio por defecto (pt) entre el cuerpo del texto y el lado de una figura/barra lateral en un recorte."

#: lib/ptxprint/texpert.py:218
msgid "Space between picture & caption"
msgstr "Espacio entre la imagen y el pie de foto"

#: lib/ptxprint/texpert.py:219
msgid "Increase/Reduce the gap between figures and their captions"
msgstr "Aumentar/Reducir el espacio entre las figuras y sus pies de foto"

#: lib/ptxprint/texpert.py:220
msgid "Default space beside picture"
msgstr "Espacio por defecto al lado de la ilustración"

#: lib/ptxprint/texpert.py:221
msgid "Picture horizontal margin*2"
msgstr "Margen horizontal de la ilustración*2"

#: lib/ptxprint/texpert.py:222
msgid "Show comprehensive illustration credits"
msgstr "Mostrar créditos completos de ilustraciones"

#: lib/ptxprint/texpert.py:223
msgid "Instead of using the catch-all phrasing 'All other illustrations by...' show a comprehensive list of every artist and all pages that contain their illustrations."
msgstr "En lugar de utilizar la expresión genérica 'Todas las demás ilustraciones son de...', muestra una lista completa de todos los artistas y todas las páginas que contienen sus ilustraciones."

#: lib/ptxprint/texpert.py:225
msgid "No PDF Bookmarks"
msgstr "No hay marcadores PDF"

#: lib/ptxprint/texpert.py:226
msgid "Don’t output PDF bookmarks"
msgstr "No imprimir marcadores PDF"

#: lib/ptxprint/texpert.py:227
msgid "Allow Active Links in PDF"
msgstr "Permitir enlaces activos en PDF"

#: lib/ptxprint/texpert.py:228
msgid "Make links active inside PDF"
msgstr "Activar enlaces dentro del PDF"

#: lib/ptxprint/texpert.py:229
msgid "Use Book Codes in PDF Bookmarks"
msgstr "Utilizar códigos de libro en marcadores PDF"

#: lib/ptxprint/texpert.py:230
msgid "Use book codes instead of book names in bookmarks"
msgstr "Utilizar códigos de libros en lugar de nombres en los marcadores"

#: lib/ptxprint/texpert.py:231
msgid "Disable Transparency in PDF"
msgstr "Desactivar la transparencia en PDF"

#: lib/ptxprint/texpert.py:232
msgid "Disable transparency output in PDF"
msgstr "Desactivar la salida de transparencias en PDF"

#: lib/ptxprint/texpert.py:233
msgid "Show adjust points"
msgstr "Mostrar puntos de ajuste"

#: lib/ptxprint/texpert.py:234
msgid "Show adjust points in the margin of the text."
msgstr "Mostrar puntos de ajuste en el margen del texto."

#: lib/ptxprint/texpert.py:235
msgid "Mark Trigger Points"
msgstr "Marcar puntos de activación"

#: lib/ptxprint/texpert.py:236
msgid "Display trigger points in output"
msgstr "Mostrar los puntos de activación en la salida"

#: lib/ptxprint/texpert.py:237
msgid "Show USFM codes"
msgstr "Mostrar códigos USFM"

#: lib/ptxprint/texpert.py:238
msgid "Show the USFM markers in the margin beside paragraphs."
msgstr "Mostrar los marcadores USFM en el margen junto a los párrafos."

#: lib/ptxprint/texpert.py:239
msgid "Show Error Bars For Overfull Lines"
msgstr "Mostrar Barras de Error Para Líneas Sobrecargadas"

#: lib/ptxprint/texpert.py:240
msgid "Enable this option to have TeX make overfull lines stand out."
msgstr "Active esta opción para que TeX resalte las líneas demasiado llenas."

#: lib/ptxprint/texpert.py:243
msgid "Spine Overlap onto Back Cover (mm)"
msgstr "Superposición del lomo sobre la contraportada (mm)"

#: lib/ptxprint/texpert.py:244
msgid "If you want the spine graphic or colour to spill over onto the back cover page, then set the amount of overlap here."
msgstr "Si quieres que el diseño o el color del lomo se extienda hasta la contraportada, configura aquí el grado de solapamiento."

#: lib/ptxprint/texpert.py:246
msgid "Spine Overlap onto Front Cover (mm)"
msgstr "Superposición del lomo sobre la portada (mm)"

#: lib/ptxprint/texpert.py:247
msgid "If you want the spine graphic or colour to spill over onto the front cover page, then set the amount of overlap here."
msgstr "Si quieres que el diseño o el color del lomo se extienda hasta la portada, configura aquí el grado de superposición."

#: lib/ptxprint/texpert.py:249
msgid "Cover Bleed (mm)"
msgstr "Sangrado de la portada (mm)"

#: lib/ptxprint/texpert.py:250
msgid "Bleed is the section of artwork that goes beyond where the paper is cut. This ensures that the image goes right to the edge of the cover after it has been trimmed."
msgstr "El sangrado es la parte del diseño que se extiende más allá del borde de corte del papel. Esto garantiza que la imagen llegue hasta el borde de la cubierta una vez recortada."

#: lib/ptxprint/texpert.py:252
msgid "Hard Cover Art Bleed (mm)"
msgstr "Sangrado de la ilustración de la tapa dura (mm)"

#: lib/ptxprint/texpert.py:253
msgid "Art Bleed is specifically for hard cover binding and is the setting which enables images to go beyond the size of the cover in order to wrap around the hard cover and stuck down under the inner backing sheet."
msgstr "El «Art Bleed» está pensado específicamente para la encuadernación en tapa dura y es el ajuste que permite que las imágenes se extiendan más allá del tamaño de la cubierta, de modo que envuelvan la tapa dura y queden pegadas bajo la lámina interior de refuerzo."

#: lib/ptxprint/texpert.py:258
msgid "Auto-update Delay (seconds)"
msgstr "Retraso de actualización automática (segundos)"

#: lib/ptxprint/texpert.py:259
msgid "Right-clicking again on the PDF within this time (3 second default) will prevent the Auto-update from running."
msgstr "Si vuelve a hacer clic con el botón derecho del ratón en el PDF antes de que transcurra este tiempo (3 segundos por defecto), evitará que se ejecute la retraso de actualización automática."

#: lib/ptxprint/texpert.py:260
msgid "Shrink Text Step Value (%)"
msgstr "Valor (%) de cada paso de reducción"

#: lib/ptxprint/texpert.py:261
msgid "Step Value to shrink text using right-click context menu adjustment."
msgstr "Valor de cada clic para reducir el texto mediante el ajuste del menú contextual del botón derecho del ratón."

#: lib/ptxprint/texpert.py:262
msgid "Minimum Text Shrink (%)"
msgstr "Contracción mínima del texto (%)"

#: lib/ptxprint/texpert.py:263
msgid "Limit how much text can shrink to using right-click context menu adjustment."
msgstr "Limite la cantidad de texto que puede reducirse mediante el ajuste del menú contextual del botón derecho del ratón."

#: lib/ptxprint/texpert.py:264
msgid "Expand Text Step Value (%)"
msgstr "Valor (%) de cada paso de expansión"

#: lib/ptxprint/texpert.py:265
msgid "Step Value to expand text using right-click context menu adjustment."
msgstr "Valor de cada clic para ampliar el texto mediante el ajuste del menú contextual del botón derecho del ratón."

#: lib/ptxprint/texpert.py:266
msgid "Maximum Text Expand (%)"
msgstr "Expansión máxima del texto (%)"

#: lib/ptxprint/texpert.py:267
msgid "Limit how much text can expand to using right-click context menu adjustment."
msgstr "Limite la cantidad de texto que puede expandirse a utilizar el ajuste del menú contextual del clic derecho."

#: lib/ptxprint/texpert.py:268
msgid "Bad Space minimum width (em)"
msgstr "Ancho mínimo de espacio malo (em)"

#: lib/ptxprint/texpert.py:269
msgid "Minimum width for a bad space. 0 says to calculate for the 20 worst spaces in the doc"
msgstr "Ancho mínimo para un espacio malo. 0 dice calcular para los 20 peores espacios en el documento"

#: lib/ptxprint/texpert.py:270
msgid "Bad intercharacter space minimum width (em)"
msgstr "Anchura mínima del espacio entre caracteres incorrecta (em)"

#: lib/ptxprint/texpert.py:271
msgid "Minimum width for a bad inter character space."
msgstr "Anchura mínima para un espacio entre caracteres malo."

#: lib/ptxprint/texpert.py:272
msgid "Precise collisions"
msgstr "Colisiones precisas"

#: lib/ptxprint/texpert.py:273
msgid "Only show precise collisions between glyphs rather than overlapping bounding boxes - slow"
msgstr "Mostrar únicamente las colisiones exactas entre glifos, en lugar de las superposiciones de los rectángulos delimitadores — lento"

#: lib/ptxprint/texpert.py:274
msgid "Collision Detection Padding (pt)"
msgstr "Relleno de detección de colisiones (pt)"

#: lib/ptxprint/texpert.py:275
msgid "Minimum space between bounding boxes of glyphs before a collision is flagged."
msgstr "Espacio mínimo entre las cajas delimitadoras de los glifos antes de que se marque una colisión."

#: lib/ptxprint/texpert.py:276
msgid "River Detection Threshold (em)"
msgstr "Umbral de detección del río (em)"

#: lib/ptxprint/texpert.py:277
msgid "The sum of all the widths in the river must be above this for the river to be detected"
msgstr "La suma de todas las anchuras del río debe ser superior a este valor para que el río sea detectado"

#: lib/ptxprint/texpert.py:278
msgid "River Detection minimum required maximum width (em)"
msgstr "Detección del río: requerido mínimo del ancho máximo (em)"

#: lib/ptxprint/texpert.py:279
msgid "Minimum width required for the widest part of the river"
msgstr "Anchura mínima requerida para la parte más ancha del río"

#: lib/ptxprint/texpert.py:28
msgid "Maximum layout version"
msgstr "Versión máxima del diseño"

#: lib/ptxprint/texpert.py:280
msgid "River Detection minimum width (em)"
msgstr "Detección del río: ancho mínimo (em)"

#: lib/ptxprint/texpert.py:281
msgid "Minimum width of any space in a river for it to be included"
msgstr "Anchura mínima de cualquier espacio en un río para que se incluya"

#: lib/ptxprint/texpert.py:282
msgid "River Detection maximum line leading (em)"
msgstr "Detección de río: máximo interlineado (em)"

#: lib/ptxprint/texpert.py:283
msgid "Any lines separated by a gap greater than this will be considered not to be in the same river"
msgstr "Se considerará que las líneas separadas por una distancia superior no se encuentran en el mismo río"

#: lib/ptxprint/texpert.py:284
msgid "River Detection minimum overlap (em)"
msgstr "Detección de río: solapamiento mínimo de detección (em)"

#: lib/ptxprint/texpert.py:285
msgid "Minimum overlap in ems required for two spaces above each other to be considered part of the same river"
msgstr "Solapamiento mínimo en ems necesario para que dos espacios superpuestos se consideren parte del mismo río"

#: lib/ptxprint/texpert.py:29
msgid "Maximum layout version to use or 0 for any. Used to maintain backward compatibility when the TeX macros have been changed in newer versions of PTXprint."
msgstr "Versión máxima de diseño a utilizar o 0 para cualquiera. Se utiliza para mantener la compatibilidad con versiones anteriores cuando las macros TeX se han modificado en versiones más recientes de PTXprint."

#: lib/ptxprint/texpert.py:290
msgid "Time limit for the whole job (minutes)"
msgstr "Límite de tiempo para todo el trabajo (minutos)"

#: lib/ptxprint/texpert.py:291
msgid "The page filler works on all the books together. When this time is reached, the page filler stops. A book that is not finished keeps the pages that are already filled. Usually this affects only the longest book.\n"
"Higher: more time to find a good layout for every page."
msgstr "El rellenador de páginas trabaja con todos los libros a la vez. Cuando se alcanza este tiempo, el rellenador de páginas se detiene. Un libro que no esté terminado conserva las páginas que ya están rellenadas. Normalmente esto afecta solo al libro más largo.\n"
"Más alto: más tiempo para encontrar un buen diseño para cada página."

#: lib/ptxprint/texpert.py:295
msgid "Earlier pages to retry"
msgstr "Páginas anteriores a reintentar"

#: lib/ptxprint/texpert.py:296
msgid "If the page filler cannot fill a page, it backtracks to the page before and tries a different layout there. This is the largest number of pages it can backtrack.\n"
"Higher: fewer failed pages, but much slower.\n"
"Lower: faster, but more pages may fail. 0 = never backtrack (fastest).\n"
"Affects: Speed."
msgstr "Si el rellenador de páginas no puede rellenar una página, retrocede a la página anterior e intenta allí un diseño diferente. Este es el número máximo de páginas que puede retroceder.\n"
"Más alto: menos páginas fallidas, pero mucho más lento.\n"
"Más bajo: más rápido, pero pueden fallar más páginas. 0 = nunca retroceder (lo más rápido).\n"
"Afecta a: la velocidad."

#: lib/ptxprint/texpert.py:30
msgid "Legacy 1/14 LineSpacing"
msgstr "Legado 1/14 LineSpacing"

#: lib/ptxprint/texpert.py:301
msgid "Paragraphs to adjust on each page"
msgstr "Párrafos a ajustar en cada página"

#: lib/ptxprint/texpert.py:302
msgid "The largest number of paragraphs on one page that the page filler may stretch or shrink. Each poetry line (\\q1, \\q2 …) counts as one paragraph. Each extra paragraph doubles the number of layouts the page filler tries.\n"
"Higher: more ways to fill each page, so fewer failed pages, but each page takes longer.\n"
"Lower: faster, but more pages may fail.\n"
"Affects: Speed."
msgstr "El número máximo de párrafos en una página que el rellenador de páginas puede estirar o reducir. Cada línea de poesía (\\q1, \\q2 …) cuenta como un párrafo. Cada párrafo extra duplica el número de diseños que el rellenador de páginas prueba.\n"
"Más alto: más formas de rellenar cada página, por lo que hay menos páginas fallidas, pero cada página tarda más.\n"
"Más bajo: más rápido, pero pueden fallar más páginas.\n"
"Afecta a: la velocidad."

#: lib/ptxprint/texpert.py:309
msgid "Widest word space allowed (× text size)"
msgstr "Espacio entre palabras máximo permitido (× tamaño del texto)"

#: lib/ptxprint/texpert.py:31
msgid "In the past, SpaceAbove and SpaceBelow were, in effect units of 1/14 of the base line spacing. This has changed so they are now in units of 1/12 of the base line spacing. Enabling this compatibility reverts the units."
msgstr "En el pasado, SpaceAbove y SpaceBelow eran, en efecto unidades de 1/14 de la línea base de espaciado. Esto ha cambiado así que ahora están en unidades de 1/12 del espaciado de línea base. Habilitar esta compatibilidad revierte las unidades."

#: lib/ptxprint/texpert.py:310
msgid "When the page filler stretches a paragraph, the average space between words must not be wider than this. 1.0 = as wide as the text size. A normal word space is about 0.3 to 0.5.\n"
"Higher: easier to fill pages, but the text can look too spread out.\n"
"Lower: tighter, better-looking text, but pages are harder to fill and take longer.\n"
"Affects: Quality and Speed."
msgstr "Cuando el rellenador de páginas estira un párrafo, el espacio promedio entre palabras no debe ser más ancho que este valor. 1.0 = tan ancho como el tamaño del texto. Un espacio normal entre palabras es de aproximadamente 0.3 a 0.5.\n"
"Más alto: es más fácil rellenar las páginas, pero el texto puede verse demasiado espaciado.\n"
"Más bajo: texto más compacto y de mejor aspecto, pero las páginas son más difíciles de rellenar y tardan más.\n"
"Afecta a: la calidad y la velocidad."

#: lib/ptxprint/texpert.py:315
msgid "Keep paragraphs close to normal width"
msgstr "Mantener los párrafos cerca del ancho normal"

#: lib/ptxprint/texpert.py:316
msgid "The page filler prefers small changes to a paragraph over big changes. This setting controls how strong that preference is. Higher: the page filler tries small changes first, so the text looks more even.\n"
"Lower: the page filler accepts big changes more easily.\n"
"Affects: Quality."
msgstr "El rellenador de páginas prefiere cambios pequeños en un párrafo a cambios grandes. Este ajuste controla la fuerza de esa preferencia. Más alto: el rellenador de páginas prueba primero los cambios pequeños, por lo que el texto se ve más uniforme.\n"
"Más bajo: el rellenador de páginas acepta con más facilidad los cambios grandes.\n"
"Afecta a: la calidad."

#: lib/ptxprint/texpert.py:321
msgid "Penalise shrink or stretch"
msgstr "Penalizar reducción o estiramiento"

#: lib/ptxprint/texpert.py:322
msgid "Tells the page filler whether to shrink paragraphs or stretch them when both are possible.\n"
"Positive numbers: penalise stretching (so the text prefers to shrink more).\n"
"Negative numbers: penalise shrinking. (so the text prefers to stretch more).\n"
"0: no preference.\n"
"A bigger number (+ or −) means a higher penalty.\n"
"Affects: Quality."
msgstr "Indica al rellenador de páginas si debe reducir los párrafos o estirarlos cuando ambas opciones son posibles.\n"
"Números positivos: penalizan el estiramiento (así el texto prefiere reducirse más).\n"
"Números negativos: penalizan la reducción (así el texto prefiere estirarse más).\n"
"0: sin preferencia.\n"
"Un número mayor (+ o −) significa una penalización más alta.\n"
"Afecta a: la calidad."

#: lib/ptxprint/texpert.py:328
msgid "Keep neighbouring paragraphs alike"
msgstr "Mantener párrafos vecinos parecidos"

#: lib/ptxprint/texpert.py:329
msgid "The page filler compares each paragraph with the paragraph before it. It tries to avoid a very stretched paragraph next to a very shrunk one.\n"
"Higher: neighbouring paragraphs look more alike, so the page looks more even.\n"
"Lower: neighbouring paragraphs can look more different.\n"
"Affects: Quality."
msgstr "El rellenador de páginas compara cada párrafo con el párrafo anterior. Intenta evitar un párrafo muy estirado junto a uno muy reducido.\n"
"Más alto: los párrafos vecinos se ven más parecidos, por lo que la página se ve más uniforme.\n"
"Más bajo: los párrafos vecinos pueden verse más diferentes.\n"
"Afecta a: la calidad."

#: lib/ptxprint/texpert.py:335
msgid "The cost of imbalance in a polyglot slice"
msgstr "El costo del desequilibrio en un Slice políglota"

#: lib/ptxprint/texpert.py:336
msgid "How bad is it for a polyglot slice to not be balanced. This the multiplier of that cost\n"
"Only relevant to diglot and polyglot projects"
msgstr "Cuán negativo es que un Slice políglota no esté equilibrado. Este es el multiplicador de ese costo.\n"
"Solo es relevante para proyectos bilingües y políglotas"

#: lib/ptxprint/texpert.py:339
msgid "Use \\toc3 for Tab Text"
msgstr "Usar \\toc3 para texto de pestaña del pulgar"

#: lib/ptxprint/texpert.py:34 lib/ptxprint/texpert.py:40
msgid "Next page"
msgstr "Página siguiente"

#: lib/ptxprint/texpert.py:34
msgid "Same page"
msgstr "Misma página"

#: lib/ptxprint/texpert.py:34
msgid "Odd page"
msgstr "Página impar"

#: lib/ptxprint/texpert.py:340
msgid "Use \\toc3 for tab text if no \\zthumbtab"
msgstr "Utilice \\toc3 para el texto de la pestaña si no hay \\zthumbtab"

#: lib/ptxprint/texpert.py:342
msgid "Tilde is No Break Space"
msgstr "La tilde es un espacio de no separación"

#: lib/ptxprint/texpert.py:343
msgid "Treat ~ as non breaking space"
msgstr "Tratar ~ como espacio de no separación"

#: lib/ptxprint/texpert.py:344
msgid "Remove \\ref ... \\ref* links"
msgstr "Eliminar enlaces \\ref ... \\ref*"

#: lib/ptxprint/texpert.py:345
msgid "USFM 3.2 allows additional reference links to be inserted as part of \\xt ... \\xt* markup. This frequently appear in DBL text bundles, but are unhandled by PTXprint. Allow these to be removed from the USFM prior to typesetting."
msgstr "USFM 3.2 permite insertar enlaces de referencia adicionales como parte del marcado \\xt ... \\xt*. Aparecen con frecuencia en los paquetes de texto DBL, pero PTXprint no los gestiona. Permita que se eliminen del USFM antes de la composición tipográfica."

#: lib/ptxprint/texpert.py:346
msgid "End decoration skip"
msgstr "Salto de decoración final"

#: lib/ptxprint/texpert.py:347
msgid "The gap between the end of the book and the book-end decoration"
msgstr "El espacio entre el final del libro y la decoración del final del libro"

#: lib/ptxprint/texpert.py:348
msgid "Thumbtab rotated adjustment"
msgstr "Ajuste de la pestaña del pulgar girada"

#: lib/ptxprint/texpert.py:349
msgid "Shift thumbtab text"
msgstr "Desplazar el texto de la pestaña del pulgar"

#: lib/ptxprint/texpert.py:35
msgid "Where to start a new book"
msgstr "Dónde empezar un nuevo libro"

#: lib/ptxprint/texpert.py:35
msgid "Does a scripture book start on a new page, the same page as the previous book (if <65% of page has been used), or an odd page"
msgstr "¿Comienza un libro de escritura en una página nueva, en la misma página que el libro anterior (si se ha utilizado <65% de la página), o en una página impar?"

#: lib/ptxprint/texpert.py:36
msgid "Page full factor"
msgstr "Página factor completo"

#: lib/ptxprint/texpert.py:37
msgid "This setting is related to how full a page needs to be to force the next book to start on a new page."
msgstr "Este ajuste está relacionado con lo llena que tiene que estar una página para forzar que el siguiente libro empiece en una página nueva."

#: lib/ptxprint/texpert.py:40
msgid "No page breaks"
msgstr "Sin saltos de página"

#: lib/ptxprint/texpert.py:40
msgid "On an odd page"
msgstr "En una página impar"

#: lib/ptxprint/texpert.py:40
msgid "Grouped"
msgstr "Agrupado"

#: lib/ptxprint/texpert.py:41
msgid "Where to start a new intro page"
msgstr "Dónde empezar una nueva página de introducción"

#: lib/ptxprint/texpert.py:41
msgid "Does an intro page start on a new page, the same page as the previous book, an odd page, or group all adjacent intro pages into an odd paged group"
msgstr "¿Una página de introducción comienza en una página nueva, en la misma página que el libro anterior, en una página impar o agrupa todas las páginas de introducción adyacentes en un grupo de páginas impares?"

#: lib/ptxprint/texpert.py:42
msgid "Unbalanced Lines (Max)"
msgstr "Líneas no equilibradas (máx.)"

#: lib/ptxprint/texpert.py:43
msgid "Maximum number of unbalanced lines allowed in 2-column layout. Recommended range 1-5."
msgstr "Número máximo de líneas desequilibradas permitido en un diseño de 2 columnas. Rango recomendado 1-5."

#: lib/ptxprint/texpert.py:44
msgid "Variable line spacing maximum stretch"
msgstr "Espaciado entre líneas variable: extensión máxima"

#: lib/ptxprint/texpert.py:45
msgid "Maximum stretch to insert between lines in variable line spacing in pts"
msgstr "Estiramiento máximo para insertar entre líneas con interlineado variable en puntos"

#: lib/ptxprint/texpert.py:46
msgid "Variable line spacing maximum shrink"
msgstr "Espaciado entre líneas variable: reducción máxima"

#: lib/ptxprint/texpert.py:47
msgid "Maximum shrink to insert between lines in variable line spacing in pts"
msgstr "Reducción máxima para insertar entre líneas con interlineado variable en puntos"

#: lib/ptxprint/texpert.py:48
msgid "No Top Space"
msgstr "Sin espacio superior"

#: lib/ptxprint/texpert.py:49
msgid "Don’t insert space above headings at the start of a column"
msgstr "No insertar espacio sobre los encabezados al inicio de una columna"

#: lib/ptxprint/texpert.py:50
msgid "Suppress pagebreak after bookend-final"
msgstr "Suprimir el salto de página después del final de libro"

#: lib/ptxprint/texpert.py:51
msgid "Revert to old behaviour of not ensuring that the whole of the last book is output before back-matter PDFs"
msgstr "Volver al antiguo comportamiento de no asegurarse de que se imprime todo el último libro antes de los PDF de fondo"

#: lib/ptxprint/texpert.py:52
msgid "Noteline offset (mm)"
msgstr "Desplazamiento de la línea de nota (mm)"

#: lib/ptxprint/texpert.py:53
msgid "Gap (mm) between noteline and text"
msgstr "Distancia (mm) entre la línea de nota y el texto"

#: lib/ptxprint/texpert.py:54
msgid "Noteline margin (mm)"
msgstr "Margen de la línea de nota (mm)"

#: lib/ptxprint/texpert.py:55
msgid "Gap (mm) between noteline and edge of page"
msgstr "Espacio (mm) entre la línea de nota y el borde de la página"

