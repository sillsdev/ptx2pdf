msgstr "Evitar que la página se llene en el libro tras tantos minutos"

#: lib/ptxprint/texpert.py:78
msgid "Always down"
msgstr "Siempre abajo"

#: lib/ptxprint/texpert.py:78
msgid "Always up"
msgstr "Siempre arriba"

#: lib/ptxprint/texpert.py:78
msgid "Up on left"
