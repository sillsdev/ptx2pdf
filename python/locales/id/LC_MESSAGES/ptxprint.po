#: lib/ptxprint/runjob.py:40 lib/ptxprint/runjob.py:72
msgid "Probably a TeX macro problem - contact support, or post a bug report"
msgstr "Mungkin ada masalah dengan makro TeX - hubungi staf pendukung, atau kirim laporan masalah"

#: lib/ptxprint/runjob.py:41
msgid "Uh oh! You've pushed TeX too far! Try turning Hyphenation off, or contact support."
msgstr "Aduh! Program TeX tidak mampu! Coba nonaktifkan Beri Tanda Hubung, atau hubungi staf pendukung."

#: lib/ptxprint/runjob.py:42
msgid "Uh oh! You may have too many paragraphed footnotes on the page.\n"
"Try starting each footnote on a new line (Notes+Refs tab)."
msgstr ""

#: lib/ptxprint/runjob.py:44
msgid "Check if the stylesheet specified on the Advanced tab exists."
msgstr "Lihat apakah lembar gaya yang ditentukan di bagian Lanjutan memang ada."

#: lib/ptxprint/runjob.py:45
msgid "Check if picture file is located in 'Figures', 'local\\figures' or a\n"
"specified folder. Also try the option 'Omit Missing Pictures'"
msgstr "Lihat apakah file gambar ini ada di 'Gambar', di 'local\\figures', atau\n"
"di folder tertentu. Dan coba pilihan 'Abaikan Gambar yang Tidak Ada'"

#: lib/ptxprint/runjob.py:47
msgid "Check if image/PDF file is available on the system.\n"
"If you have specified one or more Front/Back matter PDFs or a Watermark PDF\n"
"then ensure that the PDF(s) exist(s); OR uncheck those options (Advanced tab)."
msgstr "Lihat apakah file gambar/PDF tersedia di komputer Anda.\n"
"Kalau Anda telah menentukan PDF Bagian Depan, atau Bagian Belakang, atau Watermark,\n"
"pastikan file PDF itu memang ada; ATAU jangan tentukan pilihan itu (bagian Lanjutan)."

#: lib/ptxprint/runjob.py:50
msgid "Fallback font probably being applied to text in a footnote (not permitted!)"
msgstr "Mungkin font pengganti digunakan pada teks di catatan kaki (hal ini tidak boleh!)"

#: lib/ptxprint/runjob.py:51
msgid "Expecting a number for \\Color definition, not a color name. (e.g. \\Color xff7f7f)"
msgstr "Mengharapkan angka untuk definisi \\Color, bukan nama warna. (misalnya \\Color xff7f7f)"

#: lib/ptxprint/runjob.py:52
msgid "Possibly a missing +/- value in the Adjust List (see View+Edit tab).\n"
"  OR\n"
"Maybe related to USFM3 illustration markup"
msgstr "Mungkin ada nilai +/- yang hilang di Daftar Sesuaikan (lihat tab Lihat+Edit).\n"
"  ATAU\n"
"Mungkin terkait dengan markup ilustrasi USFM3"

#: lib/ptxprint/runjob.py:54
msgid "This might be related to a USFM marker error (using an unsupported marker).\n"
"Try running 'Basic Checks' in Paratext to validate markers.\n"
"It could also be related to an unrecognized setting in ptxprint_mods.tex"
msgstr "Hal ini mungkin terkait dengan kesalahan pada markah USFM (menggunakan markah yang tidak didukung).\n"
"Coba jalankan 'Pemeriksaan Dasar' di Parateks untuk memvalidasi markah.\n"
"Hal ini juga bisa terkait dengan pengaturan yang tidak dikenali di ptxprint_mods.tex"

#: lib/ptxprint/runjob.py:57
msgid "One of the settings in the Stylesheet may be missing the units.\n"
"To confirm that this is a stylesheet issue, temporarily turn off Stylesheets.\n"
"Then, check any recent changes to the Stylesheets (on Advanced tab) and try again."
msgstr "Mungkin salah satu pengaturan di Lembar Gaya belum diberikan satuannya.\n"
"Untuk memastikan bahwa masalahnya ada di Lembar Gaya, nonaktifkan Lembar Gaya untuk sementara.\n"
"Kemudian, cari perubahan yang baru saja dilakukan di Lembar Gaya (di bagian Lanjutan) dan coba lagi."

#: lib/ptxprint/runjob.py:61
msgid "Try turning off various settings on the Advanced tab."
msgstr "Coba matikan berbagai pengaturan pada tab Lanjutan."

#: lib/ptxprint/runjob.py:62
msgid "Sorry! XeTeX was unable to complete the typesetting.\n"
"* If creating a Diglot, ensure both texts can print successfully\n"
"  before merging them as a Diglot print. And ensure that there\n"
"  aren't any large chunks of missing text in either of the projects.\n"
"* Also check that you haven't inadvertently left certain settings on\n"
"  from a previous session (Pictures, Diglot, Borders - which will show\n"
"  in blue if these features are currently enabled)."
msgstr "Maaf! Program XeteX tidak dapat selesaikan penyusunan huruf.\n"
"* Kalau Anda sedang membuat Terbitan Dua Bahasa, pastikan masing-masing\n"
" teks dapat dicetak sebelum menggabungkannya untuk dicetak bersama.\n"
" Dan pastikan tidak ada teks yang hilang dari salah satu proyek itu.\n"
"* Juga pastikan Anda tidak tetap gunakan pengaturan dari\n"
" sesi sebelumnya (Gambar, Dua Bahasa, Bingkai Halaman - yang diberi\n"
" warna biru kalau sedang diaktifkan)."

#: lib/ptxprint/runjob.py:69
msgid "Try turning off the ptxprint-mods stylesheet"
msgstr "Coba nonaktifkan Lembar Gaya ptxprint-mods"

#: lib/ptxprint/runjob.py:70
msgid "Problem with Formatting Intro Outline\n"
"Try disabling option 'Right-Align \\ior with tabbed leaders' on the Body tab"
msgstr "Ada Masalah Dengan Mengatur Garis Besar di Pendahuluan\n"
"Coba nonaktifkan pilihan 'Atur \\ior ke Kanan memakai tab' di bagian Tubuh Teks"

#: lib/ptxprint/runjob.py:73
msgid "Possible fault in the hyphenation file\n"
"Try turning off Hyphenate option located on the Fonts+Scripts tab"
msgstr "Mungkin ada kesalahan di file tanda hubung\n"
"Coba nonaktifkan pilihan Beri Tanda Hubung di bagian Font+Tulisan"

#: lib/ptxprint/runjob.py:75
msgid "Fallback Font issue - set a font on the Fonts+Scripts tab.\n"
"(Turn off the option 'Use Fallback Font' or specify a valid font)"
msgstr "Masalah dengan Font Pengganti - tentukan fon di bagian Font+Tulisan.\n"
"(Nonaktifkan pilihan 'Gunakan Font Pengganti' atau tentukan font yang berlaku)"

#: lib/ptxprint/runjob.py:77
msgid "Cannot find the Font specified. Install it, restart PTXprint and try again\n"
"or change the font to one that is already installed. More details below."
msgstr ""

#: lib/ptxprint/runjob.py:79
msgid "Font size setting issue. Check to see if the font size in a style\n"
"in or near the reference below is incorrect (maybe it is set to 0.00)."
msgstr "Masalah pengaturan ukuran font. Periksa untuk melihat apakah ukuran font \n"
"dalam gaya di atau di dekat referensi di bawah ini salah (mungkin disetel ke 0,00)."

#: lib/ptxprint/runjob.py:81 lib/ptxprint/runjob.py:82
msgid "Possibly a TeX macro issue - contact support, or post a bug report"
msgstr "Mungkin ada masalah dengan makro TeX - hubungi staf pendukung, atau kirim laporan masalah"

#: lib/ptxprint/runjob.py:83 lib/ptxprint/runjob.py:84
msgid "Possibly a faulty installation."
msgstr "Mungkin ada masalah waktu program ini dipasang."

#: lib/ptxprint/runjob.py:85
msgid "Unknown issue. Possibly related to Right-aligned tabbed leaders. Try turning off various settings on the Advanced Tab."
msgstr "Masalah tidak diketahui. Mungkin terkait dengan tab yang diratakan ke kanan. Coba matikan berbagai pengaturan di bagian Lanjutan."

#: lib/ptxprint/runjob.py:87
msgid "Oops! Something unexpected happened causing this unhandled error.\n"
"Try using the 'Tidy Up' button on the Help tab and then try again.\n"
"If you are still unable to proceed, use the 'Create Archive...' button\n"
"on the Help tab to create a .zip file. Send it to your PTXprint support person\n"
"for further assistance. Please include a description of the problem, and if\n"
"known, state which setting was changed since it last worked."
msgstr "Sesuatu yang tidak terduga telah menyebabkan kesalahan yang tidak tertangani ini.\n"
"Coba gunakan tombol 'Rapikan' pada tab Bantuan lalu coba lagi. Jika Anda \n"
"masih tidak dapat melanjutkan, gunakan tombol 'Buat Arsip...' pada tab Bantuan \n"
"untuk membuat file .zip, lalu kirim file itu ke petugas dukungan PTXprint Anda\n"
"untuk bantuan selanjutnya. Harap sertakan deskripsi masalahnya, dan jika\n"
"diketahui, beritahu pengaturan mana yang diubah sejak terakhir kali berfungsi."

