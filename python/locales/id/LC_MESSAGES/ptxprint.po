msgstr "Apakah sebuah kitab harus dimulai pada halaman baru, pada halaman yang sama dengan kitab sebelumnya (jika kurang dari 65% halaman telah digunakan), atau pada halaman ganjil"

#: lib/ptxprint/texpert.py:36
msgid "Page full factor"
msgstr "Faktor penuh halaman"

#: lib/ptxprint/texpert.py:37
msgid "This setting is related to how full a page needs to be to force the next book to start on a new page."
msgstr "Pengaturan ini terkait dengan seberapa penuh halaman yang diperlukan untuk memaksa buku berikutnya untuk memulai pada halaman baru."

#: lib/ptxprint/texpert.py:40
msgid "No page breaks"
msgstr "Tanpa pemutus halaman"

#: lib/ptxprint/texpert.py:40
msgid "On an odd page"
msgstr "Pada halaman ganjil"

#: lib/ptxprint/texpert.py:40
msgid "Grouped"
msgstr "Dikelompokkan"

#: lib/ptxprint/texpert.py:41
msgid "Where to start a new intro page"
msgstr "Di mana halaman pendahuluan harus dimulai"

#: lib/ptxprint/texpert.py:41
msgid "Does an intro page start on a new page, the same page as the previous book, an odd page, or group all adjacent intro pages into an odd paged group"
msgstr "Apakah halaman pendahuluan harus dimulai pada halaman baru, pada halaman yang sama dengan kitab sebelumnya, pada halaman ganjil, atau harus mengelompokkan semua halaman pendahuluan yang berdekatan ke dalam kelompok yang dimulai pada halaman ganjil"

#: lib/ptxprint/texpert.py:42
msgid "Unbalanced Lines (Max)"
msgstr "Garis Tidak Seimbang (Maks)"

#: lib/ptxprint/texpert.py:43
msgid "Maximum number of unbalanced lines allowed in 2-column layout. Recommended range 1-5."
msgstr "Jumlah maksimum baris tidak seimbang yang diperbolehkan dalam tata letak 2 kolom. Kisaran yang disarankan 1-5."

#: lib/ptxprint/texpert.py:44
msgid "Variable line spacing maximum stretch"
msgstr ""

#: lib/ptxprint/texpert.py:45
msgid "Maximum stretch to insert between lines in variable line spacing in pts"
msgstr ""

#: lib/ptxprint/texpert.py:46
msgid "Variable line spacing maximum shrink"
msgstr ""

#: lib/ptxprint/texpert.py:47
msgid "Maximum shrink to insert between lines in variable line spacing in pts"
msgstr ""

#: lib/ptxprint/texpert.py:48
msgid "No Top Space"
msgstr "Tidak Ada Ruang Atas"

#: lib/ptxprint/texpert.py:49
msgid "Don’t insert space above headings at the start of a column"
msgstr "Jangan menyisipkan ruang kosong di atas judul di awal kolom"

#: lib/ptxprint/texpert.py:50
msgid "Suppress pagebreak after bookend-final"
msgstr "Menekan jeda halaman setelah akhir buku"

#: lib/ptxprint/texpert.py:51
msgid "Revert to old behaviour of not ensuring that the whole of the last book is output before back-matter PDFs"
msgstr "Kembali ke perilaku lama yang tidak memastikan bahwa seluruh buku terakhir dikeluarkan sebelum PDF materi belakang"

#: lib/ptxprint/texpert.py:52
msgid "Noteline offset (mm)"
msgstr "Pergeseran titik (mm) (mm)"

#: lib/ptxprint/texpert.py:53
msgid "Gap (mm) between noteline and text"
msgstr "Celah (mm) antara garis tepi dan teks"

#: lib/ptxprint/texpert.py:54
msgid "Noteline margin (mm)"
msgstr "Margin garis tepi (mm)"

#: lib/ptxprint/texpert.py:55
msgid "Gap (mm) between noteline and edge of page"
msgstr "Celah (mm) antara garis tepi dan tepi halaman"

#: lib/ptxprint/texpert.py:57 lib/ptxprint/texpert.py:115
#: lib/ptxprint/texpert.py:118
msgid "Solid line"
msgstr "Garis padat"

#: lib/ptxprint/texpert.py:57 lib/ptxprint/texpert.py:115
#: lib/ptxprint/texpert.py:118
msgid "Row of dots"
msgstr "Deretan titik"

#: lib/ptxprint/texpert.py:58
msgid "Noteline type"
msgstr "Tipe Noteline"

#: lib/ptxprint/texpert.py:58
msgid "Sometimes it is preferable to use a series of dots rather than a solid line."
msgstr "Kadang-kadang, lebih baik menggunakan serangkaian titik daripada garis padat."

#: lib/ptxprint/texpert.py:59
msgid "Noteline spacing (mm)"
msgstr "Jarak antar titik (mm)"

#: lib/ptxprint/texpert.py:60
msgid "Line spacing between notelines. When set to 0.00 the default line spacing of the document is used."
msgstr "Spasi baris di antara garis catatan. Bila diatur ke 0,00, maka spasi baris default dari dokumen akan digunakan."

#: lib/ptxprint/texpert.py:61
msgid "Noteline width (major)"
msgstr "Lebar garis utama (mayor)"

#: lib/ptxprint/texpert.py:62
msgid "Thickness (pt) of major notelines. Specify the colour on the Layout page."
msgstr "Ketebalan garis-garis utama (ukuran point). Tentukan warna pada halaman Tata Letak."

#: lib/ptxprint/texpert.py:68
msgid "Double Sided Layout"
msgstr ""

#: lib/ptxprint/texpert.py:69
msgid "This setting can be disabled to turn off inner/outer margins, forcing the inner/outer gutter, and Notelines to always appear on the same side of the printed page."
msgstr ""

