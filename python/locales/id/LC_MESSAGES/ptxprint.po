"0.95 =   95% = shrink text\n"
"1.05 = 105% = expand text"
msgstr "Bentuk karakter dapat dibesarkan atau \n"
"dikecilkan untuk menempati lebih banyak \n"
"atau lebih sedikit ruang horisontal.\n"
"1,00 = 100% = biasa\n"
"0,95 = 95% = mengecilkan teks\n"
"1,05 = 105% = membesarkan teks"

