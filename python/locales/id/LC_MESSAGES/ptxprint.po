#: lib/ptxprint/scriptsnippets.py:172
msgid "First verse on left"
msgstr "Ayat pertama di sebelah kiri"

#: lib/ptxprint/scriptsnippets.py:302
msgid "Enabling horizontal gridding"
msgstr "Aktifkan kisi horisontal"

#: lib/ptxprint/scriptsnippets.py:303
msgid "Align chapter numbers with grid and remove spaces before verses"
msgstr "Sejajarkan nomor pasal dengan kisi dan hapus spasi sebelum ayat"

#: lib/ptxprint/scriptsnippets.py:304
msgid "Automatic halfwidth punctuation pairs"
msgstr "Pasangan tanda baca setengah lebar otomatis"

#: lib/ptxprint/scriptsnippets.py:305
msgid "Adjust spacing of punctuation pairs so they take up a single full width character"
msgstr "Sesuaikan jarak pasangan tanda baca agar memakai satu karakter selebar penuh"

#: lib/ptxprint/scriptsnippets.py:92 lib/ptxprint/scriptsnippets.py:102
msgid "Syllable line breaking"
msgstr "Memutuskan baris di tengah kata"

#: lib/ptxprint/scriptsnippets.py:93
msgid "Show Hyphen"
msgstr "Tampilkan Tanda Hubung"

#: lib/ptxprint/texmodel.py:1022
msgid "If this error just appeared after upgrading then check whether the USFM markers like \\p and \\v used in changes.txt rules have been 'escaped' with an additional \\ (e.g. \\\\p and \\\\v) as is required by the latest version."
msgstr "Jika kesalahan ini baru saja muncul setelah peningkatan versi, periksalah apakah pemarkah USFM seperti \\p dan \\v yang digunakan dalam aturan di file changes.txt telah dikecualikan dengan tanda \\ yang ekstra (misalnya \\\\p dan \\\\v) seperti yang disyaratkan dalam versi terbaru."

#: lib/ptxprint/texmodel.py:1136
msgid "PTXprint [{}] - USFM Check Error!"
msgstr "PTXprint [{}] - Kesalahan Pemeriksaan USFM!"

#: lib/ptxprint/texmodel.py:1138
msgid "These errors were triggered when running canonical checks"
msgstr "Kesalahan ini muncul saat menjalankan pemeriksaan kanonik"

#: lib/ptxprint/texmodel.py:1139
msgid "Checking errors: "
msgstr "Kesalahan pemeriksaan: "

#: lib/ptxprint/texmodel.py:1223
msgid "PTXprint [{}] - USFM Text Error!"
msgstr "PTXprint [{}] - Kesalahan Teks USFM!"

#: lib/ptxprint/texmodel.py:1226
msgid "These errors were triggered while internally parsing the USFM"
msgstr "Kesalahan ini muncul saat memproses USFM secara internal"

#: lib/ptxprint/texmodel.py:1226
msgid " for "
msgstr " untuk "

#: lib/ptxprint/texmodel.py:1227
msgid "Parsing errors: "
msgstr "Kesalahan pemrosesan: "

#: lib/ptxprint/texmodel.py:1705
msgid "\\message{{Warning: No copyright statement found for: {} on pages {}}}"
msgstr "\\pesan{{Peringatan: Tidak ditemukan pernyataan hak cipta untuk: {} pada halaman {}}}"

#: lib/ptxprint/texmodel.py:481
msgid "Missing font ({})"
msgstr "Font tidak ada ({})"

#: lib/ptxprint/texpert.py:100
msgid "Penalty for a bad (but not impossible) place to break"
msgstr "Penalti untuk tempat yang buruk (tetapi bukan tidak mungkin) untuk memutuskan baris"

#: lib/ptxprint/texpert.py:101
msgid "Optional break penalty"
msgstr "Penalti istirahat opsional"

#: lib/ptxprint/texpert.py:102
msgid "Penalty for the optional break"
msgstr "Penalti untuk istirahat opsional"

#: lib/ptxprint/texpert.py:103
msgid "Hyphenation threshold"
msgstr "Ambang batas tanda hubung"

#: lib/ptxprint/texpert.py:104
msgid "Paragraph badness threshold before trying hyphenation. Set to -1 to always hyphenate"
msgstr "Ambang batas keburukan paragraf sebelum mencoba tanda hubung. Atur ke -1 untuk selalu memberi tanda hubung"

#: lib/ptxprint/texpert.py:105
msgid "Penalty for inserting hyphen"
msgstr "Penalti karena memasukkan tanda hubung"

#: lib/ptxprint/texpert.py:106
msgid "Hyphenation penalty"
msgstr "Penalti tanda hubung"

#: lib/ptxprint/texpert.py:107
msgid "Double hyphenation penalty"
msgstr "Penalti tanda hubung ganda"

#: lib/ptxprint/texpert.py:108
msgid "Penalty for consecutive hyphenation across two lines"
msgstr "Penalti untuk tanda hubung yang berurutan di dua baris"

#: lib/ptxprint/texpert.py:110
msgid "Use loc attrib on ref to make a link"
msgstr "Gunakan atribut loc pada ref untuk membuat tautan"

#: lib/ptxprint/texpert.py:111
msgid "The ref character style can include an attribute like loc=\"GEN 1:2\". Should this be used to make a clickable link?"
msgstr "Gaya karakter ref dapat menyertakan atribut seperti loc=\"GEN 1:2\". Apakah atribut ini akan digunakan untuk membuat tautan yang dapat diklik?"

#: lib/ptxprint/texpert.py:112
msgid "Use href-link attrib on jmp to make a link"
msgstr "Gunakan atribut href-link pada jmp untuk membuat tautan"

#: lib/ptxprint/texpert.py:113
msgid "The jmp character style can include an attribute like href-link=\"https://my.web.site/\". Should this be used to make a clickable link?"
msgstr "Gaya karakter jmp dapat menyertakan atribut seperti href-link=\"https://my.web.site/\". Apakah atribut ini akan digunakan untuk membuat tautan yang dapat diklik?"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Underline only"
msgstr "Garis bawah saja"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "No line"
msgstr "Tanpa garis"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Dashed line"
msgstr "Garis putus-putus"

#: lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Viewer default"
msgstr "Standar penampil"

#: lib/ptxprint/texpert.py:116
msgid "Box style for URL links"
msgstr "Gaya kotak untuk tautan URL"

#: lib/ptxprint/texpert.py:116
msgid "Active web links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\URLLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "Tautan web aktif di file PDF ditandai dengan kotak (garis solid, putus-putus, atau titik-titik) atau garis bawah. Penampil PDF Anda mungkin memiliki pengaturan standar. Atur warnanya dengan \\def\\URLLinkBorderCol{0.9 0.5 0.5} atau yang serupa di ptxprint-mods.tex."

#: lib/ptxprint/texpert.py:119
msgid "Box style for GOTO links"
msgstr "Gaya kotak untuk tautan GOTO"

#: lib/ptxprint/texpert.py:119
msgid "Active internal links in PDFs are marked by either a box (solid, dashed or dotted line) or an underline. Your viewer probably has a default setting. Set the colour with \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} or similar in ptxprint-mods.tex."
msgstr "Tautan internal aktif di file PDF ditandai dengan kotak (garis solid, putus-putus, atau titik-titik) atau garis bawah. Penampil PDF Anda mungkin memiliki pengaturan standar. Atur warnanya dengan \\def\\GOTOLinkBorderCol{0.9 0.5 0.5} atau yang serupa di ptxprint-mods.tex."

#: lib/ptxprint/texpert.py:120
msgid "Use glyph metrics"
msgstr "Gunakan ukuran glif"

#: lib/ptxprint/texpert.py:121
msgid "PTXprint can use either the actual glyph metrics in a line or the font metrics to calculate line heights and depths. Font metrics gives more consistent results."
msgstr "PTXprint dapat menggunakan metrik mesin terbang yang sebenarnya dalam sebuah garis atau metrik font untuk menghitung tinggi dan kedalaman garis. Metrik font memberikan hasil yang lebih konsisten."

#: lib/ptxprint/texpert.py:123
msgid "Use system fonts"
msgstr "Gunakan font sistem"

#: lib/ptxprint/texpert.py:124
msgid "Use fonts from your system as well as your project. Note that you need to restart PTXprint for this setting to take effect."
msgstr "Gunakan font dari sistem Anda selain dari proyek Anda. Perhatikan bahwa Anda perlu memulai ulang PTXprint agar pengaturan ini berlaku."

#: lib/ptxprint/texpert.py:125
msgid "Underline thickness (em)"
msgstr "Ketebalan garis bawah (em)"

#: lib/ptxprint/texpert.py:126
msgid "This sets the thickness of the text underline, (measured in ems)."
msgstr "Ini menetapkan ketebalan garis bawah teks, (diukur dalam ems)."

#: lib/ptxprint/texpert.py:128
msgid "Underline vertical position (em)"
msgstr "Garis bawahi posisi vertikal (em)"

#: lib/ptxprint/texpert.py:129
msgid "This sets how far (in ems) the underline is below the text and what it is relative to. If negative, it is the distance below the baseline. If positive (or zero), it is the distance below the bottom of any descenders."
msgstr "Ini menetapkan seberapa jauh (dalam ems) garis bawah berada di bawah teks dan apa yang relatif terhadapnya. Jika negatif, ini adalah jarak di bawah garis dasar. Jika positif (atau nol), ini adalah jarak di bawah bagian bawah descender."

#: lib/ptxprint/texpert.py:131
msgid "Underline Spaces"
msgstr "Garisbawahi Spasi"

#: lib/ptxprint/texpert.py:132
msgid "Underline spaces in underlined runs"
msgstr "Garisbawahi spasi pada baris yang digarisbawahi"

#: lib/ptxprint/texpert.py:133
msgid "Log font creation"
msgstr "Catat pembuatan font"

#: lib/ptxprint/texpert.py:134
msgid "Create <jobname>.fontusage in the local/ptxprint/<config>/ directory, which will list the page number and exact font definition when each new style is first used."
msgstr "Buat <jobname>.fontusage di direktori local/ptxprint/<config>/. File ini akan mencantumkan nomor halaman dan definisi font yang tepat saat setiap gaya baru pertama kali digunakan."

#: lib/ptxprint/texpert.py:136
msgid "Mid-Page Footnotes"
msgstr "Catatan Kaki di Tengah Halaman"

#: lib/ptxprint/texpert.py:137
msgid "Should footnotes go before a single-double column transition"
msgstr "Haruskah catatan kaki diletakkan sebelum transisi kolom tunggal-ganda"

#: lib/ptxprint/texpert.py:138
msgid "Final Page Notes Down"
msgstr "Catatan Halaman Terakhir Di Bawah"

#: lib/ptxprint/texpert.py:139
msgid "Push notes on the final page to the bottom of the page"
msgstr "Tempatkan catatan pada halaman terakhir di bagian bawah halaman"

#: lib/ptxprint/texpert.py:140
msgid "Reset Callers at Each Book"
msgstr "Atur Ulang Pemanggil pada Permulaan Setiap Kitab"

#: lib/ptxprint/texpert.py:141
msgid "Re-start the footnote and cross-reference callers at the start of each book"
msgstr "Memulai kembali pemanggil catatan kaki dan referensi silang di awal setiap kitab"

#: lib/ptxprint/texpert.py:142
msgid "Endnotes at Each Book"
msgstr "Catatan Akhir di Setiap Kitab"

#: lib/ptxprint/texpert.py:143
msgid "Output endnotes at the end of each book"
msgstr "Cetak catatan akhir di akhir setiap kitab"

#: lib/ptxprint/texpert.py:144
msgid "Enhanced paragraphed footnotes"
msgstr "Catatan kaki berbentuk paragraf"

#: lib/ptxprint/texpert.py:145
msgid "Paragraphed footnotes which allow \\fp to work and also the ifparnotes... controls below. Causes some spacing differences compared to old-style."
msgstr "Catatan kaki berbentuk paragraf yang memungkinkan \\fp berfungsi dan juga pengaturan ifparnotes... di bawah ini. Menyebabkan beberapa perbedaan jarak vertikal dibandingkan dengan gaya lama."

#: lib/ptxprint/texpert.py:146
msgid "Remove depth above paragraphed notes"
msgstr "Menghapus kedalaman di atas catatan berparagraf"

#: lib/ptxprint/texpert.py:147
msgid "Kern away (kill) the glyph/font depth of note types before paragraphed notes, using the value of \\prevdepth"
msgstr "Menghilangkan (mematikan) kedalaman jenis huruf/font pada jenis catatan sebelum catatan yang dipenggal, dengan menggunakan nilai \\prevdepth"

#: lib/ptxprint/texpert.py:148
msgid "Remove depth after paragraphed notes"
msgstr "Menghapus kedalaman setelah catatan berparagraf"

#: lib/ptxprint/texpert.py:149
msgid "Kill the depth of (the last row of) paragraphed note styles. Paragraphed notes will use the margin as their baseline."
msgstr "Menghilangkan kedalaman (baris terakhir dari) gaya catatan yang dipenggal. Catatan yang dipenggal akan menggunakan margin sebagai garis dasarnya."

#: lib/ptxprint/texpert.py:150
msgid "Use grid not font/glyph height at rule"
msgstr "Gunakan kisi, bukan tinggi font/ huruf pada aturan"

#: lib/ptxprint/texpert.py:151
msgid "If true, the footnote rule is positioned relative to the hypothetical baseline above the topmost footnote, rather than relative to the glyph/font height."
msgstr "Jika benar, aturan catatan kaki diposisikan relatif terhadap garis dasar hipotetis di atas catatan kaki paling atas, dan bukan relatif terhadap tinggi huruf/font."

#: lib/ptxprint/texpert.py:152
msgid "Use grid not font/glyph height between notes"
msgstr "Gunakan kisi-kisi, bukan tinggi huruf/font di antara catatan"

#: lib/ptxprint/texpert.py:153
msgid "If true, then the \\InterNoteSpace is relative to the hypothetical baseline above the topmost footnote, rather than the glyph/font height. \\InterNoteSpace is triggered between note styles."
msgstr "Jika benar, maka \\InterNoteSpace relatif terhadap garis dasar hipotetis di atas catatan kaki paling atas, dan bukannya tinggi mesin terbang/font. \\InterNoteSpace dipicu di antara gaya catatan."

#: lib/ptxprint/texpert.py:154
msgid "Use glyph height not font height in footnotes"
msgstr "Gunakan tinggi huruf, bukan tinggi font dalam catatan kaki"

#: lib/ptxprint/texpert.py:155
msgid "Does the note use the font's descender design parameter, or the actual bottom of the glyph. If the former (and depth is not killed), then the bottom of notes have a common baseline across pages. If the latter, then the glyphs sit as close to the bottom margin as they can, which may permit an extra line of text."
msgstr "Apakah catatan menggunakan parameter desain descender font, atau bagian bawah mesin terbang yang sebenarnya. Jika yang pertama (dan kedalaman tidak dimatikan), maka bagian bawah catatan memiliki garis dasar yang sama di seluruh halaman. Jika yang terakhir, maka mesin terbang akan berada sedekat mungkin dengan margin bawah, yang memungkinkan adanya baris teks tambahan."

#: lib/ptxprint/texpert.py:156
msgid "Last Note: interlinepenalty"
msgstr "Catatan Terakhir: interlinepenalti"

#: lib/ptxprint/texpert.py:157
msgid "Penalty for breaking between lines of the last footnote."
msgstr "Penalti untuk pemenggalan di antara baris-baris catatan kaki terakhir."

#: lib/ptxprint/texpert.py:158
msgid "Last Note: widowpenalty"
msgstr "Catatan Terakhir: hukuman janda"

#: lib/ptxprint/texpert.py:159
msgid "Extra penalty for breaking at the last line of the last footnote."
msgstr "Hukuman tambahan untuk pelanggaran pada baris terakhir dari catatan kaki terakhir."

#: lib/ptxprint/texpert.py:160
msgid "Last Note: clubpenalty"
msgstr "Catatan Terakhir: penalti klub"

#: lib/ptxprint/texpert.py:161
msgid "Extra penalty for breaking at the first line of the last footnote."
msgstr "Hukuman tambahan untuk pelanggaran pada baris pertama dari catatan kaki terakhir."

#: lib/ptxprint/texpert.py:162
msgid "Last Note: penalty at par"
msgstr "Catatan Terakhir: penalti pada par"

#: lib/ptxprint/texpert.py:163
msgid "Penalty for breaking at an explicit footnote-paragraph in the last footnote."
msgstr "Hukuman karena melanggar paragraf catatan kaki yang eksplisit di catatan kaki terakhir."

#: lib/ptxprint/texpert.py:164
msgid "Split notes: Shortest note to shave"
msgstr "Catatan terpisah: Nada terpendek untuk mencukur"

#: lib/ptxprint/texpert.py:165
msgid "If footnotes might be shaved, how many lines must it be?"
msgstr "Jika catatan kaki boleh dicukur, berapa banyak baris yang harus dibuat?"

#: lib/ptxprint/texpert.py:166
msgid "Split notes: min lines to move."
msgstr "Catatan terpisah: garis min untuk dipindahkan."

#: lib/ptxprint/texpert.py:167
msgid "If a footnote is being shaved (split onto next page), what is the minimum number of lines to move?"
msgstr "Jika catatan kaki sedang dicukur (dipisah ke halaman berikutnya), berapa jumlah minimum baris yang harus dipindahkan?"

#: lib/ptxprint/texpert.py:168
msgid "Split notes: note lines to stay"
msgstr "Catatan terpisah: baris catatan untuk tetap ada"

#: lib/ptxprint/texpert.py:169
msgid "If a footnote is being shaved (split onto next page), how many lines of (all) notes must remain on the page?"
msgstr "Jika catatan kaki sedang dicukur (dipisah ke halaman berikutnya), berapa baris (semua) catatan yang harus tetap ada pada halaman?"

#: lib/ptxprint/texpert.py:170
msgid "Study note factor-Single column"
msgstr "Faktor catatan studi-Kolom tunggal"

#: lib/ptxprint/texpert.py:171
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "Untuk menghindari siklus yang tidak perlu/halaman yang kurang terisi, berapa bagian dari perkiraan tinggi catatan studi yang harus diterapkan TeX saat mengumpulkan input dalam mode kolom tunggal? (100=10persen)"

#: lib/ptxprint/texpert.py:172
msgid "Study note factor-Two column"
msgstr "Faktor catatan studi-Dua kolom"

#: lib/ptxprint/texpert.py:173
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "Untuk menghindari siklus yang tidak perlu/halaman yang kurang terisi, berapa bagian dari perkiraan tinggi catatan studi yang harus diterapkan TeX saat mengumpulkan input dalam mode dua kolom? (100=10persen)"

#: lib/ptxprint/texpert.py:174
msgid "Study note factor-Diglot"
msgstr "Faktor catatan studi-Diglot"

#: lib/ptxprint/texpert.py:175
msgid "To avoid needless cycles/underfull pages, what portion of a study note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "Untuk menghindari siklus yang tidak perlu/halaman yang kurang terisi, berapa bagian dari perkiraan tinggi catatan studi yang harus diterapkan TeX saat mengumpulkan input Dua Bahasa? (100=10persen)"

#: lib/ptxprint/texpert.py:176
msgid "Footnote factor-Single column"
msgstr "Faktor catatan kaki-Kolom tunggal"

#: lib/ptxprint/texpert.py:177
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering input in single-column mode? (100=10percent)"
msgstr "Untuk menghindari siklus yang tidak perlu/halaman yang kurang terisi, berapa bagian dari perkiraan tinggi catatan yang harus diterapkan TeX saat mengumpulkan input dalam mode kolom tunggal? (100=10persen)"

#: lib/ptxprint/texpert.py:178
msgid "Footnote factor-Two column"
msgstr "Faktor catatan kaki-Dua kolom"

#: lib/ptxprint/texpert.py:179
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering input in two-column mode? (100=10percent)"
msgstr "Untuk menghindari siklus yang tidak perlu/halaman yang kurang terisi, berapa bagian dari perkiraan tinggi catatan yang harus diterapkan TeX saat mengumpulkan input dalam mode dua kolom? (100=10persen)"

#: lib/ptxprint/texpert.py:180
msgid "Footnote factor-Diglot"
msgstr "Faktor catatan kaki-Diglot"

#: lib/ptxprint/texpert.py:181
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering diglot input? (100=10percent)"
msgstr "Untuk menghindari siklus yang tidak perlu/halaman yang kurang terisi, berapa bagian dari perkiraan tinggi catatan yang harus diterapkan TeX saat mengumpulkan input Dua Bahasa? (100=10persen)"

#: lib/ptxprint/texpert.py:182
msgid "Footnote factor-Centre column"
msgstr "Faktor catatan kaki-Kolom tengah"

#: lib/ptxprint/texpert.py:183
msgid "To avoid needless cycles/underfull pages, what portion of a note's height-estimate should TeX apply when gathering centre-column notes? (100=10percent)"
msgstr "Untuk menghindari siklus yang tidak perlu/halaman yang kurang terisi, berapa bagian dari perkiraan tinggi catatan yang harus diterapkan TeX saat mengumpulkan catatan kolom tengah? (100=10persen)"

#: lib/ptxprint/texpert.py:184
msgid "Distance of margin notes from text"
msgstr "Jarak catatan tepi dari teks"

#: lib/ptxprint/texpert.py:185
msgid "The size of the gap between the margin notes and the text"
msgstr "Ukuran jarak antara catatan tepi dan teks"

#: lib/ptxprint/texpert.py:187
msgid "Balance diglot/polyglot notes"
msgstr "Seimbangkan catatan diglot/poliglot"

#: lib/ptxprint/texpert.py:188
msgid "When there's a note on column R (for example), does that reduce the space from other columns?"
msgstr "Jika ada catatan pada kolom R (misalnya), apakah itu mengurangi ruang pada kolom lainnya?"

#: lib/ptxprint/texpert.py:189
msgid "Diglot/polyglot merged paragraphed notes are RTL"
msgstr "Catatan paragraf gabungan diglot/poliglot berarah RTL"

#: lib/ptxprint/texpert.py:190
msgid "When merged notes are not shown as individual paragraphs, the result must be arranged as though RTL or LTR (however the individual notes are structured). This defines the paragraph alignment."
msgstr "Jika catatan gabungan tidak ditampilkan sebagai paragraf terpisah, hasilnya harus ditata seolah-olah RTL atau LTR (sesuai struktur catatan masing-masing). Ini menentukan perataan paragraf."

#: lib/ptxprint/texpert.py:191
msgid "Adjust Versification of Projects"
msgstr "Sesuaikan Versifikasi Proyek"

#: lib/ptxprint/texpert.py:192
msgid "If versification differs between projects, adjust diglot/polyglot projects to match the primary (L) project."
msgstr "Jika versifikasi berbeda antarproyek, sesuaikan proyek diglot/poliglot agar cocok dengan proyek utama (L)."

#: lib/ptxprint/texpert.py:193
msgid "Keep existing verse numbers (as \\vp)"
msgstr "Pertahankan nomor ayat yang sudah ada (sebagai \\vp)"

#: lib/ptxprint/texpert.py:194
msgid "When adjusting versification, show the original verse numbers in their new (adjusted) location."
msgstr "Saat menyesuaikan versifikasi, tampilkan nomor ayat asli di lokasi barunya (yang sudah disesuaikan)."

#: lib/ptxprint/texpert.py:195
msgid "Show old chapter numbers if changed (in \\vp)"
msgstr "Tampilkan nomor pasal lama jika berubah (dalam \\vp)"

#: lib/ptxprint/texpert.py:196
msgid "When adjusting versification, show the adjusted chapter numbers (only) if they have changed."
msgstr "Saat menyesuaikan versifikasi, tampilkan nomor pasal yang sudah disesuaikan (saja) jika berubah."

#: lib/ptxprint/texpert.py:197
msgid "Show Diglot Trace Marks"
msgstr "Tampilkan Tanda Jejak Diglot"

#: lib/ptxprint/texpert.py:198
msgid "Insert visible trace marks in diglot output"
msgstr "Menyisipkan tanda jejak yang terlihat dalam output diglot"

#: lib/ptxprint/texpert.py:199
msgid "Extra Trace Mark Info"
msgstr "Info Tanda Jejak Ekstra"

#: lib/ptxprint/texpert.py:200
msgid "Add extra information to diglot trace marks. (debugging only - can alter layout)"
msgstr "Tambahkan informasi tambahan ke tanda jejak diglot. (hanya untuk debugging - dapat mengubah tata letak)"

#: lib/ptxprint/texpert.py:201
msgid "Diglot Shading Padding"
msgstr "Bantalan Peneduh Diglot"

#: lib/ptxprint/texpert.py:202
msgid "The amount of side padding (pt) on the shaded background of a diglot"
msgstr "Jumlah bantalan sisi (pt) pada latar belakang yang diarsir pada diglot"

#: lib/ptxprint/texpert.py:204
msgid "Borders start at body text"
msgstr "Bingkai dimulai dari teks isi"

#: lib/ptxprint/texpert.py:204
msgid "Borders include book intros"
msgstr "Bingkai menyertakan pengantar kitab"

#: lib/ptxprint/texpert.py:204
msgid "Wide book intros for per-column textborders"
msgstr "Pengantar kitab selebar halaman untuk bingkai teks per kolom"

#: lib/ptxprint/texpert.py:205
msgid "How does text-border behave in diglots?"
msgstr "Bagaimana cara kerja bingkai teks pada diglot?"

#: lib/ptxprint/texpert.py:205
msgid "Historically, diglot text-borders put the border around book introductions. This control allows that (substandard) behaviour to be chosen, and also allows  experimental code to make books with per-column textborders use full-width text for introductory text."
msgstr "Secara historis, bingkai teks diglot dipasang di sekeliling pengantar kitab. Kontrol ini memungkinkan perilaku tersebut (yang kurang baik) dipilih. Kontrol ini juga memungkinkan kode eksperimental membuat kitab dengan bingkai teks per kolom memakai teks selebar penuh untuk teks pengantar."

#: lib/ptxprint/texpert.py:206
msgid "Unprintable page recovery."
msgstr "Pemulihan halaman yang tidak dapat dicetak."

#: lib/ptxprint/texpert.py:207
msgid "If notes / figures make a page unprintable: -1: immediately stop; 0: print failed contents and try to struggle on; >0 grow page height by up to N lines."
msgstr "Jika catatan / gambar membuat halaman tidak dapat dicetak: -1: langsung berhenti; 0: cetak isi yang gagal dan coba lanjutkan; >0 tambah tinggi halaman hingga N baris."

#: lib/ptxprint/texpert.py:208
msgid "1xBiggest baseline"
msgstr "1x garis dasar terbesar"

#: lib/ptxprint/texpert.py:208
msgid "2xSmallest baseline"
msgstr "2x garis dasar terkecil"

#: lib/ptxprint/texpert.py:208
msgid "2xBiggest baseline"
msgstr "2x garis dasar terbesar"

#: lib/ptxprint/texpert.py:208
msgid "3xSmallest baseline"
msgstr "3x garis dasar terkecil"

#: lib/ptxprint/texpert.py:208
msgid "Page-full test."
msgstr "Uji halaman penuh."

#: lib/ptxprint/texpert.py:209
msgid "When a (non-title) chunk has finished, the amount of unused space below which diglot will immediately output a page,  rather than trying to fit the next chunk. (irrespective of how short it is). Higher values encourage underfilled pages, but can prevent orphaning of the 1st line of poetry."
msgstr "Setelah satu bagian (bukan judul) selesai, jika ruang kosong yang tersisa kurang dari jumlah ini, diglot langsung menghasilkan satu halaman dan tidak mencoba memuat bagian berikutnya (sependek apa pun bagian itu). Nilai yang lebih tinggi menghasilkan halaman yang kurang terisi, tetapi dapat mencegah baris pertama puisi terpisah sendiri."

#: lib/ptxprint/texpert.py:210
msgid "Default Figures Top Left"
msgstr "Gambar Kiri Atas"

#: lib/ptxprint/texpert.py:211
msgid "Default figure positions to top left"
msgstr "Posisi standard untuk gambar ke kiri atas"

#: lib/ptxprint/texpert.py:212
msgid "Ref Before Caption"
msgstr "Referensi Sebelum Keterangan"

#: lib/ptxprint/texpert.py:213
msgid "Output reference before caption"
msgstr "Cetak referensi sebelum keterangan gambar"

#: lib/ptxprint/texpert.py:214
msgid "Show Caption Before Image"
msgstr "Tampilkan Keterangan Sebelum Gambar"

#: lib/ptxprint/texpert.py:215
msgid "Output caption before image"
msgstr "Cetak keterangan sebelum gambar"

#: lib/ptxprint/texpert.py:216
msgid "Space (pt) beside cutout/sidebar"
msgstr "Spasi (pt) di samping potongan/bilah samping"

#: lib/ptxprint/texpert.py:217
msgid "This sets the default gap (pt) between the body text and the side of a figure/sidebar in a cutout."
msgstr "Ini menetapkan jarak default (pt) antara teks tubuh dan sisi gambar/bilah samping dalam potongan."

#: lib/ptxprint/texpert.py:218
msgid "Space between picture & caption"
msgstr "Ruang di antara gambar & keterangan"

#: lib/ptxprint/texpert.py:219
msgid "Increase/Reduce the gap between figures and their captions"
msgstr "Tambah/kurangi jarak antara gambar dan keterangannya"

#: lib/ptxprint/texpert.py:220
msgid "Default space beside picture"
msgstr "Ruang standar di samping gambar"

#: lib/ptxprint/texpert.py:221
msgid "Picture horizontal margin*2"
msgstr "Gambar margin horizontal*2"

#: lib/ptxprint/texpert.py:222
msgid "Show comprehensive illustration credits"
msgstr "Tampilkan kredit ilustrasi secara lengkap"

#: lib/ptxprint/texpert.py:223
msgid "Instead of using the catch-all phrasing 'All other illustrations by...' show a comprehensive list of every artist and all pages that contain their illustrations."
msgstr "Alih-alih memakai ungkapan umum 'Semua ilustrasi lainnya oleh...', tampilkan daftar lengkap setiap seniman beserta semua halaman yang memuat ilustrasi mereka."

#: lib/ptxprint/texpert.py:225
msgid "No PDF Bookmarks"
msgstr "Tidak Ada Penunjuk Halaman PDF"

#: lib/ptxprint/texpert.py:226
msgid "Don’t output PDF bookmarks"
msgstr "Jangan mengeluarkan penunjuk halaman PDF"

#: lib/ptxprint/texpert.py:227
msgid "Allow Active Links in PDF"
msgstr "Izinkan Tautan Aktif di PDF"

#: lib/ptxprint/texpert.py:228
msgid "Make links active inside PDF"
msgstr "Buat tautan aktif di dalam PDF"

#: lib/ptxprint/texpert.py:229
msgid "Use Book Codes in PDF Bookmarks"
msgstr "Gunakan Kode Kitab di Penunjuk Halaman PDF"

#: lib/ptxprint/texpert.py:230
msgid "Use book codes instead of book names in bookmarks"
msgstr "Gunakan kode kitab di penunjuk halaman, bukan nama kitab"

#: lib/ptxprint/texpert.py:231
msgid "Disable Transparency in PDF"
msgstr "Nonaktifkan Transparansi dalam PDF"

#: lib/ptxprint/texpert.py:232
msgid "Disable transparency output in PDF"
msgstr "Menonaktifkan output transparansi dalam PDF"

#: lib/ptxprint/texpert.py:233
msgid "Show adjust points"
msgstr "Tampilkan Titik Penyesuaian"

#: lib/ptxprint/texpert.py:234
msgid "Show adjust points in the margin of the text."
msgstr "Tampilkan titik penyesuaian di margin teks."

#: lib/ptxprint/texpert.py:235
msgid "Mark Trigger Points"
msgstr "Tandai Titik Pemicu"

#: lib/ptxprint/texpert.py:236
msgid "Display trigger points in output"
msgstr "Tampilkan titik pemicu dalam hasil"

#: lib/ptxprint/texpert.py:237
msgid "Show USFM codes"
msgstr "Tampilkan kode USFM"

#: lib/ptxprint/texpert.py:238
msgid "Show the USFM markers in the margin beside paragraphs."
msgstr "Tampilkan penanda USFM di tepi halaman di samping paragraf."

#: lib/ptxprint/texpert.py:239
msgid "Show Error Bars For Overfull Lines"
msgstr "Tampilkan Tanda Kesalahan untuk Baris yang Terlalu Panjang"

#: lib/ptxprint/texpert.py:240
msgid "Enable this option to have TeX make overfull lines stand out."
msgstr "Aktifkan opsi ini untuk membuat TeX menyorot baris yang terlalu panjang."

#: lib/ptxprint/texpert.py:243
msgid "Spine Overlap onto Back Cover (mm)"
msgstr "Tumpang Tindih Jilid ke Sampul Belakang (mm)"

#: lib/ptxprint/texpert.py:244
msgid "If you want the spine graphic or colour to spill over onto the back cover page, then set the amount of overlap here."
msgstr "Jika Anda ingin grafik atau warna jilid meluas ke halaman sampul belakang, atur jumlah tumpang tindihnya di sini."

#: lib/ptxprint/texpert.py:246
msgid "Spine Overlap onto Front Cover (mm)"
msgstr "Tumpang Tindih Jilid ke Sampul Depan (mm)"

#: lib/ptxprint/texpert.py:247
msgid "If you want the spine graphic or colour to spill over onto the front cover page, then set the amount of overlap here."
msgstr "Jika Anda ingin grafik atau warna jilid meluas ke halaman sampul depan, atur besar tumpang tindihnya di sini."

#: lib/ptxprint/texpert.py:249
msgid "Cover Bleed (mm)"
msgstr "Bleed Sampul (mm)"

#: lib/ptxprint/texpert.py:250
msgid "Bleed is the section of artwork that goes beyond where the paper is cut. This ensures that the image goes right to the edge of the cover after it has been trimmed."
msgstr "Bleed adalah bagian karya seni yang melampaui tempat kertas dipotong. Ini memastikan gambar sampai tepat ke tepi sampul setelah dipotong."

#: lib/ptxprint/texpert.py:252
msgid "Hard Cover Art Bleed (mm)"
msgstr "Art Bleed Sampul Keras (mm)"

#: lib/ptxprint/texpert.py:253
msgid "Art Bleed is specifically for hard cover binding and is the setting which enables images to go beyond the size of the cover in order to wrap around the hard cover and stuck down under the inner backing sheet."
msgstr "Art Bleed khusus untuk penjilidan sampul keras. Pengaturan ini memungkinkan gambar melampaui ukuran sampul agar dapat membungkus sampul keras dan direkatkan di bawah lembar pelapis bagian dalam."

#: lib/ptxprint/texpert.py:258
msgid "Auto-update Delay (seconds)"
msgstr "Penundaan Pembaruan Otomatis (detik)"

#: lib/ptxprint/texpert.py:259
msgid "Right-clicking again on the PDF within this time (3 second default) will prevent the Auto-update from running."
msgstr "Mengklik kanan lagi pada PDF dalam waktu ini (default 3 detik) akan mencegah Pembaruan Otomatis berjalan."

#: lib/ptxprint/texpert.py:260
msgid "Shrink Text Step Value (%)"
msgstr "Mengecilkan Nilai Langkah Teks (%)"

#: lib/ptxprint/texpert.py:261
msgid "Step Value to shrink text using right-click context menu adjustment."
msgstr "Langkah Nilai untuk mengecilkan teks menggunakan penyesuaian menu konteks klik kanan."

#: lib/ptxprint/texpert.py:262
msgid "Minimum Text Shrink (%)"
msgstr "Penyusutan Teks Minimum (%)"

#: lib/ptxprint/texpert.py:263
msgid "Limit how much text can shrink to using right-click context menu adjustment."
msgstr "Batasi jumlah teks yang dapat diperkecil menggunakan penyesuaian menu konteks klik kanan."

#: lib/ptxprint/texpert.py:264
msgid "Expand Text Step Value (%)"
msgstr "Memperluas Nilai Langkah Teks (%)"

#: lib/ptxprint/texpert.py:265
msgid "Step Value to expand text using right-click context menu adjustment."
msgstr "Langkah Nilai untuk memperluas teks menggunakan penyesuaian menu konteks klik kanan."

#: lib/ptxprint/texpert.py:266
msgid "Maximum Text Expand (%)"
msgstr "Perluasan Teks Maksimum (%)"

#: lib/ptxprint/texpert.py:267
msgid "Limit how much text can expand to using right-click context menu adjustment."
msgstr "Batasi berapa banyak teks yang dapat diperluas menggunakan penyesuaian menu konteks klik kanan."

#: lib/ptxprint/texpert.py:268
msgid "Bad Space minimum width (em)"
msgstr "Lebar minimum Ruang Buruk (em)"

#: lib/ptxprint/texpert.py:269
msgid "Minimum width for a bad space. 0 says to calculate for the 20 worst spaces in the doc"
msgstr "Lebar minimum untuk ruang buruk. Angka 0 berarti dihitung dari 20 ruang terburuk dalam dokumen."

#: lib/ptxprint/texpert.py:270
msgid "Bad intercharacter space minimum width (em)"
msgstr "Lebar minimum ruang antarkarakter yang buruk (em)"

#: lib/ptxprint/texpert.py:271
msgid "Minimum width for a bad inter character space."
msgstr "Lebar minimum untuk ruang antarkarakter yang buruk."

#: lib/ptxprint/texpert.py:272
msgid "Precise collisions"
msgstr "Tabrakan presisi"

#: lib/ptxprint/texpert.py:273
msgid "Only show precise collisions between glyphs rather than overlapping bounding boxes - slow"
msgstr "Hanya tampilkan tabrakan presisi antar-glif, bukan kotak pembatas yang saling tumpang tindih - lambat"

#: lib/ptxprint/texpert.py:274
msgid "Collision Detection Padding (pt)"
msgstr "Penambahan Ruang Deteksi Tabrakan (pt)"

#: lib/ptxprint/texpert.py:275
msgid "Minimum space between bounding boxes of glyphs before a collision is flagged."
msgstr "Jarak minimum antara kotak pembatas glif sebelum tabrakan ditandai."

#: lib/ptxprint/texpert.py:276
msgid "River Detection Threshold (em)"
msgstr "Ambang Deteksi Aliran Putih (em)"

#: lib/ptxprint/texpert.py:277
msgid "The sum of all the widths in the river must be above this for the river to be detected"
msgstr "Jumlah semua lebar dalam aliran putih harus melebihi nilai ini agar aliran putih terdeteksi."

#: lib/ptxprint/texpert.py:278
msgid "River Detection minimum required maximum width (em)"
msgstr "Lebar maksimum minimum yang diperlukan untuk Deteksi Aliran Putih (em)"

#: lib/ptxprint/texpert.py:279
msgid "Minimum width required for the widest part of the river"
msgstr "Lebar minimum yang diperlukan untuk bagian terlebar dari aliran putih."

#: lib/ptxprint/texpert.py:28
msgid "Maximum layout version"
msgstr "Versi tata letak maksimum"

#: lib/ptxprint/texpert.py:280
msgid "River Detection minimum width (em)"
msgstr "Lebar minimum Deteksi Aliran Putih (em)"

#: lib/ptxprint/texpert.py:281
msgid "Minimum width of any space in a river for it to be included"
msgstr "Lebar minimum setiap ruang dalam aliran putih agar disertakan."

#: lib/ptxprint/texpert.py:282
msgid "River Detection maximum line leading (em)"
msgstr "Jarak baris maksimum Deteksi Aliran Putih (em)"

#: lib/ptxprint/texpert.py:283
msgid "Any lines separated by a gap greater than this will be considered not to be in the same river"
msgstr "Baris-baris yang dipisahkan oleh celah lebih besar dari nilai ini dianggap tidak berada dalam aliran putih (river) yang sama"

#: lib/ptxprint/texpert.py:284
msgid "River Detection minimum overlap (em)"
msgstr "Deteksi River: tumpang tindih minimum (em)"

#: lib/ptxprint/texpert.py:285
msgid "Minimum overlap in ems required for two spaces above each other to be considered part of the same river"
msgstr "Tumpang tindih minimum dalam em yang diperlukan agar dua spasi yang berada di atas satu sama lain dianggap bagian dari river yang sama"

#: lib/ptxprint/texpert.py:29
msgid "Maximum layout version to use or 0 for any. Used to maintain backward compatibility when the TeX macros have been changed in newer versions of PTXprint."
msgstr "Versi tata letak maksimum yang akan digunakan, atau 0 untuk semua versi. Pengaturan ini digunakan untuk mempertahankan kompatibilitas ke belakang apabila makro TeX telah diubah dalam versi PTXprint yang lebih baru."

#: lib/ptxprint/texpert.py:290
msgid "Time limit for the whole job (minutes)"
msgstr "Batas waktu untuk seluruh pekerjaan (menit)"

#: lib/ptxprint/texpert.py:291
msgid "The page filler works on all the books together. When this time is reached, the page filler stops. A book that is not finished keeps the pages that are already filled. Usually this affects only the longest book.\n"
"Higher: more time to find a good layout for every page."
msgstr "Pengisi halaman bekerja pada semua kitab sekaligus. Saat batas waktu ini tercapai, pengisi halaman berhenti. Kitab yang belum selesai tetap memakai halaman yang sudah terisi. Biasanya ini hanya memengaruhi kitab yang paling panjang.\n"
"Lebih tinggi: lebih banyak waktu untuk menemukan tata letak yang baik bagi setiap halaman."

#: lib/ptxprint/texpert.py:295
msgid "Earlier pages to retry"
msgstr "Halaman sebelumnya yang dicoba ulang"

#: lib/ptxprint/texpert.py:296
msgid "If the page filler cannot fill a page, it backtracks to the page before and tries a different layout there. This is the largest number of pages it can backtrack.\n"
"Higher: fewer failed pages, but much slower.\n"
"Lower: faster, but more pages may fail. 0 = never backtrack (fastest).\n"
"Affects: Speed."
msgstr "Jika pengisi halaman tidak dapat mengisi sebuah halaman, ia mundur ke halaman sebelumnya dan mencoba tata letak yang berbeda di sana. Ini adalah jumlah halaman terbanyak yang dapat dimundurkan.\n"
"Lebih tinggi: lebih sedikit halaman gagal, tetapi jauh lebih lambat.\n"
"Lebih rendah: lebih cepat, tetapi lebih banyak halaman bisa gagal. 0 = tidak pernah mundur (tercepat).\n"
"Memengaruhi: Kecepatan."

#: lib/ptxprint/texpert.py:30
msgid "Legacy 1/14 LineSpacing"
msgstr "Jarak Baris 1/14 (standar lama)"

#: lib/ptxprint/texpert.py:301
msgid "Paragraphs to adjust on each page"
msgstr "Paragraf yang disesuaikan pada setiap halaman"

#: lib/ptxprint/texpert.py:302
msgid "The largest number of paragraphs on one page that the page filler may stretch or shrink. Each poetry line (\\q1, \\q2 …) counts as one paragraph. Each extra paragraph doubles the number of layouts the page filler tries.\n"
"Higher: more ways to fill each page, so fewer failed pages, but each page takes longer.\n"
"Lower: faster, but more pages may fail.\n"
"Affects: Speed."
msgstr "Jumlah paragraf terbanyak pada satu halaman yang boleh diregangkan atau dikecilkan oleh pengisi halaman. Setiap baris puisi (\\q1, \\q2 …) dihitung sebagai satu paragraf. Setiap paragraf tambahan melipatgandakan jumlah tata letak yang dicoba pengisi halaman.\n"
"Lebih tinggi: lebih banyak cara untuk mengisi setiap halaman, sehingga lebih sedikit halaman gagal, tetapi setiap halaman memerlukan waktu lebih lama.\n"
"Lebih rendah: lebih cepat, tetapi lebih banyak halaman bisa gagal.\n"
"Memengaruhi: Kecepatan."

#: lib/ptxprint/texpert.py:309
msgid "Widest word space allowed (× text size)"
msgstr "Spasi kata terlebar yang diizinkan (× ukuran teks)"

#: lib/ptxprint/texpert.py:31
msgid "In the past, SpaceAbove and SpaceBelow were, in effect units of 1/14 of the base line spacing. This has changed so they are now in units of 1/12 of the base line spacing. Enabling this compatibility reverts the units."
msgstr "Di masa lalu, SpaceAbbove dan SpaceBelow, pada dasarnya adalah unit 1/14 dari jarak garis dasar. Ini telah berubah sehingga sekarang dalam unit 1/12 dari jarak garis dasar. Mengaktifkan kompatibilitas ini akan mengembalikan unit."

#: lib/ptxprint/texpert.py:310
msgid "When the page filler stretches a paragraph, the average space between words must not be wider than this. 1.0 = as wide as the text size. A normal word space is about 0.3 to 0.5.\n"
"Higher: easier to fill pages, but the text can look too spread out.\n"
"Lower: tighter, better-looking text, but pages are harder to fill and take longer.\n"
"Affects: Quality and Speed."
msgstr "Saat pengisi halaman meregangkan paragraf, rata-rata jarak antar kata tidak boleh lebih lebar dari nilai ini. 1.0 = selebar ukuran teks. Spasi kata yang normal sekitar 0.3 sampai 0.5.\n"
"Lebih tinggi: halaman lebih mudah diisi, tetapi teks bisa tampak terlalu renggang.\n"
"Lebih rendah: teks lebih rapat dan lebih bagus, tetapi halaman lebih sulit diisi dan memerlukan waktu lebih lama.\n"
"Memengaruhi: Kualitas dan Kecepatan."

#: lib/ptxprint/texpert.py:315
msgid "Keep paragraphs close to normal width"
msgstr "Jaga paragraf tetap mendekati lebar normal"

#: lib/ptxprint/texpert.py:316
msgid "The page filler prefers small changes to a paragraph over big changes. This setting controls how strong that preference is. Higher: the page filler tries small changes first, so the text looks more even.\n"
"Lower: the page filler accepts big changes more easily.\n"
"Affects: Quality."
msgstr "Pengisi halaman lebih memilih perubahan kecil pada paragraf daripada perubahan besar. Pengaturan ini menentukan seberapa kuat preferensi tersebut. Lebih tinggi: pengisi halaman mencoba perubahan kecil terlebih dahulu, sehingga teks tampak lebih rata.\n"
"Lebih rendah: pengisi halaman lebih mudah menerima perubahan besar.\n"
"Memengaruhi: Kualitas."

#: lib/ptxprint/texpert.py:321
msgid "Penalise shrink or stretch"
msgstr "Beri penalti pada penyusutan atau peregangan"

#: lib/ptxprint/texpert.py:322
msgid "Tells the page filler whether to shrink paragraphs or stretch them when both are possible.\n"
"Positive numbers: penalise stretching (so the text prefers to shrink more).\n"
"Negative numbers: penalise shrinking. (so the text prefers to stretch more).\n"
"0: no preference.\n"
"A bigger number (+ or −) means a higher penalty.\n"
"Affects: Quality."
msgstr "Memberi tahu pengisi halaman apakah paragraf sebaiknya dikecilkan atau diregangkan ketika keduanya mungkin.\n"
"Nomor positif: beri penalti pada peregangan (sehingga teks lebih memilih untuk menyusut).\n"
"Nomor negatif: beri penalti pada penyusutan (sehingga teks lebih memilih untuk meregang).\n"
"0: tidak ada preferensi.\n"
"Semakin besar nomornya (+ atau −), semakin tinggi penaltinya.\n"
"Memengaruhi: Kualitas."

#: lib/ptxprint/texpert.py:328
msgid "Keep neighbouring paragraphs alike"
msgstr "Jaga paragraf bersebelahan tetap serupa"

#: lib/ptxprint/texpert.py:329
msgid "The page filler compares each paragraph with the paragraph before it. It tries to avoid a very stretched paragraph next to a very shrunk one.\n"
"Higher: neighbouring paragraphs look more alike, so the page looks more even.\n"
"Lower: neighbouring paragraphs can look more different.\n"
"Affects: Quality."
msgstr "Pengisi halaman membandingkan setiap paragraf dengan paragraf sebelumnya. Ia berusaha menghindari paragraf yang sangat renggang di samping paragraf yang sangat menyusut.\n"
"Lebih tinggi: paragraf bersebelahan tampak lebih serupa, sehingga halaman tampak lebih rata.\n"
"Lebih rendah: paragraf bersebelahan bisa tampak lebih berbeda.\n"
"Memengaruhi: Kualitas."

#: lib/ptxprint/texpert.py:335
msgid "The cost of imbalance in a polyglot slice"
msgstr "Biaya ketidakseimbangan pada irisan polyglot"

#: lib/ptxprint/texpert.py:336
msgid "How bad is it for a polyglot slice to not be balanced. This the multiplier of that cost\n"
"Only relevant to diglot and polyglot projects"
msgstr "Seberapa buruk jika irisan polyglot tidak seimbang. Ini adalah pengali dari biaya tersebut.\n"
"Hanya relevan untuk proyek Dua Bahasa (diglot) dan polyglot."

#: lib/ptxprint/texpert.py:339
msgid "Use \\toc3 for Tab Text"
msgstr "Gunakan \\toc3 untuk Teks Tab"

#: lib/ptxprint/texpert.py:34 lib/ptxprint/texpert.py:40
msgid "Next page"
msgstr "Halaman berikutnya"

#: lib/ptxprint/texpert.py:34
msgid "Same page"
msgstr "Halaman yang sama"

#: lib/ptxprint/texpert.py:34
msgid "Odd page"
msgstr "Halaman ganjil"

#: lib/ptxprint/texpert.py:340
msgid "Use \\toc3 for tab text if no \\zthumbtab"
msgstr "Gunakan \\toc3 untuk teks tab jika tidak ada \\zthumbtab"

#: lib/ptxprint/texpert.py:342
msgid "Tilde is No Break Space"
msgstr "Tilde Berarti Jangan Dipisahkan"

#: lib/ptxprint/texpert.py:343
msgid "Treat ~ as non breaking space"
msgstr "Perlakukan ~ sebagai spasi antara kata-kata yang tidak dapat dipisahkan"

#: lib/ptxprint/texpert.py:344
msgid "Remove \\ref ... \\ref* links"
msgstr "Hapus tautan \\ref ... \\ref*"

#: lib/ptxprint/texpert.py:345
msgid "USFM 3.2 allows additional reference links to be inserted as part of \\xt ... \\xt* markup. This frequently appear in DBL text bundles, but are unhandled by PTXprint. Allow these to be removed from the USFM prior to typesetting."
msgstr "USFM 3.2 memungkinkan tautan referensi tambahan untuk disisipkan sebagai bagian dari \\xt ... Markup \\xt*. Ini sering muncul dalam bundel teks DBL, tetapi tidak ditangani oleh PTXprint. Izinkan ini dihapus dari USFM sebelum penyusunan huruf."

#: lib/ptxprint/texpert.py:346
msgid "End decoration skip"
msgstr "Lewati dekorasi akhir"

#: lib/ptxprint/texpert.py:347
msgid "The gap between the end of the book and the book-end decoration"
msgstr "Celah antara ujung buku dan dekorasi ujung buku"

#: lib/ptxprint/texpert.py:348
msgid "Thumbtab rotated adjustment"
msgstr "Penyetelan rotasi ibu jari"

#: lib/ptxprint/texpert.py:349
msgid "Shift thumbtab text"
msgstr "Menggeser teks thumbtab"

#: lib/ptxprint/texpert.py:35
msgid "Where to start a new book"
msgstr "Di mana kitab baru harus dimulai"

#: lib/ptxprint/texpert.py:35
msgid "Does a scripture book start on a new page, the same page as the previous book (if <65% of page has been used), or an odd page"
msgstr "Apakah sebuah kitab harus dimulai pada halaman baru, pada halaman yang sama dengan kitab sebelumnya (jika kurang dari 65% halaman telah digunakan), atau pada halaman ganjil"

#: lib/ptxprint/texpert.py:36
msgid "Page full factor"
msgstr "Faktor penuh halaman"

#: lib/ptxprint/texpert.py:37
msgid "This setting is related to how full a page needs to be to force the next book to start on a new page."
msgstr "Pengaturan ini terkait dengan seberapa penuh halaman yang diperlukan untuk memaksa buku berikutnya untuk memulai pada halaman baru."

#: lib/ptxprint/texpert.py:40
msgid "No page breaks"
msgstr "Tanpa pemutus halaman"

#: lib/ptxprint/texpert.py:40
msgid "On an odd page"
msgstr "Pada halaman ganjil"

#: lib/ptxprint/texpert.py:40
msgid "Grouped"
msgstr "Dikelompokkan"

#: lib/ptxprint/texpert.py:41
msgid "Where to start a new intro page"
msgstr "Di mana halaman pendahuluan harus dimulai"

#: lib/ptxprint/texpert.py:41
msgid "Does an intro page start on a new page, the same page as the previous book, an odd page, or group all adjacent intro pages into an odd paged group"
msgstr "Apakah halaman pendahuluan harus dimulai pada halaman baru, pada halaman yang sama dengan kitab sebelumnya, pada halaman ganjil, atau harus mengelompokkan semua halaman pendahuluan yang berdekatan ke dalam kelompok yang dimulai pada halaman ganjil"

#: lib/ptxprint/texpert.py:42
msgid "Unbalanced Lines (Max)"
msgstr "Garis Tidak Seimbang (Maks)"

#: lib/ptxprint/texpert.py:43
msgid "Maximum number of unbalanced lines allowed in 2-column layout. Recommended range 1-5."
msgstr "Jumlah maksimum baris tidak seimbang yang diperbolehkan dalam tata letak 2 kolom. Kisaran yang disarankan 1-5."

#: lib/ptxprint/texpert.py:44
msgid "Variable line spacing maximum stretch"
msgstr "Regangan maksimum jarak baris variabel"

#: lib/ptxprint/texpert.py:45
msgid "Maximum stretch to insert between lines in variable line spacing in pts"
msgstr "Regangan maksimum yang disisipkan di antara baris pada jarak baris variabel, dalam pt"

#: lib/ptxprint/texpert.py:46
msgid "Variable line spacing maximum shrink"
msgstr "Penyusutan maksimum jarak baris variabel"

#: lib/ptxprint/texpert.py:47
msgid "Maximum shrink to insert between lines in variable line spacing in pts"
msgstr "Penyusutan maksimum yang disisipkan antar baris pada jarak antar baris variabel, dalam pt"

#: lib/ptxprint/texpert.py:48
msgid "No Top Space"
msgstr "Tidak Ada Ruang Atas"

#: lib/ptxprint/texpert.py:49
msgid "Don’t insert space above headings at the start of a column"
msgstr "Jangan menyisipkan ruang kosong di atas judul di awal kolom"

#: lib/ptxprint/texpert.py:50
msgid "Suppress pagebreak after bookend-final"
msgstr "Menekan jeda halaman setelah akhir buku"

#: lib/ptxprint/texpert.py:51
msgid "Revert to old behaviour of not ensuring that the whole of the last book is output before back-matter PDFs"
msgstr "Kembali ke perilaku lama yang tidak memastikan bahwa seluruh buku terakhir dikeluarkan sebelum PDF materi belakang"

#: lib/ptxprint/texpert.py:52
msgid "Noteline offset (mm)"
msgstr "Pergeseran titik (mm) (mm)"

#: lib/ptxprint/texpert.py:53
msgid "Gap (mm) between noteline and text"
msgstr "Celah (mm) antara garis tepi dan teks"

#: lib/ptxprint/texpert.py:54
msgid "Noteline margin (mm)"
msgstr "Margin garis tepi (mm)"

#: lib/ptxprint/texpert.py:55
msgid "Gap (mm) between noteline and edge of page"
msgstr "Celah (mm) antara garis tepi dan tepi halaman"

#: lib/ptxprint/texpert.py:57 lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Solid line"
msgstr "Garis padat"

#: lib/ptxprint/texpert.py:57 lib/ptxprint/texpert.py:115 lib/ptxprint/texpert.py:118
msgid "Row of dots"
msgstr "Deretan titik"

#: lib/ptxprint/texpert.py:58
msgid "Noteline type"
msgstr "Tipe Noteline"

#: lib/ptxprint/texpert.py:58
msgid "Sometimes it is preferable to use a series of dots rather than a solid line."
msgstr "Kadang-kadang, lebih baik menggunakan serangkaian titik daripada garis padat."

#: lib/ptxprint/texpert.py:59
msgid "Noteline spacing (mm)"
msgstr "Jarak antar titik (mm)"

#: lib/ptxprint/texpert.py:60
msgid "Line spacing between notelines. When set to 0.00 the default line spacing of the document is used."
msgstr "Spasi baris di antara garis catatan. Bila diatur ke 0,00, maka spasi baris default dari dokumen akan digunakan."

#: lib/ptxprint/texpert.py:61
msgid "Noteline width (major)"
msgstr "Lebar garis utama (mayor)"

#: lib/ptxprint/texpert.py:62
msgid "Thickness (pt) of major notelines. Specify the colour on the Layout page."
msgstr "Ketebalan garis-garis utama (ukuran point). Tentukan warna pada halaman Tata Letak."

#: lib/ptxprint/texpert.py:68
msgid "Double Sided Layout"
msgstr "Tata Letak Dua Sisi"

#: lib/ptxprint/texpert.py:69
msgid "This setting can be disabled to turn off inner/outer margins, forcing the inner/outer gutter, and Notelines to always appear on the same side of the printed page."
msgstr "Pengaturan ini dapat dinonaktifkan untuk mematikan margin dalam/luar. Tepi halaman dekat jilidan dan Garis Catatan akan selalu muncul di sisi yang sama pada halaman cetak."

#: lib/ptxprint/texpert.py:71
msgid "Maximum parallel processes"
msgstr "Proses paralel maksimum"

#: lib/ptxprint/texpert.py:72
msgid "The maximum number of parallel processes to use for example when page filling"
msgstr "Jumlah maksimum proses paralel yang digunakan, misalnya saat pengisian halaman"

#: lib/ptxprint/texpert.py:73
msgid "Maximum Filling Time (mins)"
msgstr "Waktu Pengisian Maksimum (menit)"

#: lib/ptxprint/texpert.py:74
msgid "Stop page filling a book after this many minutes"
msgstr "Hentikan pengisian halaman sebuah kitab setelah sekian menit"

#: lib/ptxprint/texpert.py:78
msgid "Always down"
msgstr "Selalu ke bawah"

#: lib/ptxprint/texpert.py:78
msgid "Always up"
msgstr "Selalu ke atas"

#: lib/ptxprint/texpert.py:78
msgid "Up on left"
msgstr "Ke atas di kiri"

#: lib/ptxprint/texpert.py:78
msgid "Up on right"
msgstr "Ke atas di kanan"

#: lib/ptxprint/texpert.py:78
msgid "No hyphens"
msgstr "Tanpa tanda hubung"

#: lib/ptxprint/texpert.py:78
msgid "Position of marginal verse hyphen if any"
msgstr "Posisi tanda hubung ayat marjinal, jika ada"

#: lib/ptxprint/texpert.py:78
msgid "Insert or not a marginal verse hyphen in verse ranges, whether on the first or second line"
msgstr "Sisipkan atau tidak tanda hubung ayat marjinal pada rentang ayat, baik di baris pertama maupun kedua"

#: lib/ptxprint/texpert.py:79
msgid "Gutter space reduction for marginal verses"
msgstr "Pengurangan tepi halaman dekat jilidan untuk ayat marjinal"

#: lib/ptxprint/texpert.py:79
msgid "If false, the space for marginal verses is taken from the column. If true, some space for marginal verses is taken from the margins or rule gutter"
msgstr "Jika tidak aktif, ruang untuk ayat marjinal diambil dari kolom. Jika aktif, sebagian ruang untuk ayat marjinal diambil dari margin atau tepi halaman dekat jilidan di antara garis."

#: lib/ptxprint/texpert.py:80
msgid "Auto Calc Optimum Chapter Size"
msgstr "Hitung Otomatis Ukuran Optimal Pasal"

#: lib/ptxprint/texpert.py:81
msgid "Attempt to automatically calculate drop chapter number size"
msgstr "Mencoba menghitung ukuran nomor bab drop secara otomatis"

#: lib/ptxprint/texpert.py:82
msgid "Don't hang verse one beside a chapter (in poetry)"
msgstr "Jangan menggantungkan ayat 1 di samping pasal (dalam puisi)"

#: lib/ptxprint/texpert.py:83
msgid "Hanging verses into a chapter number can result in clashes, depending on the after-chapter space. If so, then turn off hanging verse numbers for the first verse (in poetry only). "
msgstr "Menggantung ayat-ayat ke dalam nomor bab dapat mengakibatkan bentrokan, tergantung pada ruang setelah bab. Jika demikian, matikan nomor ayat yang menggantung untuk ayat pertama (hanya dalam puisi). "

#: lib/ptxprint/texpert.py:84
msgid "Alternate verse numbers also hang"
msgstr "Nomor ayat alternatif juga menggantung"

#: lib/ptxprint/texpert.py:85
msgid "If there is an alternative verse and the current verse is hanging, does the alternate hang?"
msgstr "Jika ada ayat alternatif dan ayat saat ini sedang menggantung, apakah ayat alternatif tersebut menggantung?"

#: lib/ptxprint/texpert.py:86
msgid "After chapter space factor"
msgstr "Setelah faktor ruang bab"

#: lib/ptxprint/texpert.py:87
msgid "This sets the gap between the chapter number and the text following. The setting here is a multiple of the main body text size as specified in layout."
msgstr "Ini menetapkan jarak antara nomor bab dan teks yang mengikutinya. Pengaturan di sini adalah kelipatan dari ukuran teks badan utama seperti yang ditentukan dalam tata letak."

#: lib/ptxprint/texpert.py:89
msgid "After verse space factor"
msgstr "Setelah faktor ruang ayat"

#: lib/ptxprint/texpert.py:90
msgid "This sets the gap between the verse number and the text following. The setting here is a multiple of the main body text size as specified in layout."
msgstr "Ini mengatur jarak antara nomor ayat dan teks yang mengikutinya. Pengaturan di sini adalah kelipatan dari ukuran teks utama seperti yang ditentukan dalam tata letak."

#: lib/ptxprint/texpert.py:93
msgid "Allow Indent Para with Cutouts"
msgstr "Izinkan Paragraf Indentasi dengan Guntingan"

#: lib/ptxprint/texpert.py:94
