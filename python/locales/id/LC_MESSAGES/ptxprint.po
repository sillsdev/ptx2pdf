msgstr "PTXprint: Tambahkan Aturan Tatweel (kashida)"

#: temp.glade:1321 temp.glade:1340
msgid "Enter the verse reference\n"
"where the word is located.\n"
"\n"
"(Note that the reference is\n"
"automatically updated from\n"
"the current Paratext reference.)"
msgstr "Masukkan referensi ayat\n"
"dimana kata ditemukan.\n"
"\n"
"(Catat bahwa referensi ini\n"
"diupdate secara otomatis dari\n"
"referensi Paratext saat ini.)"

#: temp.glade:1329
msgid "JHN 3:16"
msgstr "YOH 3:16"

#: temp.glade:1348 temp.glade:5008
msgid "Reference:"
msgstr "Referensi:"

#: temp.glade:1363 temp.glade:1385
msgid "Enter the word to be lengthened\n"
"and place the cursor at the location\n"
"and use shortcut Ctrl-` (Ctrl-grave) \n"
"to insert Tatweels. Repeat at other \n"
"words and/or locations.\n"
"\n"
"(Note that this box is automatically\n"
"updated from the clipboard if the\n"
"word/phrase is 60 characters or less)."
msgstr "Masukkan kata untuk dipanjangkan\n"
"dan tempatkan kursor di lokasi tersebut\n"
"dan gunakan pintasan Ctrl-` (Ctrl-grave) \n"
"untuk memasukkan Tatweels. Ulangi di kata\n"
"lain dan/atau lokasi lainnya.\n"
"\n"
"(Catatan bahwa kotak ini secara otomatis\n"
"diperbarui dari clipboard jika\n"
"kata/frasa memiliki 60 karakter atau kurang)."

