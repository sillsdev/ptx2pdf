"       image to {} in tmpPics folder"
msgstr "Erreur : Impossible de copier l'image {}\n"
"       vers {} dans le dossier tmpPics"

#: lib/ptxprint/scriptsnippets.py:92 lib/ptxprint/scriptsnippets.py:102
msgid "Syllable line breaking"
msgstr "Casser la syllabe"

#: lib/ptxprint/scriptsnippets.py:93
msgid "Show Hyphen"
msgstr "Afficher le trait d'union"

#: lib/ptxprint/scriptsnippets.py:172
msgid "First verse on left"
msgstr "Premier verset à gauche"

#: lib/ptxprint/scriptsnippets.py:302
msgid "Enabling horizontal gridding"
msgstr "Activation du quadrillage horizontal"

#: lib/ptxprint/scriptsnippets.py:303
msgid "Align chapter numbers with grid and remove spaces before verses"
msgstr "Aligner les numéros de chapitre sur la grille et supprimer les espaces avant les versets"

#: lib/ptxprint/scriptsnippets.py:304
msgid "Automatic halfwidth punctuation pairs"
msgstr "Paires de ponctuation automatique de demi-largeur"

#: lib/ptxprint/scriptsnippets.py:305
msgid "Adjust spacing of punctuation pairs so they take up a single full width character"
msgstr "Ajuster l'espacement des paires de ponctuations de manière à ce qu'elles occupent un seul caractère sur toute la largeur"

#: lib/ptxprint/texmodel.py:457
msgid "Missing font ({})"
msgstr "Police manquante ({})"

#: lib/ptxprint/texmodel.py:987
msgid "If this error just appeared after upgrading then check whether the USFM markers like \\p and \\v used in changes.txt rules have been 'escaped' with an additional \\ (e.g. \\\\p and \\\\v) as is required by the latest version."
msgstr "Si cette erreur vient d'apparaître après la mise à jour, vérifiez si les marqueurs USFM tels que \\p et \\v utilisés dans les règles de changes.txt ont été \"échappés\" avec un \\ supplémentaire (par exemple \\\\p et \\\\v) comme l'exige cette dernière version."

#: lib/ptxprint/texmodel.py:1101
msgid "PTXprint [{}] - USFM Check Error!"
msgstr "PTXprint [{}] - Erreur de vérification USFM !"

#: lib/ptxprint/texmodel.py:1103
msgid "These errors were triggered when running canonical checks"
msgstr "Ces erreurs ont été découvertes lors de l'exécution de vérifications canoniques"

#: lib/ptxprint/texmodel.py:1104
msgid "Checking errors: "
msgstr "Erreurs de vérification : "

#: lib/ptxprint/texmodel.py:1188
msgid "PTXprint [{}] - USFM Text Error!"
msgstr "PTXprint [{}] - Erreur de texte USFM !"

#: lib/ptxprint/texmodel.py:1191
msgid "These errors were triggered while internally parsing the USFM"
msgstr "Ces erreurs ont été déclenchées lors de l'analyse interne de l'USFM"

#: lib/ptxprint/texmodel.py:1191
