msgid "Noteline type"
msgstr "Tipul liniei de note"

#: lib/ptxprint/texpert.py:58
msgid "Sometimes it is preferable to use a series of dots rather than a solid line."
msgstr "Uneori este preferabil să utilizați o serie de puncte în loc de o linie continuă."

#: lib/ptxprint/texpert.py:59
msgid "Noteline spacing (mm)"
msgstr "Distanța dintre liniile de note (mm)"

