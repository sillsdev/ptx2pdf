msgstr "Punct (cap.vers)"

#: temp.glade:27043
msgid "Use a period (.) to separate\n"
"chapter & verse numbers\n"
"in the header reference."
msgstr "Utilizați un punct (.) pentru a separa\n"
"numerele capitolului și versetului\n"
"în referința din antet."

#: temp.glade:27069
msgid "Include in References:"
msgstr "Includeți în referințe:"

#: temp.glade:27078
msgid "Book"
msgstr "Carte"

#: temp.glade:27082
msgid "By default, the book name will be included\n"
"in any references in the header line. But if you\n"
"wish to suppress that (and just show the \n"
"chapter and/or verse numbers) then \n"
"uncheck this option."
msgstr "În mod implicit, numele cărții este inclus\n"
