{
    "title": "Style editor: fields of every kind, marker management, awkward clicks",
    "project": "WSGlatin",
    "config": "Default",
    "uilevel": 6,
    "events": [
        ["", "note", "Paragraph fields on \\p"],
        ["tv_Styles", "rowactivated", "0", "0", "p"],
        ["s_styFirstLineIndent", "set", "1.5"],
        ["s_styLeftMargin", "set", "0.25"],
        ["s_styRightMargin", "set", "0.5"],
        ["s_stySpaceBefore", "set", "3"],
        ["s_stySpaceAfter", "set", "1"],
        ["fcb_styJustification", "set", "Left"],
        ["s_styNonJustifiedFill", "set", "0.4"],

        ["", "note", "Heading \\s1: faces, size, colour, justification, then font scale instead of size"],
        ["tv_Styles", "rowactivated", "0", "0", "s1"],
        ["c_styFaceBold", "set", false],
        ["c_styFaceItalic", "set", true],
        ["s_styFontSize", "set", "1.4"],
        ["col_styColor", "set", "rgb(204,0,0)"],
        ["fcb_styJustification", "set", "Right"],
        ["c_styFontScale", "set", true],
        ["s_styFontSize", "set", "0.9"],

        ["", "note", "Poetry \\q1: absolute baseline instead of a line spacing factor"],
        ["tv_Styles", "rowactivated", "0", "0", "q1"],
        ["c_styAbsoluteLineSpacing", "set", true],
        ["s_styLineSpacing", "set", "15"],

        ["", "note", "\\q2: line spacing factor, then switched to baseline and back again"],
        ["tv_Styles", "rowactivated", "0", "0", "q2"],
        ["s_styLineSpacing", "set", "1.2"],
        ["c_styAbsoluteLineSpacing", "set", true],
        ["c_styAbsoluteLineSpacing", "set", false],

        ["", "note", "Character \\nd: underline on (ptx2pdf.sty turns it off), small caps, superscript"],
        ["tv_Styles", "rowactivated", "0", "0", "nd"],
        ["c_styFaceUnderline", "set", true],
        ["c_stySmallCap", "set", true],
        ["c_styFaceSuperscript", "set", true],

        ["", "note", "Verse numbers in the margin, not raised: superscript off for \\v also writes Raise 0, since \\Superscript - keeps the superscript raise"],
        ["tv_Styles", "rowactivated", "0", "0", "v"],
        ["c_styFaceSuperscript", "set", false],

        ["", "note", "\\fv: superscript off, raise 1, then superscript on again: back to the stylesheet, the raise goes"],
        ["tv_Styles", "rowactivated", "0", "0", "fv"],
        ["c_styFaceSuperscript", "set", false],
        ["s_styRaise", "set", "1"],
        ["c_styFaceSuperscript", "set", true],

        ["", "note", "\\ord: superscript off and raise set to 2 then back to 0, which must stay an explicit Raise 0"],
        ["tv_Styles", "rowactivated", "0", "0", "ord"],
        ["c_styFaceSuperscript", "set", false],
        ["s_styRaise", "set", "2"],
        ["s_styRaise", "set", "0"],

        ["", "note", "A field changed and changed back again leaves nothing behind: \\wj bold"],
        ["tv_Styles", "rowactivated", "0", "0", "wj"],
        ["c_styFaceBold", "set", true],
        ["c_styFaceBold", "set", false],

        ["", "note", "Note \\f: caller styles, blend into, caller raises"],
        ["tv_Styles", "rowactivated", "0", "0", "f"],
        ["t_styCallerStyle", "set", "fv"],
        ["t_styNoteCallerStyle", "set", "fr"],
        ["t_NoteBlendInto", "set", "x"],
        ["s_styCallerRaise", "set", "1"],
        ["s_styNoteCallerRaise", "set", "3"],

        ["", "note", "Publishable: \\s2 off, \\rem on"],
        ["tv_Styles", "rowactivated", "0", "0", "s2"],
        ["c_styTextProperties", "set", false],
        ["tv_Styles", "rowactivated", "0", "0", "rem"],
        ["c_styTextProperties", "set", true],

        ["", "note", "Sidebar style cat:box|esb: position, width, opacity, background colour"],
        ["tv_Styles", "rowactivated", "0", "0", "cat:box|esb"],
        ["t_sbPgPos", "set", "b"],
        ["s_sbWidth", "set", "0.8"],
        ["s_sbAlpha", "set", "0.3"],
        ["col_sb_backColor", "set", "rgb(230,240,255)"],

        ["", "note", "Table cell \\tc1: vertical alignment"],
        ["tv_Styles", "rowactivated", "0", "0", "tc1"],
        ["fcb_stytcVpos", "set", "c"],

        ["", "note", "Add a character style \\zmine, then style it"],
        ["btn_styAdd", "signal", "clicked"],
        ["t_styMarker", "set", "zmine"],
        ["t_styName", "set", "zmine - Character - My own style"],
        ["txbf_styDesc", "set", "A style made by the test"],
        ["fcb_styType", "set", "char"],
        ["btn_sty_ok", "signal", "clicked"],
        ["c_styFaceBold", "set", true],
        ["s_styFontSize", "set", "0.8"],

        ["", "note", "Rename it"],
        ["btn_styEdit", "signal", "clicked"],
        ["t_styName", "set", "zmine - Character - Renamed"],
        ["btn_sty_ok", "signal", "clicked"],

        ["", "note", "Add a milestone pair \\zms-s ... \\zms-e"],
        ["btn_styAdd", "signal", "clicked"],
        ["t_styMarker", "set", "zms-s"],
        ["t_styEndMarker", "set", "zms-e"],
        ["t_styName", "set", "zms-s - Milestone - Test milestone"],
        ["fcb_styType", "set", "milestone"],
        ["btn_sty_ok", "signal", "clicked"],

        ["", "note", "Awkward: cancel an add, and OK an add with no marker"],
        ["btn_styAdd", "signal", "clicked"],
        ["t_styMarker", "set", "zcancelled"],
        ["btn_sty_cancel", "signal", "clicked"],
        ["btn_styAdd", "signal", "clicked"],
        ["t_styMarker", "set", ""],
        ["btn_sty_ok", "signal", "clicked"],

        ["", "note", "Awkward: add a marker that already exists (\\li), with \\p selected"],
        ["tv_Styles", "rowactivated", "0", "0", "p"],
        ["btn_styAdd", "signal", "clicked"],
        ["t_styMarker", "set", "\\li"],
        ["t_styName", "set", "li - List - Hijacked"],
        ["btn_sty_ok", "signal", "clicked"],
        ["", "note", "PTXprint refuses, and keeps the dialog open"],
        ["btn_sty_cancel", "signal", "clicked"],

        ["", "note", "Delete \\zmine: the editor moves to \\p, so the next change goes to \\p, not back into \\zmine"],
        ["tv_Styles", "rowactivated", "0", "0", "zmine"],
        ["btn_styDel", "signal", "clicked"],
        ["c_styFaceItalic", "set", true],

        ["", "note", "Awkward: delete a built in style (\\p): nothing should happen"],
        ["tv_Styles", "rowactivated", "0", "0", "p"],
        ["btn_styDel", "signal", "clicked"],

        ["", "note", "Reset \\q1 to the underlying stylesheet"],
        ["tv_Styles", "rowactivated", "0", "0", "q1"],
        ["btn_styReset", "signal", "clicked"],

        ["", "note", "Pick \\qa, which the book doesn't use, then filter to the markers the book uses: \\qa vanishes from the list but its fields are still there to edit"],
        ["tv_Styles", "rowactivated", "0", "0", "qa"],
        ["btn_styleFilter", "signal", "clicked"],
        ["c_styFaceBold", "set", true],
        ["tv_Styles", "rowactivated", "0", "0", "io1"],
        ["s_stySpaceAfter", "set", "0.5"],
        ["btn_styleFilter", "signal", "clicked"],

        ["", "note", "Change \\io1's space before, then click its label to set it back to the stylesheet's"],
        ["s_stySpaceBefore", "set", "3"],
        ["l_stySpaceBefore", "labelclick"],

        ["", "note", "Search for \\qr: typing in the search box selects the first match, and changes go to it"],
        ["t_styleSearch", "set", "qr"],
        ["c_styFaceItalic", "set", true],

        ["", "note", "Save, which writes ptxprint.sty"],
        ["btn_saveConfig", "signal", "clicked"]
    ]
}
